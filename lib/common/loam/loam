# info: extract various archive types; prefers 'unar' if available
# usage: extract <filename> [destination_directory (default=.)] -> always outputs the final extraction directory to stdout on success for scripting
loam.extract() {
  local OPTIND; getopts "h" _ && { echo "usage: extract <filename> [destination_directory (default=.)]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _file=${1-}
  local _dest_dir="${2:-.}"
  local _abs_dest # Will be set after directory creation

  if [[ -z "$_file" ]]; then echo "usage: extract <filename> [destination_directory (default=.)]" >&2; return $_E_USG; fi
  if [[ ! -f "$_file" ]]; then _error "not found: $_file"; return $_E_NF; fi

  # Create destination directory if needed
  if [[ ! -d "$_dest_dir" ]]; then
    mkdir -p -- "$_dest_dir" || { _error "failed to create destination directory: $_dest_dir"; return 1; }
  fi

  # Get absolute path for reliable output and operations
  if ! _abs_dest=$(cd -- "$_dest_dir" && pwd); then
    _error "could not determine absolute path for destination: $_dest_dir"; return 1
  fi

  local _basename
  _basename=$(basename "$_file")
  local _extract_dir_guess=""

  # Use unar if available (handles many formats and creates clean directories)
  if command -v unar &>/dev/null; then
    if unar -o "$_abs_dest" -- "$_file" >/dev/null 2>&1; then
      # Try to guess the directory unar might have created
      local _potential_dir_name
      if [[ "$_basename" == *.tar.* && "${_basename%%.tar.*}" != "" ]]; then
          _potential_dir_name="${_basename%%.tar.*}"
      elif [[ "$_basename" == *"."* ]]; then
          _potential_dir_name="${_basename%.*}"
      else
          _potential_dir_name="$_basename"
      fi
      _extract_dir_guess="$_abs_dest/$_potential_dir_name"

      if [[ -d "$_extract_dir_guess" ]]; then
        echo "$_extract_dir_guess"
      else
        echo "$_abs_dest"
      fi
      return 0
    else
      _error "unar failed to extract $_file"; return 1
    fi
  fi

  # Convert filename to lowercase for case-insensitive matching (portable)
  local _file_lower
  _file_lower=$(echo "$_file" | tr '[:upper:]' '[:lower:]')

  # Otherwise use format-specific extractors
  case "$_file_lower" in
    *.tar.bz2|*.tbz2)
      tar xjf -- "$_file" -C "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
      echo "$_abs_dest"
      ;;
    *.tar.gz|*.tgz)
      tar xzf -- "$_file" -C "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
      echo "$_abs_dest"
      ;;
    *.tar.xz|*.txz)
      tar xJf -- "$_file" -C "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
      echo "$_abs_dest"
      ;;
    *.tar)
      tar xf -- "$_file" -C "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
      echo "$_abs_dest"
      ;;
    *.zip)
      unzip -q -- "$_file" -d "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
      # Try to determine if zip created a single top-level directory
      local _potential_dir_name
      if [[ "$_basename" == *.tar.* && "${_basename%%.tar.*}" != "" ]]; then
          _potential_dir_name="${_basename%%.tar.*}"
      elif [[ "$_basename" == *"."* ]]; then
          _potential_dir_name="${_basename%.*}"
      else
          _potential_dir_name="$_basename"
      fi
      _extract_dir_guess="$_abs_dest/$_potential_dir_name"

      if [[ -d "$_extract_dir_guess" ]]; then
        echo "$_extract_dir_guess"
      else
        echo "$_abs_dest"
      fi
      ;;
    *.7z)
      if command -v 7z &>/dev/null; then
        7z x -- "$_file" -o"$_abs_dest" -y >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
        echo "$_abs_dest"
      else
        _error "7z command not found. To extract .7z, consider installing p7zip."; return $_E_DEP
      fi ;;
    *.rar)
      if command -v unrar &>/dev/null; then
        unrar x -y -- "$_file" "$_abs_dest/" >/dev/null 2>&1 || { _error "failed to extract $_file with unrar"; return 1; }
        echo "$_abs_dest"
      elif command -v rar &>/dev/null; then
        rar x -y -- "$_file" "$_abs_dest/" >/dev/null 2>&1 || { _error "failed to extract $_file with rar"; return 1; }
        echo "$_abs_dest"
      else
        _error "unrar or rar command not found. To extract .rar, consider installing unrar or p7zip-rar."; return $_E_DEP
      fi ;;
    *.deb)
      if command -v dpkg &>/dev/null; then
        dpkg -x -- "$_file" "$_abs_dest" >/dev/null 2>&1 || { _error "failed to extract $_file"; return 1; }
        echo "$_abs_dest"
      else
        _error "dpkg not found. To extract .deb, consider installing dpkg."; return $_E_DEP
      fi ;;
    *.bz2|*.gz|*.Z|*.z)
      (
        cd -- "$_abs_dest" || { _error "failed to change to destination directory for decompression"; exit 1; }
        cp -- "$OLDPWD/$_file" . || { _error "failed to copy $_file for decompression"; exit 1; }

        local _target_basename
        _target_basename=$(basename "$_file")

        case "$_file_lower" in
          *.bz2) bunzip2 -- "$_target_basename" >/dev/null 2>&1 || { _error "bunzip2 failed for $_target_basename"; exit 1; } ;;
          *.gz)  gunzip -- "$_target_basename" >/dev/null 2>&1 || { _error "gunzip failed for $_target_basename"; exit 1; } ;;
          *.Z|*.z) uncompress -- "$_target_basename" >/dev/null 2>&1 || { _error "uncompress failed for $_target_basename"; exit 1; } ;;
        esac
      ) || return 1
      echo "$_abs_dest"
      ;;
    *.pkg) _error "cannot auto-extract .pkg. Use installer or open manually."; return 1 ;;
    *) _error "'$_file' cannot be extracted by this function - install 'unar' for broader support or handle manually."; return 1 ;;
  esac

  return 0
}

# info: intelligently extract archive with optional item selection and executable permissions
# usage: smart-extract [-s selector] [-f force_overwrite] [-x exec_pattern] <archive_file> [destination] -> returns final path
loam.smart-extract() {
  local _selector=""
  local _force=false
  local _exec_pattern=""
  local _archive _dest _abs_dest

  local OPTIND opt
  while getopts "s:fx:h" opt; do
    case $opt in
      s) _selector="$OPTARG" ;;
      f) _force=true ;;
      x) _exec_pattern="$OPTARG" ;;
      h) 
	  echo "usage: smart-extract [-s selector] [-f force_overwrite] [-x exec_pattern] <archive_file> [destination]" >&2; 
	  sed -n '/^##sec-start-help-smart-extract/,/^##sec-end-help-smart-extract/p' "$_RPATH" | sed '1d;$d'
	  return $_E_USG
	  ;;
      *) 
	  echo "usage: smart-extract [-s selector] [-f force_overwrite] [-x exec_pattern] <archive_file> [destination]" >&2; 
	  sed -n '/^##sec-start-help-smart-extract/,/^##sec-end-help-smart-extract/p' "$_RPATH" | sed '1d;$d'
	  return $_E_USG 
	  ;;
    esac
  done
  shift $((OPTIND - 1))

  _archive=${1-}
  _dest="${2:-.}"

  if [[ -z "$_archive" ]]; then echo "usage: smart-extract [-s selector] [-f force_overwrite] [-x exec_pattern] <archive_file> [destination]" >&2; return $_E_USG; fi
  if [[ ! -f "$_archive" ]]; then _error "smart-extract: archive not found: $_archive"; return $_E_NF; fi

  # Create destination directory if needed
  if ! loam.make-dir -q "$_dest"; then _error "smart-extract: failed to create destination directory: $_dest"; return 1; fi

  # Get absolute path for destination
  if ! _abs_dest=$(cd -- "$_dest" && pwd); then
    _error "smart-extract: could not determine absolute path for destination: $_dest"
    return 1
  fi

  # No selector - use regular extract
  if [[ -z "$_selector" ]]; then
    _log "smart-extract: extracting all contents to $_abs_dest"
    local _extract_result
    _extract_result=$(loam.extract "$_archive" "$_abs_dest") || return $?
    
    # Make files executable if -x pattern is provided
    if [[ -n "$_exec_pattern" ]]; then
      _log "smart-extract: making files matching '$_exec_pattern' executable"
      find "$_extract_result" -type f -iname "$_exec_pattern" -exec chmod +x {} \; 2>/dev/null || _warn "no files found matching exec pattern '$_exec_pattern'"
    fi
    
    echo "$_extract_result"
    return 0
  fi

  # Selector mode - extract to temp, find matches, move to destination
  local _temp_dir
  _temp_dir=$(mktemp -d) || { _error "failed to create temporary directory"; return 1; }

  _log "smart-extract: extracting to temporary location for selection"
  local _extract_dir
  if ! _extract_dir=$(loam.extract "$_archive" "$_temp_dir"); then
    _error "smart-extract: failed to extract archive for selection"
    rm -rf "$_temp_dir"
    return 1
  fi

  # Find matches at root level of extracted contents (case-insensitive)
  local -a _matches=()
  local _item

  _debug "smart-extract: extract returned: $_extract_dir, searching for: '$_selector'"

  # Capture matches into array
  while IFS= read -r -d '' _item; do
    _matches+=("$_item")
  done < <(find "$_extract_dir" -mindepth 1 -maxdepth 1 -iname "$_selector" -print0 2>/dev/null)

  if [[ ${#_matches[@]} -eq 0 ]]; then
    _debug "smart-extract: no matches found - directory contents:"
    find "$_extract_dir" -mindepth 1 -maxdepth 1 2>/dev/null | while read -r item; do
      _debug "  $(basename "$item")"
    done
    _error "smart-extract: no items found matching selector '$_selector' in archive"
    rm -rf "$_temp_dir"
    return 1
  fi

  _log "smart-extract: found ${#_matches[@]} item(s) matching '$_selector'"

  # Move all matches to destination
  local _moved_count=0
  local -a _moved_items=()
  for _item in "${_matches[@]}"; do
    local _item_name=$(basename "$_item")
    local _target_path="$_abs_dest/$_item_name"
    
    if [[ -e "$_target_path" ]]; then
      if $_force; then
        _warn "smart-extract: target already exists, removing: $_target_path"
        rm -rf "$_target_path" || { _error "failed to remove existing target: $_target_path"; rm -rf "$_temp_dir"; return 1; }
      else
        _error "smart-extract: target already exists: $_target_path (use -f to force overwrite)"
        rm -rf "$_temp_dir"
        return 1
      fi
    fi

    if mv "$_item" "$_target_path"; then
      _log "smart-extract: moved $(basename "$_item") to $_abs_dest"
      _moved_items+=("$_target_path")
      ((_moved_count++))
    else
      _error "smart-extract: failed to move $_item to $_target_path"
      rm -rf "$_temp_dir"
      return 1
    fi
  done
  
  # Make files executable if -x pattern is provided
  if [[ -n "$_exec_pattern" ]]; then
    _log "smart-extract: making files matching '$_exec_pattern' executable"
    for _item in "${_moved_items[@]}"; do
      if [[ -f "$_item" ]]; then
        # Check if the file itself matches the exec pattern
        # shellcheck disable=SC2053 # intentional: _exec_pattern is a caller-supplied glob, not a literal to quote
        if [[ "$(basename "$_item")" == $_exec_pattern ]] || [[ "$(basename "$_item")" =~ $_exec_pattern ]]; then
          chmod +x "$_item" || _warn "failed to make executable: $_item"
        fi
      elif [[ -d "$_item" ]]; then
        # Find files within the directory that match the exec pattern
        find "$_item" -type f -iname "$_exec_pattern" -exec chmod +x {} \; 2>/dev/null
      fi
    done
  fi

  # Cleanup temp directory
  rm -rf "$_temp_dir"

  _log "smart-extract: successfully moved $_moved_count item(s) to $_abs_dest"
  echo "$_abs_dest"
  return 0
}
