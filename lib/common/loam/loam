# info: displays the ip address of the system (or 127.0.0.1)
# usage: get-ip
loam.get-ip() {
  local OPTIND; getopts "h" _ && { echo "usage: get-ip" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _ip

  # Try modern ip command first (Linux)
  if command -v ip &>/dev/null; then
    # Method 1: IP used for default route (often the "main" external IP)
    _ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')
    if [[ -n "$_ip" && "$_ip" != "127.0.0.1" ]]; then echo "$_ip"; return 0; fi

    # Method 2: Generic global IP from 'ip addr'
    _ip=$(ip -4 addr show scope global 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -n1)
    if [[ -n "$_ip" && "$_ip" != "127.0.0.1" ]]; then echo "$_ip"; return 0; fi
  fi

  # Try macOS specific commands
  if [[ "$(uname)" == "Darwin" ]]; then
    _ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
    if [[ -n "$_ip" ]]; then echo "$_ip"; return 0; fi

    _ip=$(networksetup -getinfo Wi-Fi 2>/dev/null | awk '/^IP address:/{print $3}')
    if [[ -n "$_ip" ]]; then echo "$_ip"; return 0; fi
  fi

  # Try ifconfig (fallback for macOS and Linux if 'ip' command failed or not present)
  if command -v ifconfig &>/dev/null; then
    _ip=$(ifconfig 2>/dev/null | grep "inet " | grep -Fv "127.0.0.1" | awk '{print $2}' | head -n1 | sed 's/addr://g' 2>/dev/null)
    if [[ -n "$_ip" ]]; then echo "$_ip"; return 0; fi
  fi

  # Ultimate Fallback
  echo "127.0.0.1"
}

# info: check if the system has internet connectivity
# usage: is-online
loam.is-online() {
  local OPTIND; getopts "h" _ && { echo "usage: is-online" >&2; return $_E_USG; }; shift $((OPTIND-1))
  # Try ping first (fast ICMP check)
  if [[ "$(uname)" == "Darwin" ]]; then # macOS ping
    ping -c 1 -t 1 8.8.8.8 >/dev/null 2>&1 && return 0
  else # Linux/other ping
    ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 && return 0
  fi

  # Try DNS resolution (nslookup)
  if command -v nslookup &>/dev/null; then
    nslookup google.com >/dev/null 2>&1 && return 0
  fi
  # Alternative DNS tools like 'dig' could also be added:
  # if command -v dig &>/dev/null; then
  #   dig +short +time=1 +tries=1 google.com @8.8.8.8 >/dev/null 2>&1 && return 0
  # fi

  # Try HTTP/S HEAD request (curl or wget)
  if command -v curl &>/dev/null; then
    # -f: fail on server errors (4xx, 5xx)
    # -s: silent
    # --connect-timeout: for connection phase
    # --max-time: for the whole operation
    curl -fsI --connect-timeout 2 --max-time 3 https://www.google.com >/dev/null 2>&1 && return 0
  elif command -v wget &>/dev/null; then
    # -q: quiet
    # --timeout: overall response timeout
    # --tries: number of retries
    # -O /dev/null: discard output
    # --no-check-certificate: can be useful if local cert store is an issue, but less secure
    wget -qS --timeout=2 --tries=1 --spider https://www.google.com >/dev/null 2>&1 && return 0
  fi

  return $_E_NC
}

# info: get HTTP status code of a URL; optionally without following redirects
# usage: url-status [-n (no-redirect - initial request only)] <url> -> HTTP status code (e.g., 200, 301, 404) or empty/error string on failure
loam.url-status() {
  local _url
  local _redirects=true
  local -a _curl_opts=(-s -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10)
  local _status
  
  local OPTIND opt
  while getopts "nh" opt; do
    case "$opt" in
      n) _redirects=false ;;
      *) echo "usage: url-status [-n (no-redirect - initial request only)] <url>" >&2; return 1;;
    esac
  done
  shift $((OPTIND - 1))

  _url="${1-}"

  if [[ -z "$_url" ]]; then echo "usage: url-status [-n (no-redirect - initial request only)] <url>" >&2; return $_E_USG; fi
  
  # Check: internet connectivity
  if command -v loam.is-online &>/dev/null && ! loam.is-online; then _error "no internet connection available"; return $_E_NC; fi
  # Check: dependency
  command -v curl &>/dev/null || { _error "curl not found"; return $_E_DEP; }

  $_redirects && _curl_opts+=(-L) # Default: Follow redirects else: -L is not added, so curl does not follow redirects
  
  # Get final status
  _status=$(curl "${_curl_opts[@]}" "$_url")
  echo "$_status"
  # Return 0 if status is not empty and not "000" (curl connection error indicator)
  [[ -n "$_status" && "$_status" != "000" ]] && return 0 || return 1 # Failure to get a valid status
}

# info: check if an HTTP endpoint exists (final status is 2xx)
# usage: url-exists <url>
loam.url-exists() {
  local OPTIND; getopts "h" _ && { echo "usage: url-exists <url>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _url="${1-}"
  local _status
  local _status_rc # Exit code of url-status call

  if [[ -z "$_url" ]]; then echo "usage: url-exists <url>" >&2; return $_E_USG; fi

  # Check: internet connectivity
  if command -v loam.is-online &>/dev/null && ! loam.is-online; then _error "no internet connection available"; return $_E_NC; fi

  _status=$(loam.url-status "$_url")
  _status_rc=$?

  if [[ $_status_rc -eq $_E_DEP ]]; then # loam.url-status indicated curl was not found
      # loam.url-status already printed its error message
      return $_E_DEP # Propagate dependency error
  elif [[ $_status_rc -ne 0 || -z "$_status" || "$_status" == "000" ]]; then
    # loam.url-status failed to get a meaningful status (e.g. connection refused to specific host, timeout)
    # or returned an error indicator like "000" from curl.
    return 1 # General failure to determine existence / bad status from host
  fi

  # Definition of "exists": Successful responses (200-299)
  if [[ "$_status" -ge 200 && "$_status" -le 299 ]]; then
    _log "true"
    return 0 # Exists (2xx range)
  else
    _log "false"
    # Any other valid status code (1xx, 3xx, 4xx, 5xx) means it doesn't "exist" by this strict definition
    return 1
  fi
}

# info: fetch HTTP headers for a given URL
# usage: url--headers [-n (no-redirect)] <url> -> all headers
loam.url-headers() {
  local _url
  local _redirects=true
  local -a _curl_opts=(-sI --connect-timeout 5 --max-time 10)

  local OPTIND opt
  while getopts "nh" opt; do
    case "$opt" in
      n) _redirects=false ;;
      *) echo "usage: url-headers [-n (no-redirect)] <url>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))
  
  _url="${1-}"
  if [[ -z "$_url" ]]; then echo "usage: url-headers [-n (no-redirect)] <url>" >&2; return $_E_USG; fi
  
  # Check: internet connectivity
  if command -v loam.is-online &>/dev/null && ! loam.is-online; then _error "no internet connection available"; return $_E_NC; fi
  # Check: dependency
  command -v curl &>/dev/null || { _error "curl not found"; return $_E_DEP; }

  $_redirects && _curl_opts+=(-L) # Default: Follow redirects else: -L is not added, so curl does not follow redirects
  
  # Fetch headers and process them
  local _raw_headers
  _raw_headers=$(curl "${_curl_opts[@]}" "$_url") || return $?
  
  if [[ -z "$_raw_headers" ]]; then return 1; fi

  # Post-process the headers:
  # 1. Skip the first line (HTTP status line).
  # 2. For subsequent lines, ensure they are in "Key: Value" format.
  #    Some headers might be multi-line (obsolete but possible), this awk won't combine them.
  #    It also removes blank lines that curl might output between header blocks (e.g., after redirects).
  echo "$_raw_headers" | awk '
    NR > 1 && NF > 0 { # NR > 1 skips the first line; NF > 0 skips blank lines
      # Reconstruct to ensure consistent "Key: Value" even if original had extra spaces
      # Find the first colon
      first_colon = index($0, ":")
      if (first_colon > 0) {
        key = substr($0, 1, first_colon - 1)
        value = substr($0, first_colon + 1)
        # Trim leading space from value
        gsub(/^[ \t]+/, "", value)
        # Trim trailing carriage return if present (from Windows servers)
        gsub(/\r$/, "", key)
        gsub(/\r$/, "", value)
        print key ": " value
      }
    }
  '
  # The exit status of awk will be used if it's the last command.
  # If awk processes successfully, it returns 0.
  return 0 # Explicitly return 0 if processing was successful
}

# info: fetch a specific HTTP header value from a URL (case-insensitive key match)
# usage: url-header [-n (no-redirect)] <url> <header_name> -> header_value or empty
loam.url-header() {
  local _url _header_name
  local _redirects=true
  local -a _headers_opts=()

  local OPTIND opt
  while getopts "nh" opt; do
    case "$opt" in
      n) _redirects=false; _headers_opts+=(-n) ;;
      *) echo "usage: url-header [-n (no-redirect)] <url> <header_name>" >&2; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))
  
  _url="${1-}"
  _header_name="${2-}"
  
  if [[ -z "$_url" || -z "$_header_name" ]]; then echo "usage: url-header [-n (no-redirect)] <url> <header_name>" >&2; return $_E_USG; fi
  
  # Call loam.url-headers and extract the specific header (case-insensitive)
  loam.url-headers "${_headers_opts[@]}" "$_url" | awk -v header="$_header_name" '
    BEGIN { IGNORECASE = 1 }
    {
      # Split on first colon to get key and value
      colon_pos = index($0, ": ")
      if (colon_pos > 0) {
        key = substr($0, 1, colon_pos - 1)
        value = substr($0, colon_pos + 2)
        if (tolower(key) == tolower(header)) {
          print value
          exit 0
        }
      }
    }
  '
}

# info: extract filename from URL using Content-Disposition header or URL path
# usage: url-filename <url>
loam.url-filename() {
  local OPTIND; getopts "h" _ && { echo "usage: url-filename <url>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _url="${1-}"
  local _filename

  if [[ -z "$_url" ]]; then echo "usage: url-filename <url>" >&2; return $_E_USG; fi
  
  # Check: internet connectivity
  if command -v loam.is-online &>/dev/null && ! loam.is-online; then _error "no internet connection available"; return $_E_NC; fi
  # Check: dependency
  command -v curl &>/dev/null || { _error "curl not found"; return $_E_DEP; }

  # Method 1: Try curl's filename_effective (attempt regardless of help output)
  _filename=$(curl -sSLJOw '%{filename_effective}' --connect-timeout 5 --max-time 10 -o /dev/null "$_url" 2>/dev/null)
  # Clean up any whitespace/control characters
  _filename=$(echo "$_filename" | tr -d '\r\n' | xargs)
  _filename="${_filename%\"}"  # Remove trailing quote
  _filename="${_filename#\"}"  # Remove leading quote
  
  if [[ -n "$_filename" && "$_filename" != "filename_effective" ]]; then
    _filename=$(basename "$_filename")
    _log "url-filename: used curl filename_effective -> $_filename"
    echo "$_filename"
    return 0
  fi

  # Method 2: Parse Content-Disposition from headers (fallback)
  if command -v loam.url-header &>/dev/null; then
    local _content_disp
    _content_disp=$(loam.url-header "$_url" "content-disposition" 2>/dev/null)
    
    if [[ -n "$_content_disp" ]]; then
      # Extract filename from Content-Disposition header
      _filename=$(echo "$_content_disp" | sed -n 's/.*filename[*]*=["'\'']*\([^"'\'';\r\n]*\).*/\1/p' | head -1)
      # Handle UTF-8 encoding prefix
      _filename="${_filename#UTF-8\'\'}"
      
      if [[ -n "$_filename" ]]; then
        # URL decode %XX sequences
        _filename=$(printf '%b' "${_filename//%/\\x}" 2>/dev/null || echo "$_filename")
        _filename=$(basename "$_filename")
        _log "url-filename: used content-disposition header -> $_filename"
        echo "$_filename"
        return 0
      fi
    fi
  fi

  # # Method 3: Extract from URL path (strip query/fragment)
  # local _path_part="${_url%%\?*}"    # Remove query string
  # local _path_clean="${_path_part%\#*}"  # Remove fragment
  #
  # if [[ "$_path_clean" != */ && "$_path_clean" == *.* ]]; then
  #   _filename=$(basename "$_path_clean")
  #   if [[ -n "$_filename" && "$_filename" != "." ]]; then
  #     _log "url-filename: used url path extraction -> $_filename"
  #     echo "$_filename"
  #     return 0
  #   fi
  # fi

  # Method 3: Extract from URL path (strip query/fragment)
  local _path_part="${_url%%\?*}"    # Remove query string
  local _path_clean="${_path_part%\#*}"  # Remove fragment
  local _filename_from_path

  _filename_from_path=$(basename "$_path_clean")
  if [[ -n "$_filename_from_path" && "$_filename_from_path" != "." && "$_filename_from_path" != "/" ]]; then
    _filename="$_filename_from_path" # Assign to _filename for consistency
    _log "url-filename: used url path extraction -> $_filename"
    echo "$_filename"
    return 0
  fi
	
  # Method 4: Generate fallback filename with timestamp
  _filename="download_$(loam.str-timestamp file)"
  _log "url-filename: used timestamp fallback -> $_filename"
  echo "$_filename"
}

# info: download a file from URL to destination file
# usage: url-download <url> <destination_file>
loam.url-download() {
  local OPTIND; getopts "h" _ && { echo "usage: url-download <url> <destination_file>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _url="${1-}" _dst="${2-}"
  local _dst_dir

  if [[ -z "$_url" || -z "$_dst" ]]; then echo "usage: url-download <url> <destination_file>" >&2; return $_E_USG; fi
  # Reject if destination is a directory
  if [[ -d "$_dst" ]]; then _error "destination_file must be a file path, not directory: $_dst"; return 1; fi
	  
  # Check: internet connectivity
  if command -v loam.is-online &>/dev/null && ! loam.is-online; then _error "no internet connection available"; return $_E_NC; fi

  _dst_dir=$(dirname "$_dst")
  if ! loam.make-dir -q "$_dst_dir"; then _error "failed to create destination directory: $_dst_dir"; return 1; fi

  # Skip download if file already exists
  if [[ -f "$_dst" ]]; then
    _log "file already exists: $_dst"; return 0
  fi

  _log "downloading $_url to $_dst..."
  if command -v curl &>/dev/null; then
    if ! curl -L -sS --fail --retry 3 --retry-delay 2 -o "$_dst" "$_url"; then
      _error "download failed with curl: $_url"; rm -f "$_dst"; return 1
    fi
  elif command -v wget &>/dev/null; then
    if ! wget -q --tries=3 --timeout=15 -O "$_dst" "$_url"; then
      _error "download failed with wget: $_url"; rm -f "$_dst"; return 1
    fi
  else
    _error "neither curl nor wget is available"; return $_E_DEP
  fi
  _log "download complete: $_dst"
  echo "$_dst"
  return 0
}

# info: download file or extract archive with optional selection and verification
# usage: smart-download [-e extract] [-s selector] [-f force] [-x exec_pattern] [-c checksum] <url> [destination_directory]
loam.smart-download() {
  local _extract=false
  local _selector=""
  local _force=false
  local _exec_pattern=""
  local _checksum=""
  local _url _dest _abs_dest

  local OPTIND opt
  while getopts "es:fx:c:h" opt; do
    case $opt in
      e) _extract=true ;;
      s) _selector="$OPTARG" ;;
      f) _force=true ;;
      x) _exec_pattern="$OPTARG" ;;
      c) _checksum="$OPTARG" ;;
      *)
      echo "usage: smart-download [-e extract] [-s selector] [-f force] [-x exec_pattern] [-c checksum] <url> [destination_directory]" >&2;
      sed -n '/^##sec-start-help-smart-download/,/^##sec-end-help-smart-download/p' "$_RPATH" | sed '1d;$d'
      return $_E_USG
      ;;
    esac
  done
  shift $((OPTIND - 1))

  _url="${1-}"
  _dest="${2:-.}"

  if [[ -z "$_url" ]]; then echo "usage: smart-download [-e extract] [-s selector] [-f force] [-x exec_pattern] [-c checksum] <url> [destination_directory]" >&2; return $_E_USG; fi

  # Validate that selector requires extract mode
  if [[ -n "$_selector" && "$_extract" != true ]]; then
    _error "selector (-s) requires extract mode (-e)"; return $_E_USG
  fi

  # Create destination directory if needed
  if ! loam.make-dir -q "$_dest"; then _error "failed to create destination directory: $_dest"; return 1; fi

  # Get absolute path for destination
  if ! _abs_dest=$(cd -- "$_dest" && pwd); then
    _error "could not determine absolute path for destination: $_dest"; return 1
  fi

  # Check if URL exists (mandatory check)
  _log "smart-download: checking url: $_url"
  if ! loam.url-exists "$_url"; then
    _error "url is not accessible: $_url"; return $_E_NF
  fi

  # Determine filename for download
  local _filename
  _filename=$(loam.url-filename "$_url") || { _error "failed to determine filename from URL"; return 1; }

  _debug "smart-download: mode=$(if $_extract; then echo 'extract'; else echo 'file'; fi), filename=$_filename, dest=$_abs_dest"

  # File download mode (no extraction)
  if ! $_extract; then
    local _target_file="$_abs_dest/$_filename"

    # Check if file exists and handle force flag
    if [[ -f "$_target_file" && "$_force" != true ]]; then
      _error "smart-download: file already exists: $_target_file (use -f to force overwrite)"; return 1
    fi

    # Download the file
    _log "smart-download: downloading $_url to $_abs_dest as $_filename"
    if ! loam.url-download "$_url" "$_target_file"; then
      _error "smart-download: failed to download file"; return 1
    fi

    # Verify checksum if provided
    if [[ -n "$_checksum" ]]; then
      _log "smart-download: verifying checksum: $_checksum"
      if ! loam.verify-checksum "$_target_file" "$_checksum"; then
        local _failed_file
        _failed_file=$(loam.temp-move "$_target_file" "failed_download_$_filename")
        _error "smart-download: checksum verification failed - file preserved at: $_failed_file"; return 1
      fi
      _log "smart-download: checksum verified"
    fi

    # Make the downloaded file executable if _exec_pattern is provided and matches
    if [[ -n "$_exec_pattern" ]]; then
      # Using glob pattern matching, consistent with find -iname
      # shellcheck disable=SC2053 # intentional: _exec_pattern is a caller-supplied glob, not a literal to quote
      if [[ "$(basename "$_target_file")" == $_exec_pattern ]]; then
        _log "smart-download: making downloaded file '$_target_file' executable as it matches pattern '$_exec_pattern'"
        if chmod +x "$_target_file"; then
          _log "smart-download: successfully made '$_target_file' executable"
        else
          _error "smart-download: failed to make '$_target_file' executable"
          # Consider if this failure should be fatal (return 1) - for now, it logs an error and continues.
        fi
      else
        _debug "smart-download: downloaded file '$_target_file' does not match exec pattern '$_exec_pattern'"
      fi
    fi
    # if [[ -n "$_exec_pattern" ]]; then
    #   _log "making files matching '$_exec_pattern' executable"
    #   find "$_abs_dest" -type f -iname "$_exec_pattern" -exec chmod +x {} \; 2>/dev/null || _warn "no files found matching exec pattern '$_exec_pattern'"
    # fi

    _log "smart-download: file download completed"
    echo "$_abs_dest"
    return 0
  fi

  # Extract mode - download to temp, verify, then extract/install
  local _temp_dir
  _temp_dir=$(mktemp -d) || { _error "failed to create temporary directory"; return 1; }

  local _temp_file="$_temp_dir/$_filename"
  
  _log "smart-download: downloading archive to temporary location"
  if ! loam.url-download "$_url" "$_temp_file" >/dev/null; then
    _error "smart-download: failed to download archive"
    rm -rf "$_temp_dir"
    return 1
  fi

  # Verify checksum if provided
  if [[ -n "$_checksum" ]]; then
    _log "smart-download: verifying archive checksum: $_checksum"
    if ! loam.verify-checksum "$_temp_file" "$_checksum"; then
      local _failed_file
      _failed_file=$(loam.temp-move "$_temp_file" "failed_download")
      rm -rf "$_temp_dir"
      _error "smart-download: checksum verification failed - archive preserved at: $_failed_file"; return 1
    fi
    _log "smart-download: archive checksum verified"
  fi

  # Handle DMG files specially
  if [[ "$_filename" == *.dmg ]]; then
    if [[ "$(os)" != "mac" ]]; then
      _error "smart-download: DMG files can only be installed on macOS"
      rm -rf "$_temp_dir"
      return 1
    fi
    
    _log "smart-download: installing DMG to $_abs_dest"
    local _install_result
    _install_result=$(loam.install-dmg "$_temp_file" "$_selector" "$_abs_dest") || {
      local _failed_file
      _failed_file=$(loam.temp-move "$_temp_file" "failed_dmg_install")
      rm -rf "$_temp_dir"
      _error "smart-download: DMG installation failed - file preserved at: $_failed_file"
      return 1
    }
    
    # Cleanup temp directory
    rm -rf "$_temp_dir"
    
    _log "smart-download: DMG installation completed successfully"
    echo "$_install_result"
    return 0
  fi

  # Handle regular archives
  local -a _extract_args=()
  [[ -n "$_selector" ]] && _extract_args+=(-s "$_selector")
  $_force && _extract_args+=(-f)
  [[ -n "$_exec_pattern" ]] && _extract_args+=(-x "$_exec_pattern")

  # Extract the archive
  _log "smart-download: extracting archive to destination"
  local _extract_result
  
  if [[ ${#_extract_args[@]} -gt 0 ]]; then
    _debug "loam.smart-extract ${_extract_args[*]} $_temp_file $_abs_dest"
    _extract_result=$(loam.smart-extract "${_extract_args[@]}" "$_temp_file" "$_abs_dest")
  else
    _debug "loam.smart-extract $_temp_file $_abs_dest"
    _extract_result=$(loam.smart-extract "$_temp_file" "$_abs_dest")
  fi
  local _extract_exit_code=$?
  
  if [[ $_extract_exit_code -ne 0 ]]; then
    local _failed_file
    _failed_file=$(loam.temp-move "$_temp_file" "failed_extract")
    rm -rf "$_temp_dir"
    _error "smart-download: extraction failed - archive preserved at: $_failed_file"; return 1
  fi

  # Cleanup temp directory
  rm -rf "$_temp_dir"

  _log "smart-download: extraction completed successfully"
  echo "$_extract_result"
  return 0
}

