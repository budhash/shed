##sec-start-help-smart-download
# Basic file download:
#   smart-download "https://example.com/binary" "/usr/local/bin/"
#   smart-download "https://example.com/script.sh" "."
#
# File download with checksum verification:
#   smart-download -c "sha256hash" "https://example.com/binary" "/usr/local/bin/"
#   smart-download -c "abcd1234..." "https://example.com/file.zip" "/downloads/"
#
# File download with executable permissions:
#   smart-download -x "binary" "https://example.com/binary" "/usr/local/bin/"
#   smart-download -x "*.sh" "https://example.com/scripts.tar.gz" "/usr/local/bin/"
#
# Force overwrite existing files:
#   smart-download -f "https://example.com/update.zip" "/downloads/"
#   smart-download -f -c "hash" "https://example.com/binary" "/usr/local/bin/"
#
# Basic archive extraction:
#   smart-download -e "https://example.com/archive.zip" "/project/"
#   smart-download -e "https://example.com/software.tar.gz" "/opt/"
#
# Selective archive extraction:
#   smart-download -e -s "*.app" "https://example.com/mac-software.zip" "/Applications/"
#   smart-download -e -s "kubectl" "https://k8s.io/kubectl.tar.gz" "/usr/local/bin/"
#   smart-download -e -s "config*" "https://example.com/app-config.zip" "/etc/myapp/"
#
# Archive extraction with executable permissions:
#   smart-download -e -s "install.sh" -x "install.sh" "https://example.com/installer.zip" "/tmp/"
#   smart-download -e -s "*.sh" -x "*.sh" "https://example.com/scripts.tar.gz" "/usr/local/bin/"
#   smart-download -e -s "binary" -x "binary" "https://example.com/tools.zip" "/usr/local/bin/"
#
# DMG installation (macOS only):
#   smart-download -e "https://example.com/MyApp.dmg" "/Applications/"
#   smart-download -e -s "MyApp.app" "https://example.com/Software.dmg" "/Applications/"
#   smart-download -e -c "sha256hash" "https://example.com/VerifiedApp.dmg" "/Applications/"
#
# Combined flags for complex scenarios:
#   smart-download -e -f -s "kubectl" -x "kubectl" -c "sha256hash" "https://k8s.io/kubectl.tar.gz" "/usr/local/bin/"
#   smart-download -e -f -s "*.app" "https://example.com/mac-app.zip" "/Applications/"
#   smart-download -f -c "hash" -x "deploy*" "https://example.com/deployment.tar.gz" "/opt/app/"
#
# Real-world scenarios:
#   # Download and install kubectl with verification
#   smart-download -e -s "kubectl" -x "kubectl" -c "a1b2c3..." "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl.tar.gz" "/usr/local/bin/"
#   
#   # Install macOS application
#   smart-download -e -s "*.app" "https://example.com/MyApp.zip" "/Applications/"
#   
#   # Download shell scripts and make them executable
#   smart-download -e -s "*.sh" -x "*.sh" "https://example.com/dotfiles.tar.gz" "$HOME/.local/bin/"
#   
#   # Download single binary with checksum verification
#   smart-download -c "sha256hash" -x "binary" "https://github.com/user/project/releases/download/v1.0/binary" "/usr/local/bin/"
#   
#   # Extract configuration files from archive
#   smart-download -e -s "config" -f "https://example.com/app-config.zip" "/etc/myapp/"
#   
#   # Download and extract tools with force overwrite
#   smart-download -e -f -s "tools/*" -x "tools/*" "https://example.com/toolkit.tar.gz" "/usr/local/"
#
#   # Real World Example
#   smart-download -e -s "*.app" "https://download.sublimetext.com/sublime_text_build_4200_mac.zip" /tmp/p
##sec-end-help-smart-download
