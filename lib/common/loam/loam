##[ encryption

# info: encrypt data from stdin or argument using AES-256 with a password, output base64.
# usage: <input> | encrypt-aes <password> or encrypt-aes <password> <string_to_encrypt>
loam.encrypt-aes() {
  local _password
  local OPTIND opt
  while getopts "h" opt; do
    case "$opt" in
      *) echo "usage: <input> | encrypt-aes <password> or encrypt-aes <password> <string_to_encrypt>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))

  command -v openssl &>/dev/null || { _error "openssl command not found."; return $_E_DEP; }

  if [[ $# -eq 0 ]]; then
    echo "usage: <input> | encrypt-aes <password> or encrypt-aes <password> <string_to_encrypt>" >&2; return $_E_USG
  fi
  
  _password="${1-}"
  shift

  local -a openssl_args=(enc -aes-256-cbc -pbkdf2 -md sha256 -salt -a -pass "pass:$_password")
  local rc=0
  local openssl_stderr=""

  # The 3>&1 trick allows us to pipe openssl's real stdout to our stdout,
  # while capturing only its stderr into the variable.
  if [[ $# -gt 0 ]]; then
    openssl_stderr=$(printf "%s" "${1-}" | openssl "${openssl_args[@]}" 2>&1 >&3)
    rc=$?
  elif [[ -p /dev/stdin ]] || [[ ! -t 0 ]]; then
    openssl_stderr=$(openssl "${openssl_args[@]}" 2>&1 >&3)
    rc=$?
  else
    _error "no string argument provided and no input piped from stdin."; return $_E_USG
  fi 3>&1

  if [[ $rc -ne 0 ]]; then
    _error "openssl execution failed with: $openssl_stderr"
    _error "encryption failed - check password or input"
    return $_E
  fi
  
  return $_S
}

# info: decrypt base64 AES-256 encrypted data from stdin or argument using a password.
# usage: <encrypted_input> | decrypt-aes <password> or decrypt-aes <password> <encrypted_string>
loam.decrypt-aes() {
  local _password
  local OPTIND opt
  while getopts "h" opt; do
    case "$opt" in
      *) echo "usage: <encrypted_input> | decrypt-aes <password> or decrypt-aes <password> <encrypted_string>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))

  command -v openssl &>/dev/null || { _error "openssl command not found."; return $_E_DEP; }

  if [[ $# -eq 0 ]]; then
    echo "usage: <encrypted_input> | decrypt-aes <password> or decrypt-aes <password> <encrypted_string>" >&2; return $_E_USG
  fi
  
  _password="${1-}"
  shift

  local -a openssl_args=(enc -d -aes-256-cbc -pbkdf2 -md sha256 -salt -a -pass "pass:$_password")
  local rc=0
  local openssl_stderr=""

  # The 3>&1 trick allows us to pipe openssl's real stdout to our stdout,
  # while capturing only its stderr into the variable.
  if [[ $# -gt 0 ]]; then
    openssl_stderr=$(printf "%s\n" "${1-}" | openssl "${openssl_args[@]}" 2>&1 >&3)
    rc=$?
  elif [[ -p /dev/stdin ]] || [[ ! -t 0 ]]; then
    openssl_stderr=$(openssl "${openssl_args[@]}" 2>&1 >&3)
    rc=$?
  else
    _error "no string argument provided and no input piped from stdin."; return $_E_USG
  fi 3>&1


  if [[ $rc -ne 0 ]]; then
    _error "openssl execution failed with: $openssl_stderr"
    _error "decryption failed - check password or input"
    return $_E
  fi
  
  return $_S
}
