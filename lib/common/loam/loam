# info: display current timestamp in various formats
# usage: str-timestamp [format iso (default), date, time, unix, utc, file]
loam.str-timestamp() {
  local OPTIND; getopts "h" _ && { echo "usage: str-timestamp [format iso (default), date, time, unix, utc, file]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _format="${1:-iso}"
  
  case "$_format" in
    iso)  date "+%Y-%m-%d %H:%M:%S" ;;
    date) date "+%Y-%m-%d" ;;
    time) date "+%H:%M:%S" ;;
    unix) date "+%s" ;;
    utc)  date -u "+%Y-%m-%dT%H:%M:%SZ" ;;
    file) date "+%Y%m%d-%H%M%S" ;;
    *) echo "usage: str-timestamp [format iso (default), date, time, unix, utc, file]" >&2; return $_E_USG ;;
  esac
}

# info: generate random string with customizable options
# usage: str-random [-a alphanumeric only] [-l lowercase only] [length (16)]
loam.str-random() {
  local _length=16
  local _alphanumeric=false
  local _lowercase=false

  local OPTIND opt
  while getopts "alh" opt; do
    case "$opt" in
      a) _alphanumeric=true ;;
      l) _lowercase=true ;;
      *) echo "usage: str-random [-a alphanumeric only] [-l lowercase only] [length (16)]" >&2; return "$_E_USG" ;;
    esac
  done
  shift $((OPTIND - 1))

  # Build charset based on flags
  local _charset
  if [[ "$_alphanumeric" == true && "$_lowercase" == true ]]; then
    _charset="a-z0-9"  # Both flags: lowercase alphanumeric
  elif [[ "$_alphanumeric" == true ]]; then
    _charset="A-Za-z0-9"  # Just -a: alphanumeric
  elif [[ "$_lowercase" == true ]]; then
    _charset="a-z0-9!@#$%^&*()_+=-"  # Just -l: lowercase with symbols
  else
    _charset="A-Za-z0-9!@#$%^&*()_+=-"  # Default: full charset
  fi

  if [[ -n "${1-}" ]]; then
    if [[ ${1-} =~ ^[1-9][0-9]*$ ]]; then
      _length="$1"
    elif [[ ${1-} == "0" ]]; then
      _length=0
    else
       _error "length must be a number"; return $_E_USG
    fi
  fi

  if [[ "$_length" -eq 0 ]]; then return 0; fi # Output nothing for length 0

  local _random_string
  if [[ -r /dev/urandom ]]; then
    _random_string=$(LC_ALL=C tr -dc "$_charset" < /dev/urandom | head -c "$_length")
  elif command -v openssl &>/dev/null; then
    _random_string=$(LC_ALL=C tr -dc "$_charset" < <(openssl rand -base64 "$((_length * 2))") | head -c "$_length")
  else
    _error "/dev/urandom not available and openssl not found"; return $_E_DEP
  fi

  if [[ ${#_random_string} -lt $_length ]]; then
     _warn "generated string is shorter than requested (${#_random_string}/${_length})"
  fi

  echo "$_random_string"
  # Implicitly returns 0 if echo succeeds, or the exit status of echo if it somehow fails.
}

# info: convert text to uppercase
# usage: str-upper [text] or <input> | loam.str-upper
loam.str-upper() {
  if [[ -p /dev/stdin ]]; then
    # Read from stdin if piped
    tr '[:lower:]' '[:upper:]'
  elif [[ $# -gt 0 ]]; then
    # Process arguments if providedloam.clip-set
    echo "$*" | tr '[:lower:]' '[:upper:]' # Use "$*" to treat all args as a single string
  else
    # No input and no arguments, show usage
    echo "usage: str-upper [text] or <input> | loam.str-upper" >&2; return "$_E_USG"
  fi
  # Implicitly returns the exit status of 'tr' or 'echo | tr'
}

# info: convert text to lowercase
# usage: str-lower [text] or <input> | loam.str-lower
loam.str-lower() {
  if [[ -p /dev/stdin ]]; then
    # Read from stdin if piped
    tr '[:upper:]' '[:lower:]'
  elif [[ $# -gt 0 ]]; then
    # Process arguments if provided
    echo "$*" | tr '[:upper:]' '[:lower:]' # Use "$*" to treat all args as a single string
  else
    # No input and no arguments, show usage
    echo "usage: str-lower [text] or <input> | loam.str-lower" >&2; return "$_E_USG"
  fi
