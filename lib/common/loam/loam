# Examples:
#
# Basic extraction (extract all contents):
#   smart-extract "archive.zip" "/project/"
#   smart-extract "project.tar.gz" "."
#
# Extract specific files/directories:
#   smart-extract -s "*.app" "software.zip" "/Applications/"
#   smart-extract -s "kubectl" "kubernetes.tar.gz" "/usr/local/bin/"
#   smart-extract -s "config" "app.zip" "/etc/myapp/"
#
# Extract with patterns:
#   smart-extract -s "*.sh" "scripts.zip" "/usr/local/bin/"
#   smart-extract -s "*.dylib" "libs.tar.gz" "/usr/local/lib/"
#   smart-extract -s "bin*" "tools.zip" "/usr/local/bin/"
#
# Make specific files executable:
#   smart-extract -s "install.sh" -x "install.sh" "installer.zip" "/tmp/"
#   smart-extract -s "*.sh" -x "*.sh" "scripts.tar.gz" "/usr/local/bin/"
#   smart-extract -x "kubectl" "kubernetes.tar.gz" "/usr/local/bin/"
#
# Make files executable with different patterns:
#   smart-extract -s "tools" -x "bin/*" "toolkit.zip" "/usr/local/"
#   smart-extract -s "MyApp.app" -x "Contents/MacOS/*" "app.zip" "/Applications/"
#   smart-extract -x "*.sh" "scripts.zip" "/usr/local/bin/"
#
# Force overwrite existing files:
#   smart-extract -f -s "myapp" "update.zip" "/usr/local/bin/"
#   smart-extract -f "archive.zip" "/project/"
#
# Combined flags:
#   smart-extract -f -s "deploy" -x "deploy" "release.tar.gz" "/opt/app/"
#   smart-extract -s "*.sh" -f -x "*.sh" "scripts.tar.gz" "/usr/local/bin/"
#
# Case-insensitive matching:
#   smart-extract -s "*.APP" "mac-software.zip" "/Applications/"
#   smart-extract -s "readme*" "project.tar.gz" "."
#
# Multiple file extraction:
#   smart-extract -s "*" "archive.zip" "/dest/"          # Extract all root-level items
#   smart-extract -s "*.*" "files.zip" "/dest/"         # Extract files with extensions only
#
# Real-world scenarios:
#   # Download and install kubectl (extract and make executable)
#   smart-extract -s "kubectl" -x "kubectl" "kubernetes-client.tar.gz" "/usr/local/bin/"
#   
#   # Install macOS application
#   smart-extract -s "*.app" "MyApp.dmg.zip" "/Applications/"
#   
#   # Extract shell scripts and make them executable
#   smart-extract -s "*.sh" -x "*.sh" "dotfiles.tar.gz" "$HOME/.local/bin/"
#   
#   # Extract tools directory and make all binaries executable
#   smart-extract -s "tools" -x "bin/*" "toolkit.tar.gz" "/usr/local/"
#   
#   # Extract installer and make specific file executable
#   smart-extract -f -s "installer" -x "install" "software.zip" "/tmp/"
##sec-end-help-smart-extract
