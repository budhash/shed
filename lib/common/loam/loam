##[ secret-management

# info: forces a sudo authentication prompt if the user's sudo timestamp has expired
# usage: sudo-auth "Reason for prompt"
loam.sudo-auth() {
  local _reason="${1-}"
  
  if ! command -v sudo &>/dev/null; then
    _error "sudo command not found, cannot authenticate user"
    return $_E_DEP
  fi

  # -v (validate) updates the user's timestamp, prompting for a password if necessary.
  # It does not run a command as root. It is perfect for an authentication check.
  if sudo -v; then
    return 0 # User is authenticated
  else
    _error "sudo authentication failed - cannot proceed"
    return 1 # User failed or cancelled the prompt
  fi
}

# info: save a secret/password to system credential store
# usage: secret-set [-f (force update)] [-i (insecure, allow non-interactive access)] <service_name> [password]
loam.secret-set() {
  local _force=false
  local _insecure=false
  local OPTIND opt
  while getopts "fih" opt; do
    case "$opt" in
      f) _force=true ;;
      i) _insecure=true ;;
      *) echo "usage: secret-set [-f (force update)] [-i (insecure, allow non-interactive access)] <service_name> [password]" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))

  local _service="${1-}" _password="${2-}"
  [[ -z "$_service" ]] && { echo "usage: secret-set [-f (force update)] [-i (insecure, allow non-interactive access)] <service_name> [password]" >&2; return $_E_USG; }

  local _exists=false
  loam.secret-exists "$_service" && _exists=true

  if [[ "$_exists" == true ]]; then
    if [[ "$_force" != true ]]; then
      _error "secret '$_service' already exists. use -f to force update."
      return 1
    fi
    _log "secret '$_service' exists, updating with force flag..."
  fi

  if [[ -z "$_password" ]]; then
    _password=$(loam.readline "password: ")
    [[ -z "$_password" ]] && { _error "password cannot be empty"; return $_E_USG; }
  fi

  case "$(os)" in
    mac)
      # For macOS, an update must be a delete-then-add to ensure the ACL is correctly re-applied.
      # Simply updating an existing item does not reliably change its ACL.
      if [[ "$_exists" == true ]]; then
        # Call 'security delete' directly to avoid the interactive prompt from our wrapper.
        security delete-generic-password -a "$(whoami)" -s "$_service" >/dev/null 2>&1 || true
      fi

      local -a sec_opts=(-a "$(whoami)" -s "$_service" -w "$_password")
      if [[ "$_insecure" != true ]]; then
        # Secure by default: -T /dev/null forces an empty ACL, requiring user auth (Touch ID/pass) on get.
        sec_opts+=(-T "/dev/null")
      else
        _warn "saving '$_service' in insecure mode; non-interactive access will be allowed"
      fi

      # The -U flag is not needed as we are always performing a creation.
      if security add-generic-password "${sec_opts[@]}" 2>/dev/null; then
        _log "secret saved/updated in macOS keychain: $_service"
      else
        _error "failed to save secret to macOS keychain"; return $_E
      fi
      ;;
    linux)
      if command -v secret-tool &>/dev/null; then
        if [[ "$_exists" == true ]]; then
          # Call 'secret-tool clear' directly to avoid the interactive prompt from our wrapper.
          secret-tool clear service "$_service" >/dev/null 2>&1 || true
        fi
        if echo -n "$_password" | secret-tool store --label="$_service" service "$_service" 2>/dev/null; then
          _log "secret saved/updated in GNOME keyring: $_service"
        else
          _error "failed to save secret to GNOME keyring"; return $_E
        fi
      elif command -v pass &>/dev/null; then
        # For pass, the '-f' flag handles updates.
        local -a pass_opts=()
        [[ "$_force" == true ]] && pass_opts+=("-f")
        
        if echo -n "$_password" | pass insert "${pass_opts[@]}" "$_service" 2>/dev/null; then
          _log "secret saved/updated in pass store: $_service"
        else
          _error "failed to save secret to pass store"; return $_E
        fi
      else
        _error "no supported credential store found (install libsecret-tools or pass)"; return $_E_DEP
      fi
      ;;
    *)
      _error "credential storage not supported on $(os)"; return $_E_OS
      ;;
  esac
}

# info: retrieve a secret/password from system credential store
# usage: secret-get <service_name>
loam.secret-get() {
  local OPTIND; getopts "h" _ && { echo "usage: secret-get <service_name>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  
  local _service="${1-}"
  [[ -z "$_service" ]] && { echo "usage: secret-get <service_name>" >&2; return $_E_USG; }
  
  case "$(os)" in
    mac)
      # The user will be prompted by the OS if the secret was set securely (without -i).
      security find-generic-password -a "$(whoami)" -s "$_service" -w 2>/dev/null
      ;;
    linux)
      if command -v secret-tool &>/dev/null; then
        secret-tool lookup service "$_service" 2>/dev/null
      elif command -v pass &>/dev/null; then
        pass show "$_service" 2>/dev/null | head -1
      else
        return $_E_DEP
      fi
      ;;
    *)
      return $_E_OS
      ;;
  esac
}

# info: check if a secret exists in system credential store
# usage: secret-exists <service_name>
loam.secret-exists() {
  local OPTIND; getopts "h" _ && { echo "usage: secret-exists <service_name>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  
  local _service="${1-}"
  [[ -z "$_service" ]] && { echo "usage: secret-exists <service_name>" >&2; return $_E_USG; }
  
  case "$(os)" in
    mac)
      security find-generic-password -a "$(whoami)" -s "$_service" &>/dev/null
      ;;
    linux)
      if command -v secret-tool &>/dev/null; then
        secret-tool lookup service "$_service" &>/dev/null
      elif command -v pass &>/dev/null; then
        pass show "$_service" &>/dev/null
      else
        return $_E_DEP
      fi
      ;;
    *)
      return $_E_OS
      ;;
  esac
}

# info: delete a secret/password from system credential store
# usage: secret-delete <service_name>
loam.secret-delete() {
  local OPTIND; getopts "h" _ && { echo "usage: secret-delete <service_name>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  
  local _service="${1-}"
  [[ -z "$_service" ]] && { echo "usage: secret-delete <service_name>" >&2; return $_E_USG; }
  
  case "$(os)" in
    mac)
      # The user will be prompted by the OS if the secret was set securely.
      if security delete-generic-password -a "$(whoami)" -s "$_service" 2>/dev/null; then
        _log "secret deleted from macOS keychain: $_service"
      else
        _warn "secret not found or already deleted: $_service"
      fi
      ;;
    linux)
      if command -v secret-tool &>/dev/null; then
        if secret-tool clear service "$_service" 2>/dev/null; then
          _log "secret deleted from GNOME keyring: $_service"
        else
          _warn "secret not found or already deleted: $_service"
        fi
      elif command -v pass &>/dev/null; then
        if pass rm --force "$_service" 2>/dev/null; then
          _log "secret deleted from pass store: $_service"
        else
          _warn "secret not found or already deleted: $_service"
        fi
      fi
      ;;
  esac
}

# info: securely retrieves a secret from keychain or an interactive prompt (pipeline-aware) - returns the secret on stdout
# usage: loam.secret-get-or-prompt <service_name> [-p <prompt_text>] [-c (cache password)]
loam.secret-get-or-prompt() {
  local _prompt=""
  local _cache_password=false
  local OPTIND opt

  while getopts "p:ch" opt; do
    case "$opt" in
      p) _prompt="$OPTARG" ;;
      c) _cache_password=true ;;
      h|*)
        echo "usage: loam.secret-get-or-prompt <service_name> [-p <prompt_text>] [-c (cache password)]" >&2
        return $_E_USG
        ;;
    esac
  done
  shift $((OPTIND - 1))

  local _service="${1-}"
  if [[ -z "$_service" ]]; then
    _error "service name is a required argument."
    echo "usage: loam.secret-get-or-prompt <service_name> [-p <prompt_text>] [-c (cache password)]" >&2
    return $_E_USG
  fi

  # 1. Attempt to retrieve the secret non-interactively from the keychain.
  local _password
  _password=$(loam.secret-get "$_service" 2>/dev/null)

  # 2. If found, print it to stdout and exit successfully.
  if [[ -n "$_password" ]]; then
    printf "%s" "$_password"
    return 0
  fi

  # 3. If not found, proceed directly to prompting.
  # We trust the underlying loam.readline to handle truly non-interactive
  # sessions (e.g. cron) by failing if it cannot open /dev/tty.
  _warn "secret for '$_service' not found in keychain."
  
  if [[ -z "$_prompt" ]]; then
    _prompt="Enter password for '$_service': "
  fi
  _password=$(loam.readline "$_prompt")
  if [[ -z "$_password" ]]; then
    _error "password cannot be empty"
    return 1
  fi

  if [[ "$_cache_password" == true ]]; then
    if loam.confirm "Cache this password in the keychain for '$_service'?"; then
      loam.secret-set "$_service" "$_password"
    fi
  fi

  printf "%s" "$_password"
  return 0
}
