# info: pretty-print JSON from stdin to stdout
# usage: <input> | json-format
loam.json-format() {
  # [[ ! -p /dev/stdin ]] && { _error "json-format: No input piped from stdin."; return $_E_USG; } # Optional: strict check

  local _formatter_cmd=""
  if command -v jq &>/dev/null; then _formatter_cmd="jq .";
  elif command -v python3 &>/dev/null; then _formatter_cmd="python3 -m json.tool";
  elif command -v python &>/dev/null; then _formatter_cmd="python -m json.tool";
  else _error "json-formatter (jq, python3, python) not found."; return $_E_DEP; fi
  
  eval "$_formatter_cmd" # Reads from stdin by default
  return $?
}

# info: pretty-print XML from stdin to stdout
# usage: <input> | xml-format
loam.xml-format() {
  # [[ ! -p /dev/stdin ]] && { _error "xml-format: No input piped from stdin."; return $_E_USG; } # Optional

  if ! command -v xmllint &>/dev/null; then _error "xmllint not found"; return $_E_DEP; fi
  xmllint --format - # '-' means read from stdin
  return $?
}

# info: encode data from stdin or string argument to base64 on stdout
# usage: base64-encode [string_to_encode] or <input> | base64-encode
loam.base64-encode() {
  # -h not supported because it accepts piped input
  command -v base64 &>/dev/null || { _error "base64 not found"; return $_E_DEP; }

  if [[ $# -gt 0 ]]; then # String argument provided
    printf "%s" ${1-} | base64
  elif [[ ! -p /dev/stdin ]]; then
    echo "usage: base64-encode [string_to_encode] or <input> | base64-encode" >&2; return $_E_USG
  else # Piped stdin
    base64
  fi
  return $?
}

# info: decode base64 data from stdin or string argument to stdout
# usage: base64-decode [base64_string_to_decode] or <input> | base64-decode
loam.base64-decode() {
  # -h not supported because it accepts piped input
  local _decoder="" _os_type; _os_type="$(os)"
  if [[ "$_os_type" == "mac" ]]; then
    if command -v gbase64 &>/dev/null; then _decoder="gbase64 --decode";
    elif (echo "dGVzdA==" | command base64 -d /dev/null &>/dev/null 2>&1); then _decoder="base64 -d";
    elif command -v base64 &>/dev/null; then _decoder="base64 -D"; fi
  else
    if command -v base64 &>/dev/null; then _decoder="base64 --decode"; fi
  fi

  if [[ -z "$_decoder" ]]; then
    _error "base64 (decoder) not found for OS '$_os_type'."; return $_E_DEP
  fi
  
  if [[ $# -gt 0 ]]; then # String argument provided
    # Clean whitespace from argument string before decoding
    printf "%s" ${1-} | tr -d '\n\r[:space:]' | eval "$_decoder"
  elif [[ ! -p /dev/stdin ]]; then
   echo "usage: base64-decode [base64_string_to_decode] or <input> | base64-decode" >&2; return $_E_USG
  else # Piped stdin - ssume piped stdin is clean or should be processed as-is by base64 decode
    eval "$_decoder"
  fi
  return $?
}
