# info: check if a file or directory is binary (non-text)
# usage: is-binary <file_or_directory>
loam.is_binary() {
  local OPTIND; getopts "h" _ && { echo "usage: is-binary <file_or_directory>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _target="${1-}"

  if [[ -z "$_target" ]]; then echo "usage: is-binary <file_or_directory>" >&2; return $_E_USG; fi
  if [[ ! -e "$_target" ]]; then _error "not found: $_target"; return $_E_NF; fi
  if [[ ! -r "$_target" ]]; then _error "permission denied: cannot read '$_target'"; return $_E_NP; fi
  if [[ -d "$_target" ]]; then return 0; fi  # directories are binary
  if [[ ! -f "$_target" ]]; then return 0; fi  # special files are binary
  if [[ ! -s "$_target" ]]; then return 1; fi  # empty files are text

  # Try multiple approaches for better compatibility
  if command -v file >/dev/null 2>&1; then
    # Modern file command with MIME type
    if file -b --mime-type "$_target" 2>/dev/null | grep -q "^text/"; then
      return 1  # text
    fi
    
    # Check for specific text types that might not have text/ MIME type
    local _file_output
    _file_output=$(file -b "$_target" 2>/dev/null)
    if echo "$_file_output" | grep -qi "text\|script\|source\|xml\|json\|yaml\|configuration"; then
      return 1  # text
    fi
  fi

  # Ultimate fallback: check for null bytes in first 8192 bytes
  if LC_ALL=C head -c 8192 "$_target" 2>/dev/null | LC_ALL=C grep -qv $'\0'; then
    return 1  # text
  fi

  return 0  # binary
}

# info: find files in directory with pattern matching and exclusion options
# usage: find-files [-p pattern] [-n] [-b] [-i] [-a] [-l] [-e exclude_dir] [-x exclude_file] [directory]
loam.find-files() {
  local _dir="."
  local _exclude_hidden=false
  local _exclude_binary=false
  local _ignore_case=false
  local _absolute_path=false
  local _exclude_links=false
  local -a _patterns=()
  local _has_patterns=false
  local -a _ex_dirs=()
  local -a _ex_files=()
  local -a _pos_args=()

  command -v find &>/dev/null || { _error "find command not found"; return $_E_DEP; }

  # Parse options
  while [[ $# -gt 0 ]]; do
    case $1 in
      -p|--pattern)
        if [[ -z ${2-} ]]; then _error "-p/--pattern requires an argument"; return $_E_USG; fi
        _patterns+=("$2")
        _has_patterns=true
        shift 2
        ;;
      -n|--no-hidden) _exclude_hidden=true; shift ;;
      -b|--no-binary) _exclude_binary=true; shift ;;
      -i|--ignore-case) _ignore_case=true; shift ;;
      -a|--absolute) _absolute_path=true; shift ;;
      -l|--no-links) _exclude_links=true; shift ;;
      -e|--exclude-dir)
        if [[ -z ${2-} ]]; then _error "-e/--exclude-dir requires an argument"; return $_E_USG; fi
        _ex_dirs+=("$2")
        shift 2
        ;;
      -x|--exclude-file)
        if [[ -z ${2-} ]]; then _error "-x/--exclude-file requires an argument"; return $_E_USG; fi
        _ex_files+=("$2")
        shift 2
        ;;
      -h|--help)
        echo "usage: find-files [-p pattern] [-n] [-b] [-i] [-a] [-l] [-e exclude_dir] [-x exclude_file] [directory]" >&2
        sed -n '/^##sec-start-help-find-files/,/^##sec-end-help-find-files/p' "$_RPATH" | sed '1d;$d'
        return $_E_USG
        ;;
      -*)
        _error "unknown option $1"
        echo "usage: find-files [-p pattern] [-n] [-b] [-i] [-a] [-l] [-e exclude_dir] [-x exclude_file] [directory]" >&2
        return $_E_USG
        ;;
      *) _pos_args+=("$1"); shift ;;
    esac
  done

  # If no patterns specified, use default "*"
  if [[ "$_has_patterns" == false ]]; then _patterns=("*"); fi

  # Process positional arguments
  if [[ ${#_pos_args[@]} -eq 1 ]]; then
    _dir="${_pos_args[0]}"
  elif [[ ${#_pos_args[@]} -gt 1 ]]; then
    _error "too many arguments"; return $_E_USG
  fi

  # Validate directory
  if [[ ! -e "$_dir" ]]; then _error "directory not found: '$_dir'"; return $_E_NF; fi
  if [[ ! -d "$_dir" ]]; then _error "'$_dir' is not a directory"; return $_E_USG; fi
  if [[ ! -r "$_dir" ]]; then _error "permission denied: cannot read directory '$_dir'"; return $_E_NP; fi

  # Convert to absolute path if requested
  if [[ "$_absolute_path" == true ]]; then
    _dir=$(cd "$_dir" 2>/dev/null && pwd) || {
      _error "failed to resolve absolute path for '$_dir'"
      return $_E_NF
    }
  fi

  # Declare loop variables outside loops
  local _pattern _ex_dir _ex_file _line _file

  # Build find command for each pattern
  local -a _results=()
  
  for _pattern in "${_patterns[@]}"; do
    local -a _opts=("$_dir" "-type" "f")

    # Add case sensitivity option
    if [[ "$_ignore_case" == true ]]; then
      _opts+=("-iname" "$_pattern")
    else
      _opts+=("-name" "$_pattern")
    fi

    # Exclude symbolic links if requested
    if [[ "$_exclude_links" == true ]]; then _opts+=("!" "-type" "l"); fi

    # Add directory exclusions
    if [[ ${#_ex_dirs[@]} -gt 0 ]]; then
      for _ex_dir in "${_ex_dirs[@]}"; do
        _opts+=("-not" "-path" "*/$_ex_dir/*")
      done
    fi

    # Add file exclusions
    if [[ ${#_ex_files[@]} -gt 0 ]]; then
      for _ex_file in "${_ex_files[@]}"; do
        if [[ "$_ignore_case" == true ]]; then
          _opts+=("-not" "-iname" "$_ex_file")
        else
          _opts+=("-not" "-name" "$_ex_file")
        fi
      done
    fi

    # Add hidden file/directory exclusions
    if [[ "$_exclude_hidden" == true ]]; then _opts+=("-not" "-path" "*/.*"); fi

    # Add reasonable depth limit to prevent infinite loops
    _opts+=("-maxdepth" "50")

    # Debug output
    _debug find "${_opts[@]}"

    # Execute and collect results
    while IFS= read -r _line; do
      [[ -n "$_line" ]] && _results+=("$_line")
    done < <(find "${_opts[@]}" 2>/dev/null)
  done

  # Filter binary files if requested
  if [[ "$_exclude_binary" == true ]]; then
    local -a _filtered_results=()
    for _file in "${_results[@]}"; do
      if [[ -n "$_file" ]] && ! loam.is_binary "$_file"; then
        _filtered_results+=("$_file")
      fi
    done
    _results=("${_filtered_results[@]}")
  fi

  # Convert to relative paths if absolute not requested and we're not in the target dir
  if [[ "$_absolute_path" == false ]] && [[ "$_dir" == /* ]]; then
    local -a _relative_results=()
    local _pwd
    _pwd=$(pwd)
    for _file in "${_results[@]}"; do
      # Convert absolute path to relative if possible
      if [[ "$_file" == "$_pwd"/* ]]; then
        _relative_results+=("${_file#"$_pwd"/}")
      else
        _relative_results+=("$_file")
      fi
    done
    _results=("${_relative_results[@]}")
  fi

  # Sort and deduplicate results
  printf '%s\n' "${_results[@]}" | sort -u

  return 0
}
