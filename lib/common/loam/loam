#!/usr/bin/env bash
# loam is a LIBRARY — source it; direct execution is refused.
if [[ "${BASH_SOURCE[0]:-}" == "${0:-}" ]]; then
  echo "loam: this is a library — 'source loam', do not execute it" >&2
  exit 64
fi

##( header
# --------------------------------------------------------------------
# radix - core utility function library
# --------------------------------------------------------------------
# File: $HOME/.local/bin/radix ← ~/radix/shed/core/lib/radix
# Info: Core utility function library for Zsh environment and setup scripts.
# Note: 100+ functions covering file ops, networking, system functions, logging.
#       Cross-platform compatible (macOS/Linux), dependency-free core.
# --------------------------------------------------------------------
##) header

##( initialize
[[ "${ZSH_DEBUG:-}" == "true" ]] && echo "[debug] loading: radix" >&2
##) initialize

##( initialization
# Script Behavior Options:
_prev_errexit_status=0
[[ -o errexit ]] && _prev_errexit_status=1

# set -e  # Exit immediately if a command exits with a non-zero status.
set -u  # Treat unset variables as an error when substituting.
set -o pipefail # The return value of a pipeline is the status of the last command to exit with a non-zero status.

# Include Guard: prevents multiple sourcing in the same shell session
if [[ -n "${_RADIX_SOURCED:-}" && "$_RADIX_SOURCED" == true ]]; then
  # Safe cross-shell check for sourcing
  if [[ "${ZSH_EVAL_CONTEXT:-}" == *"source"* ]] || [[ "${BASH_SOURCE[0]:-}" != "${0:-}" ]]; then
    return 0 # Already sourced, and currently being sourced again
  fi
fi
_RADIX_SOURCED=true

# Set _RDEBUG flag based on global ZSH_DEBUG environment variable
_RDEBUG=false
if [[ "${ZSH_DEBUG:-false}" == "true" ]]; then
  _RDEBUG=true
fi

_RPATH="$HOME/.local/bin/radix"
##) initialization

##( constants

# Colors
_RCLR_RESET="" _RCLR_GREEN="" _RCLR_YELLOW="" _RCLR_RED="" _RCLR_BLUE=""
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then # Check if NO_COLOR is unset or empty
  _RCLR_RESET="\033[0m" 
  _RCLR_GREEN="\033[0;32m"
  _RCLR_YELLOW="\033[0;33m" 
  _RCLR_RED="\033[0;31m" 
  _RCLR_BLUE="\033[0;34m"
fi

# ERROR
_S=0 				  # Success
_E=1 			    # General failure
_E_USG=2 		  # Bad usage / invalid arguments
_E_DEP=3 			# Dependency not found
_E_OS=4 			# Unsupported OS
_E_NF=5 			# Not Found
_E_NP=6 			# Permission Error
_E_NC=7 			# Not Connected
##) constants

##( functions
##[ logging

loam.log()   { echo -e "${_RCLR_GREEN:-}[info ]${_RCLR_RESET:-} $*" >&2; return 0; }
loam.warn()  { echo -e "${_RCLR_YELLOW:-}[warn ]${_RCLR_RESET:-} $*" >&2; return 0; }
loam.error() { echo -e "${_RCLR_RED:-}[error]${_RCLR_RESET:-} $*" >&2; return 0; }
loam.debug() { $_RDEBUG &&  echo -e "${_RCLR_BLUE:-}[debug]${_RCLR_RESET:-} $*" >&2; return 0; }
loam.die()   { loam.error "$@"; exit "$_E"; }

# compat shims (deprecated; call sites migrate over time)
_log()   { loam.log "$@"; }
_warn()  { loam.warn "$@"; }
_error() { loam.error "$@"; }
_debug() { loam.debug "$@"; }
_die()   { loam.die "$@"; }

loam.os()   { case "$(uname)" in Darwin) echo mac;; Linux) echo linux;; *) echo unknown;; esac; }
loam.arch() { uname -m; }
loam.has()  { command -v "$1" >/dev/null 2>&1; }
loam.mkdir()   { loam.make-dir "$@"; }      # canonical short names per loam-api.md
loam.symlink() { loam.make-symlink "$@"; }
loam.backup()  { loam.make-backup "$@"; }
loam.download(){ loam.url-download "$@"; }
##] logging

##[ os

# info: return the current operating system : mac / linux / win (or unknown)
# usage: os
os() { case "$OSTYPE" in darwin*) echo "mac" ;; linux*) echo "linux" ;; msys*|cygwin*|mingw*) echo "win" ;; *) echo "unknown" ;; esac; }

# info: return the current operating system with version (e.g., mac-13.4.1, ubuntu-22.04)
# usage: os-ver
loam.os-ver() {
  case "$OSTYPE" in
    darwin*) echo "mac-$(sw_vers -productVersion)" ;;
    linux*) [[ -f /etc/os-release ]] && { source /etc/os-release; echo "${ID:-linux}-${VERSION_ID:-unknown}"; } || echo "linux-unknown" ;;
    msys*|cygwin*|mingw*) echo "win-$(cmd.exe /c ver 2>/dev/null | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+' | head -1 || echo unknown)" ;;
    *) echo "unknown-unknown" ;;
  esac
}
##] os

##[ user-input

loam.read() {
  local _prompt="${1-}" _char_mode="${2:-false}" _result=""
  
  echo -en "${_RCLR_YELLOW:-}>> $_prompt ${_RCLR_RESET:-}" >&2
  
  # Cross-shell input handling
  if [[ "$_char_mode" == "true" ]]; then
    # Single character input - shell-specific
    if [[ -n "${ZSH_VERSION:-}" ]]; then
      read -k1 -r _result </dev/tty    	# zsh: -k1 for single char
    elif [[ -n "${BASH_VERSION:-}" ]]; then
      read -n1 -r _result </dev/tty    	# bash: -n1 for single char
    else
      read -r _result </dev/tty			# Fallback for other shells - read full line
      _result="${_result:0:1}"         	# Take only first character
    fi
  else
    read -r _result </dev/tty			# Line input - universal across shells
  fi
  
  echo "" >&2    # Add newline after input
  printf "%s" "$_result"
}

# info: reads multi-line text from the terminal until EOF (Ctrl+D)
# usage: my_text=$(loam.readtext "Paste text here:")
loam.readtext() {
  local _prompt="${1-}"
  echo -en "${_RCLR_YELLOW:-}>> $_prompt ${_RCLR_RESET:-}" >&2
  echo "" >&2 # Add a newline so user input starts on the next line.
  
  local _result
  # Harden by explicitly reading from the terminal, just like loam.read
  _result=$(cat </dev/tty)
  
  printf "%s" "$_result"
}

loam.readline() { loam.read "${1-:-Enter line:}" false; echo; } # usage: my_var=$(loam.readline "Enter value: ")
loam.readchar() { loam.read "${1-}" true; echo; } # usage: my_char=$(loam.readchar "Choose [Y/n]: ")
loam.confirm() { # usage: if loam.confirm "Proceed?"; then ...; fi
    local _response; _response=$(loam.readchar "${1-}[y/N]:")
    case "$_response" in [yY]) return 0 ;; *) return 1 ;; esac
}

# info: retrieves input from stdin, with optional fallbacks (clipboard then prompt)- stdin > clipboard > interactive prompt.
# usage: get-input [-c] [-i <mode: line/text>] [-p <prompt_text>]
loam.get-input() {
  local _use_clipboard=false
  local _interactive_mode=""
  local _prompt_text=""
  local OPTIND opt

  while getopts "ci:p:h" opt; do
    case "$opt" in
      c) _use_clipboard=true ;;
      i) _interactive_mode="$OPTARG" ;;
      p) _prompt_text="$OPTARG" ;;
      h|*)
        echo "usage: get-input [-c] [-i <mode: line/text>] [-p <prompt_text>]" >&2
        return $_E_USG
        ;;
    esac
  done
  shift $((OPTIND - 1))

  # 1. Always check for non-interactive piped input first.
  if [[ ! -t 0 ]]; then
    cat
    return 0
  fi

  # If stdin is interactive, proceed to fallbacks if they are enabled.

  # 2. Check clipboard if enabled.
  if [[ "$_use_clipboard" == true ]]; then
    local _clipboard_content
    _clipboard_content=$(loam.clip-get)
    if [[ -n "$_clipboard_content" ]]; then
      _log "reading data from clipboard..."
      printf "%s" "$_clipboard_content"
      return 0
    fi
  fi

  # 3. Check for interactive prompt if a mode was specified.
  if [[ -n "$_interactive_mode" ]]; then
    case "$_interactive_mode" in
      line)
        loam.readline "${_prompt_text:-Enter line:}"
        ;;
      text)
        loam.readtext "${_prompt_text:-Enter text (end with Ctrl+D):}"
        ;;
      *)
        _error "invalid interactive mode '$_interactive_mode' - use 'line' or 'text'"; return 1
        ;;
    esac
    return 0
  fi

  # 4. If we reach here, stdin was interactive and no valid fallback was found.
  _error "no input found on stdin and no fallback data source was enabled"
  return 1
}
##] user-input

##[ system

# info: get system hostname across different operating systems
# usage: get-hostname
loam.get-hostname() {
  local OPTIND; getopts "h" _ && { echo "usage: get-hostname" >&2; return $_E_USG; }; shift $((OPTIND-1))

  local _os=$(os)
  case "$_os" in
    mac) scutil --get ComputerName 2>/dev/null || hostname ;;
    linux) hostname ;;
    *) hostname ;;
  esac
}

# info: set system hostname across different operating systems
# usage: set-hostname <new_hostname>
loam.set-hostname() {
  local OPTIND; getopts "h" _ && { echo "usage: set-hostname <new_hostname>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _hostname="${1-}"
  local _current_hostname
  local _os

  if [[ -z "$_hostname" ]]; then echo "usage: set-hostname <new_hostname>" >&2; return $_E_USG; fi

  # This regex allows single letters and longer valid hostnames.
  if ! [[ "$_hostname" =~ ^[a-zA-Z]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9]|[a-zA-Z0-9]{0,61})?$ ]]; then
    _error "invalid hostname: '$_hostname'. use alphanumeric, hyphens (not start/end)"; return 1
  fi

  _os=$(os)

  case "$_os" in
    mac)
      if ! command -v scutil &>/dev/null; then _error "scutil not found on macOS"; return $_E_DEP; fi
      _current_hostname=$(scutil --get ComputerName 2>/dev/null)
      if [[ "$_current_hostname" == "$_hostname" ]]; then _log "hostname already '$_hostname' on macOS"; return 0; fi

      _log "setting macOS hostname to '$_hostname'..."
      if sudo scutil --set ComputerName "$_hostname" && \
         sudo scutil --set HostName "$_hostname" && \
         sudo scutil --set LocalHostName "$_hostname" && \
         sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "$_hostname" && \
         sudo hostname "$_hostname"; then
        _log "macOS hostname set to '$_hostname' - reboot/restart services may be needed"
        return 0
      else
        _error "failed to set hostname on macOS"; return 1
      fi
      ;;

    linux)
      _current_hostname=$(hostname)
      if [[ "$_current_hostname" == "$_hostname" ]]; then _log "hostname already '$_hostname' on Linux"; return 0; fi

      if command -v hostnamectl &>/dev/null; then
        _log "setting Linux hostname to '$_hostname' via hostnamectl..."
        if sudo hostnamectl set-hostname "$_hostname"; then
          _log "linux hostname set to '$_hostname' - reboot/restart services may be needed"; return 0
        else
          _error "hostnamectl failed to set hostname"; return 1
        fi
      else
        _warn "hostnamectl not found. attempting limited manual change"
        if [[ -f /etc/hostname ]]; then
          echo "$_hostname" | sudo tee /etc/hostname > /dev/null && sudo hostname "$_hostname"
          # shellcheck disable=SC2181 # legacy, pre-loam: checks the exit code of the preceding && chain, not fixing to avoid touching legacy-unstable control flow
          if [[ $? -eq 0 ]]; then
            _log "/etc/hostname updated; runtime hostname set to '$_hostname'"
            _warn "manual /etc/hosts update may be needed - reboot recommended"
            return 0
          else
            _error "failed to update /etc/hostname or set runtime hostname"; return 1
          fi
        elif [[ -f /etc/sysconfig/network ]]; then # Older RHEL/CentOS
          if sudo sed -i.bak "s/^\(HOSTNAME=\).*/\1$_hostname/" /etc/sysconfig/network && sudo hostname "$_hostname"; then
            _log "/etc/sysconfig/network updated; runtime hostname set to '$_hostname'"
            _warn "manual /etc/hosts update may be needed - reboot recommended"
            return 0
          else
            _error "failed to update /etc/sysconfig/network or set runtime hostname"; return 1
          fi
        else
          _error "cannot auto-set hostname: /etc/hostname or /etc/sysconfig/network not found - set hostname manually per your Linux distribution's docs"; return $_E_DEP
        fi
      fi
      ;;
    *) _error "unsupported operating system: $_os"; return $_E_OS ;;
  esac
}
##] system

##[ filesystem

# info: set ownership of a file/directory to the real user when running under sudo
# usage: set-real-owner [-s (use sudo)] <path>
loam.set-real-owner() {
  local _use_sudo=false
  
  local OPTIND opt
  while getopts "sh" opt; do
    case $opt in
      s) _use_sudo=true ;;
      *) echo "usage: set-real-owner [-s (use sudo)] <path>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND-1))
  
  local _path="${1-}"
  if [[ -z "$_path" ]]; then echo "usage: set-real-owner [-s (use sudo)] <path>" >&2; return $_E_USG; fi
  if [[ ! -e "$_path" ]]; then echo "error: path does not exist: $_path"; return $_E_NF; fi
  
  # If not using sudo and not running as root, nothing to do
  if [[ "$_use_sudo" != true && "$(id -u)" -ne 0 ]]; then return 0; fi
  
  # Get the real user who invoked sudo
  local _real_user="${SUDO_USER:-$(logname 2>/dev/null || echo $USER)}"  
  local _real_group="$(id -gn $_real_user 2>/dev/null || id -gn)"
  
  # Apply ownership change - use -h for symlinks, -R for directories
  if $_use_sudo; then
    if [[ -L "$_path" ]]; then
      sudo chown -h "${_real_user}:${_real_group}" "$_path"     # Path is a symlink
    elif [[ -d "$_path" ]]; then
      sudo chown -R "${_real_user}:${_real_group}" "$_path"     # Path is a directory
    else
      sudo chown "${_real_user}:${_real_group}" "$_path"        # Path is a regular file or other type
    fi
  else
    if [[ -L "$_path" ]]; then
      chown -h "${_real_user}:${_real_group}" "$_path"     # Path is a symlink
    elif [[ -d "$_path" ]]; then
      chown -R "${_real_user}:${_real_group}" "$_path"     # Path is a directory
    else
      chown "${_real_user}:${_real_group}" "$_path"        # Path is a regular file or other type
    fi
  fi
  return $?
}

# info: create a directory with permission handling based on execution context
# usage: make-dir [-p (set ownership to the real user when using sudo)] [-q (quiet mode)] [-s (use sudo)] <path>
loam.make-dir() {
  local _chown=false
  local _quiet=false
  local _use_sudo=false
  
  local OPTIND opt
  while getopts "pqsh" opt; do
    case $opt in
      p) _chown=true ;;
      q) _quiet=true ;;
      s) _use_sudo=true ;;
      *) echo "usage: make-dir [-p set ownership to the real user (when using sudo)] [-q quiet mode] [-s use sudo] <path>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND-1))
  
  local _path=${1-}
  
  if [[ -z "$_path" ]]; then echo "usage: make-dir [-p set ownership to the real user (when using sudo)] [-q quiet mode] [-s use sudo] <path>" >&2; return $_E_USG; fi
  
  # Check if directory already exists
  if [[ -d "$_path" ]]; then return 0; fi
  
  # Create the directory
  if $_use_sudo; then
    if sudo mkdir -p "$_path"; then
      $_chown && loam.set-real-owner -s "$_path"
      ! $_quiet && _log "created directory: $_path"
      return 0
    else
      ! $_quiet && _error "failed to create directory: $_path"
      return 1
    fi
  else
    if mkdir -p "$_path"; then
      $_chown && loam.set-real-owner "$_path"
      ! $_quiet && _log "created directory: $_path"
      return 0
    else
      ! $_quiet && _error "failed to create directory: $_path"
      return 1
    fi
  fi
}

# info: creates a symbolic link; handles root links via make-root-symlink (macos/linux)
# usage: make-symlink [-p (set link owner to real user)] <source_path> <link_path>
loam.make-symlink() {
  local _chown_link_flag=false
  
  local OPTIND opt
  while getopts "ph" opt; do
    case $opt in
      p) _chown_link_flag=true ;;
      *) echo "usage: make-symlink [-p] <source_path> <link_path>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))

  local _source_path="${1-}"
  local _link_path="${2-}"

  if [[ -z "$_source_path" || -z "$_link_path" ]]; then echo "usage: make-symlink [-p] <source_path> <link_path>" >&2; return $_E_USG; fi

  # It's okay for source not to exist for a symlink, ln -s allows it.
  [[ ! -e "$_source_path" ]] && _warn "make-symlink: source '$_source_path' does not exist. creating potentially broken link"

  # Check for Root Link Case: target is /name (not /foo/bar, not /)
  local _link_parent_dir
  _link_parent_dir=$(dirname "$_link_path")

  if [[ "$_link_path" == /* && "$_link_parent_dir" == "/" && "$_link_path" != "/" ]]; then
    local _current_os_for_root_check
    _current_os_for_root_check=$(os)
    if [[ "$_current_os_for_root_check" == "mac" || "$_current_os_for_root_check" == "linux" ]]; then
      _log "root link '$_link_path' detected, delegating to make-root-symlink"
      local _abs_source_path_for_root=""

      if [[ "$_source_path" == /* ]]; then
        _abs_source_path_for_root="$_source_path"
      else # _source_path is relative, attempt to resolve
        if command -v realpath &>/dev/null; then
          local _realpath_output
          _realpath_output=$(realpath -m "$_source_path" 2>/dev/null)
          if [[ -n "$_realpath_output" && "$_realpath_output" == /* ]]; then
            _abs_source_path_for_root="$_realpath_output"
          fi
        fi

        if [[ -z "$_abs_source_path_for_root" ]]; then # If realpath failed or not available
          if [[ -e "$_source_path" ]]; then # Try cd/pwd if source exists
            local src_dir_component src_basename_component resolved_dir_path
            src_dir_component=$(dirname "$_source_path")
            src_basename_component=$(basename "$_source_path")
            resolved_dir_path=$( (cd "$src_dir_component" 2>/dev/null && pwd -P) )
            if [[ -n "$resolved_dir_path" && -d "$resolved_dir_path" ]]; then
              _abs_source_path_for_root="$resolved_dir_path/$src_basename_component"
              _abs_source_path_for_root="${_abs_source_path_for_root//\/\///}" # Normalize //
            fi
          elif [[ "$_source_path" != */* ]]; then # Relative, non-existent, simple name
            _abs_source_path_for_root="$PWD/$_source_path"
          fi
        fi
      fi

      if [[ -z "$_abs_source_path_for_root" || "$_abs_source_path_for_root" != /* ]]; then
        _error "make-symlink: could not resolve '$_source_path' to absolute for root link target"
        _warn "(final attempted: '$_abs_source_path_for_root'). ensure source is absolute, exists, or working realpath is installed"
        return 1
      fi
      
      local -a root_link_opts=()
      $_chown_link_flag && root_link_opts+=(-r) # Pass -r to make-root-symlink

      loam.make-root-symlink "${root_link_opts[@]}" "$(basename "$_link_path")" "$_abs_source_path_for_root"
      return $? # Propagate exit status of make-root-symlink
    fi
    # If not mac/linux, root link creation falls through to standard ln -sfn, which will likely fail for /link without sudo.
    # This is acceptable; make-root-symlink is the specialized handler.
  fi

  _log "standard symlink '$_link_path' -> '$_source_path'"
  if [[ -L "$_link_path" ]]; then # Link exists
    if [[ "$(readlink "$_link_path")" == "$_source_path" ]]; then
      _log "symlink '$_link_path' already correct"
      # Even if correct, apply ownership if requested (idempotent for ownership)
      $_chown_link_flag && loam.set-real-owner "$_link_path"
      return 0
    fi
    _log "symlink '$_link_path' exists but differs, re-creating"
    # ln -sfn will overwrite
  elif [[ -e "$_link_path" ]]; then # Path exists but is not a symlink
    _error "make-symlink: '$_link_path' exists and is not a symlink"; return 1
  fi

  # Create parent directory for the link_path if needed
  if [[ ! -d "$_link_parent_dir" ]]; then
    local -a md_opts=()
    # If -p was passed to make-symlink, also pass it to loam.make-dir for parent creation,
    # assuming loam.make-dir's -p implies setting ownership to real user.
    $_chown_link_flag && md_opts+=(-p)
    loam.make-dir "${md_opts[@]}" "$_link_parent_dir" || { _error "make-symlink: failed to create parent '$_link_parent_dir'"; return 1; }
  fi

  # Create the symlink (as current user).
  # If _link_path is in a privileged location (e.g. /usr/local/bin not writable by user), this will fail.
  # This function does not use sudo for standard symlinks.
  if ln -sfn "$_source_path" "$_link_path"; then
    _log "symlink created: '$_link_path' -> '$_source_path'"
    $_chown_link_flag && loam.set-real-owner "$_link_path" # chowns the link itself
    return 0
  else
    _error "make-symlink: failed to create symlink '$_link_path' (check permissions for '$_link_parent_dir'?)"; return 1
  fi
}

# info: creates root link (linux:/name->path) or synthetic mount (macos:/etc/synthetic.conf)
# usage: make-root-symlink [-r (set linux symlink owner to real user)] <link_name> <abs_target_path>
loam.make-root-symlink() {
  local _set_real_owner_flag=false
  
  local OPTIND opt
  while getopts "rh" opt; do # -r for "real owner"
    case $opt in
      r) _set_real_owner_flag=true ;;
      *) echo "usage: make-root-symlink [-r] <link_name_at_root> <absolute_target_path>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND - 1))

  local _link_name="${1-}"    # e.g., "data"
  local _target_path="${2-}"  # e.g., "/Users/Shared/Data", MUST be absolute
  
  local _root_path_to_create # e.g., "/data"
  local _current_os=$(os)

  if [[ -z "$_link_name" || -z "$_target_path" ]]; then echo "usage: make-root-symlink [-r] <link_name_at_root> <absolute_target_path>" >&2; return $_E_USG; fi
  if [[ "$_target_path" != /* ]]; then _error "make-root-symlink: target path '$_target_path' must be absolute"; return 1; fi
  if [[ "$_link_name" == */* || "$_link_name" == "." || "$_link_name" == ".." || -z "$_link_name" ]]; then
    _error "make-root-symlink: link name '$_link_name' is invalid"; return 1
  fi

  _root_path_to_create="/$_link_name"
  _log "ensure '$_root_path_to_create' -> '$_target_path' (os: $_current_os)"

  if [[ "$_current_os" == "mac" ]]; then
    # The -r flag (set real owner) is ignored for macOS synthetic mounts as their apparent
    # ownership in '/' is managed by the system and not directly chownable.
    # Ownership of the actual _target_path directory is what matters.
    $_set_real_owner_flag && _warn "make-root-symlink: -r flag ignored for macos synthetic mount '$_root_path_to_create'"

    local synthetic_conf="/etc/synthetic.conf"
    if ! sudo test -e "$synthetic_conf"; then
      _log "creating $synthetic_conf"
      { sudo touch "$synthetic_conf" && sudo chmod 644 "$synthetic_conf"; } || { _error "failed to create/permission $synthetic_conf"; return 1; }
    fi

    # Check if link_name is already configured and correct
    # Uses awk to extract the target path (second field onwards) from the matching line
    # `tr -d '\n'` removes trailing newline from awk, `xargs` trims whitespace.
    local _existing_target
    _existing_target=$(sudo grep -E "^${_link_name}[[:space:]\t]+" "$synthetic_conf" 2>/dev/null | head -n1 | awk '{sub($1"[ \t]*",""); print $0}' | tr -d '\n' | xargs)

    if [[ -n "$_existing_target" ]]; then # Entry found
      # Normalize both paths for comparison (synthetic.conf format is without leading slash)
      local _normalized_target="${_target_path#/}"
      if [[ "$_existing_target" == "$_normalized_target" ]]; then
        _log "synthetic mount '$_root_path_to_create' -> '$_target_path' already correct"
        return 0
      else
        _error "synthetic mount '$_root_path_to_create' in $synthetic_conf points to '$_existing_target' (expected '$_normalized_target'). manual review needed"
        return 1
      fi
    else # Entry not found, add it
      _log "adding synthetic mount '$_root_path_to_create' -> '$_target_path' to $synthetic_conf"
      # Strip leading slash from target path for synthetic.conf format
      local _synthetic_target="${_target_path#/}"
      if echo -e "${_link_name}\t${_synthetic_target}" | sudo tee -a "$synthetic_conf" >/dev/null; then
         _log "synthetic mount point added. reboot required for '$_root_path_to_create' to appear"
      else
        _error "failed to write to $synthetic_conf"; return 1
      fi
    fi
  elif [[ "$_current_os" == "linux" ]]; then
    if [[ "$_root_path_to_create" == "$_target_path" ]]; then _log "skip symlink: '$_root_path_to_create' would be self-referential"; return 0; fi

    if [[ -L "$_root_path_to_create" ]]; then # Symlink exists
      if [[ "$(readlink "$_root_path_to_create")" == "$_target_path" ]]; then
        _log "symlink '$_root_path_to_create' -> '$_target_path' already correct"
      else
        _log "updating symlink '$_root_path_to_create' to point to '$_target_path'"
        sudo ln -sfn "$_target_path" "$_root_path_to_create" || { _error "failed to update symlink"; return 1; }
      fi
    elif [[ -e "$_root_path_to_create" ]]; then # Path exists but is not a symlink
      _error "cannot create symlink: '$_root_path_to_create' exists and is not a symlink"; return 1
    else # Path does not exist, create symlink
      _log "creating symlink '$_root_path_to_create' -> '$_target_path'"
      sudo ln -sfn "$_target_path" "$_root_path_to_create" || { _error "failed to create symlink"; return 1; }
    fi

    # If -r flag, set ownership of the symlink itself to the real user (after sudo ln created it as root)
    if $_set_real_owner_flag; then
      _log "setting ownership of symlink '$_root_path_to_create' to real user"
      # loam.set-real-owner uses `chown -h` for symlinks and handles sudo if needed.
      if ! loam.set-real-owner "$_root_path_to_create"; then
        _warn "failed to set ownership on root symlink '$_root_path_to_create'"
      fi
    fi
  else
    _warn "unsupported operating system: $_current_os"; return $_E_OS
  fi
  return 0
}

# info: create or update a file with permission handling
# usage: make-touch [-p set ownership to the real user (when using sudo)] <file_path>
loam.make-touch() {
  local _chown=false
  
  local OPTIND opt
  while getopts "ph" opt; do
    case $opt in
      p) _chown=true ;;
      *) echo "usage: make-touch [-p set ownership to the real user (when using sudo)] <file_path>" >&2; return $_E_USG ;;
    esac
  done
  shift $((OPTIND-1))
  
  # Get the file path
  local _file_path="${1-}"
  if [[ -z "$_file_path" ]]; then echo "usage: make-touch [-p set ownership to the real user (when using sudo)] <file_path>" >&2; return $_E_USG; fi
  
  # Create parent directory if needed
  local _parent_dir="$(dirname "$_file_path")"
  if [[ ! -d "$_parent_dir" ]]; then
    loam.make-dir "$_parent_dir" || return 1
  fi
  
  # Create or update the file
  if touch "$_file_path"; then
    $_chown && loam.set-real-owner "$_file_path"; return 0
  else
    _error "failed to create or update file $_file_path"; return 1
  fi
}

# info: create a timestamped, one-time backup of a file or directory before a destructive write.
#       NOT a versioning mechanism - just a machine-local safety copy.
# usage: make-backup <file_or_directory> [backup_dir]
loam.make-backup() {
  local OPTIND; getopts "h" _ && { echo "usage: make-backup <file_or_directory> [backup_dir]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _file="${1-}"
  local _bakdir="${2-}"
  if [[ -z "$_file" ]]; then echo "usage: make-backup <file_or_directory> [backup_dir]"; return 1; fi
  if [[ ! -e "$_file" ]]; then _error "not found: $_file"; return $_E_NF; fi

  local _backup_name
  if [[ -n "$_bakdir" ]]; then
    loam.make-dir -q "$_bakdir" || { _error "failed to create backup directory: $_bakdir"; return 1; }
    _backup_name="${_bakdir%/}/$(basename "$_file")_$(date +%Y%m%d-%H%M%S).bak"
  else
    _backup_name="${_file}_$(date +%Y%m%d-%H%M%S).bak"
  fi

  if cp -a "$_file" "$_backup_name"; then
    echo "$_backup_name"; return 0
  else
    _error "failed to create backup of $_file"; return 1
  fi
}

# info: create temporary directory with optional prefix
# usage: temp-dir [prefix]
loam.temp-dir() {
  local OPTIND; getopts "h" _ && { echo "usage: temp-dir [prefix]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _prefix="${1:-$(loam.str-timestamp file)}"
  
  # Check if mktemp is available
  if ! command -v mktemp &>/dev/null; then
    # Fallback: create directory manually
    local _temp_base="${TMPDIR:-/tmp}"
    local _temp_dir="$_temp_base/${_prefix}_$$_$(date +%s)"
    if mkdir -p "$_temp_dir" 2>/dev/null; then
      echo "$_temp_dir"
      return 0
    else
      _error "failed to create temporary directory (no mktemp available)"; return 1
    fi
  fi
  
  # Try BSD/macOS style first, then GNU style
  if mktemp -d -t "$_prefix" 2>/dev/null; then
    return 0
  elif mktemp -d --tmpdir -t "${_prefix}.XXXXXX" 2>/dev/null; then
    return 0
  else
    _error "failed to create temporary directory"; return 1
  fi
}

# info: create temporary file with optional prefix and extension  
# usage: temp-file [prefix] [extension]
loam.temp-file() {
  local OPTIND; getopts "h" _ && { echo "usage: temp-file [prefix] [extension]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _prefix="${1:-$(loam.str-timestamp file)}"
  local _extension="${2:-tmp}"
  
  # Check if mktemp is available
  if ! command -v mktemp &>/dev/null; then
    # Fallback: create file manually
    local _temp_base="${TMPDIR:-/tmp}"
    local _temp_file="$_temp_base/${_prefix}_$$_$(date +%s).${_extension}"
    if touch "$_temp_file" 2>/dev/null; then
      echo "$_temp_file"
      return 0
    else
      _error "failed to create temporary file (no mktemp available)"; return 1
    fi
  fi
  
  # Create temp file with prefix only, then append extension
  local _temp_file
  if _temp_file=$(mktemp -t "$_prefix" 2>/dev/null); then
    local _final_file="${_temp_file}.${_extension}"
    if mv "$_temp_file" "$_final_file" 2>/dev/null; then
      echo "$_final_file"
      return 0
    else
      rm -f "$_temp_file" 2>/dev/null
      _error "failed to rename temporary file with extension"; return 1
    fi
  elif _temp_file=$(mktemp --tmpdir -t "${_prefix}.XXXXXX" 2>/dev/null); then
    local _final_file="${_temp_file}.${_extension}"
    if mv "$_temp_file" "$_final_file" 2>/dev/null; then
      echo "$_final_file"
      return 0
    else
      rm -f "$_temp_file" 2>/dev/null
      _error "failed to rename temporary file with extension"; return 1
    fi
  else
    _error "failed to create temporary file"; return 1
  fi
}

# info: move file or directory to temporary location with optional prefix and extension
# usage: temp-move <target> [prefix] [extension]
loam.temp-move() {
  local OPTIND; getopts "h" _ && { echo "usage: temp-move <target> [prefix] [extension]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _target="${1-}"
  local _prefix="${2:-$(basename "$_target")}"
  local _extension="${3-}"
	 
  if [[ -z "$_target" ]]; then
    echo "usage: temp-move <target> [prefix] [extension]" >&2; return $_E_USG
  fi
  
  if [[ ! -e "$_target" ]]; then
    _warn "target does not exist: $_target"; return 1
  fi
  
  # Determine extension and target type
  local _is_directory=false
  if [[ -d "$_target" ]]; then
    _is_directory=true
    _extension="${_extension:-dir}"
  else
    # Extract original extension from filename, fallback to 'bak'
    if [[ -z "$_extension" ]]; then
      local _basename=$(basename "$_target")
      if [[ "$_basename" == *.* ]]; then
        _extension="${_basename##*.}"
        # Remove extension from prefix to avoid duplication
        _prefix="${_prefix%.*}"
      else
        _extension="bak"
      fi
    fi
  fi
  
  # Generate temp path (but don't create the file/directory yet)
  local _temp_base
  _temp_base=$(loam.temp-file "$_prefix" "$_extension") || {
    _error "failed to generate temporary path"; return 1
  }
  
  # Remove the temp file that was created (we just needed the path)
  rm -f "$_temp_base" 2>/dev/null
  
  # Move target to temp location
  if mv "$_target" "$_temp_base" 2>/dev/null; then
    if $_is_directory; then
      _log "directory moved to: $_temp_base"
    else
      _log "file moved to: $_temp_base"
    fi
    echo "$_temp_base"
    return 0
  else
    _error "failed to move target to temporary location"; return 1
  fi
}

# info: get file checksum
# usage: get-checksum <file>
loam.get-checksum() {
  local OPTIND; getopts "h" _ && { echo "usage: get-checksum <file>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _file="${1-}"

  if [[ -z "$_file" ]]; then echo "usage: get-checksum <file>" >&2; return $_E_USG; fi
  if [[ ! -f "$_file" ]]; then _error "not found: $_file"; return $_E_NF; fi

  # Get file hash using available tool
  if command -v shasum &>/dev/null; then
    _actual=$(shasum -a 256 -- "$_file" | cut -d' ' -f1)
  elif command -v sha256sum &>/dev/null; then
    _actual=$(sha256sum -- "$_file" | cut -d' ' -f1)
  else
    _error "checksum verification unavailable: neither shasum nor sha256sum found"; return $_E_DEP
  fi
  echo "$_actual"
}

# info: verify file checksum against expected SHA256
# usage: verify-checksum <file> <expected_sha256>
loam.verify-checksum() {
  local OPTIND; getopts "h" _ && { echo "usage: verify-checksum <file> <expected_sha256>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _file="${1-}"
  local _expected="${2-}"
  local _actual _actual_lower _expected_lower

  if [[ -z "$_file" || -z "$_expected" ]]; then echo "usage: verify-checksum <file> <expected_sha256>" >&2; return $_E_USG; fi
  if [[ ! -f "$_file" ]]; then _error "not found: $_file"; return $_E_NF; fi

  # Get file hash using available tool
  if command -v shasum &>/dev/null; then
    _actual=$(shasum -a 256 -- "$_file" | cut -d' ' -f1)
  elif command -v sha256sum &>/dev/null; then
    _actual=$(sha256sum -- "$_file" | cut -d' ' -f1)
  else
    _error "checksum verification unavailable: neither shasum nor sha256sum found"; return $_E_DEP
  fi

  if [[ -z "$_actual" ]]; then _error "failed to calculate checksum for $_file"; return 1; fi

  # Convert to lowercase for case-insensitive comparison (portable)
  _actual_lower=$(echo "$_actual" | tr '[:upper:]' '[:lower:]')
  _expected_lower=$(echo "$_expected" | tr '[:upper:]' '[:lower:]')

  if [[ "$_actual_lower" == "$_expected_lower" ]]; then
    _log "checksum matched"
    return 0
  else
    _error "checksum mismatch for '$_file' - expected: $_expected | actual: $_actual"; 
	return 1
  fi
}

# info: get file type (mime)
# usage: get-filetype <file>
loam.get-filetype() {
  local OPTIND; getopts "h" _ && { echo "usage: get-filetype <file>" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _file="${1-}"

  if [[ -z "$_file" ]]; then echo "usage: get-filetype <file>" >&2; return $_E_USG; fi
  if [[ ! -f "$_file" ]]; then _error "not found: $_file"; return $_E_NF; fi

  # Get file type using available tool
  if command -v file &>/dev/null; then
    file -b --mime-type "$_file" 2>/dev/null
  else
    _error "file type detection unavailable: file command not found"; return $_E_DEP
  fi
}

# info: remove macOS quarantine attribute from files/directories
# usage: remove-quarantine <path> [path...]
loam.remove-quarantine() {
  local OPTIND; getopts "h" _ && { echo "usage: remove-quarantine <path> [path...]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  if [[ $# -eq 0 ]]; then
    echo "usage: remove-quarantine <path> [path...]" >&2
    return $_E_USG
  fi

  local _os
  _os=$(os)

  case "$_os" in
    mac)
      command -v xattr &>/dev/null || { _error "xattr command not found"; return $_E_DEP; } # Check if xattr command is available
      local _path _removed_count=0 _total_count=0
      
      for _path in "$@"; do
        ((_total_count++))
        
        if [[ ! -e "$_path" ]]; then
          _warn "path does not exist: $_path"
          continue
        fi
        
        # Check if quarantine attribute exists
        if xattr -p com.apple.quarantine "$_path" &>/dev/null; then
          _log "removing quarantine from: $_path"
          if xattr -r -d com.apple.quarantine "$_path" 2>/dev/null; then
            ((_removed_count++))
          else
            _warn "failed to remove quarantine from: $_path"
          fi
        else
          _log "no quarantine attribute found: $_path"
        fi
      done
      _log "processed $_total_count item(s), removed quarantine from $_removed_count item(s)"; return 0
      ;;
    linux|win) _log "quarantine removal not needed on $_os"; return 0 ;;
    *) _error "unsupported operating system: $_os"; return $_E_OS ;;
  esac
}

# info: install application from DMG file on macOS
# usage: install-dmg <dmg_file> [app_name] [location]
loam.install-dmg() {
  local OPTIND; getopts "h" _ && { echo "usage: install-dmg <dmg_file> [app_name] [location]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  local _dmg_file="${1-}" _app_name="${2-}" _install_location="${3:-/Applications}"

  [[ -z "$_dmg_file" ]] && { echo "usage: install-dmg <dmg_file> [app_name] [location]" >&2; return $_E_USG; }
  [[ "$(os)" != "mac" ]] && { _error "install-dmg is only supported on macOS"; return $_E_OS; }
  [[ ! -f "$_dmg_file" ]] && { _error "DMG file not found: $_dmg_file"; return $_E_NF; }
  command -v diskutil &>/dev/null || { _error "diskutil command not found"; return $_E_DEP; }

  _log "mounting DMG: $_dmg_file"
  
  # Mount the DMG and capture the mount point
  local _mount_output _mount_point _device
  _mount_output=$(diskutil image attach "$_dmg_file" --mountOptions nobrowse 2>/dev/null) || { _error "failed to mount DMG: $_dmg_file"; return 1; }
  
  _debug "diskutil output: $_mount_output"
  
  # Extract mount point from diskutil output, handling spaces properly
  _mount_point=$(echo "$_mount_output" | grep '/Volumes/' | tail -1 | awk '{for(i=1;i<=NF;i++) if($i ~ /^\/Volumes\//) {for(j=i;j<=NF;j++) printf "%s%s", $j, (j==NF?"\n":" ")}}')
  _device=$(echo "$_mount_output" | head -1 | awk '{print $1}')
  
  _debug "parsed mount point: '$_mount_point'"
  _debug "parsed device: '$_device'"
  
  [[ -z "$_mount_point" || ! -d "$_mount_point" ]] && { _error "failed to determine mount point for DMG"; return 1; }
  _log "DMG mounted at: $_mount_point"
  
  # Find .app bundle to install
  local _app_bundle
  if [[ -n "$_app_name" ]]; then
    _app_bundle="$_mount_point/$_app_name"
    [[ ! -d "$_app_bundle" ]] && _app_bundle="$_mount_point/${_app_name}.app"
  else
    _app_bundle=$(find "$_mount_point" -name "*.app" -type d | head -1)
  fi
  
  if [[ -z "$_app_bundle" || ! -d "$_app_bundle" ]]; then
    _error "no .app bundle found in DMG"
    diskutil unmount "$_mount_point" >/dev/null 2>&1 || true
    return 1
  fi
  
  local _app_basename=$(basename "$_app_bundle")
  local _target_path="$_install_location/$_app_basename"
  _log "installing: $_app_basename -> $_install_location"
  _debug "app bundle found: '$_app_bundle'"
  _debug "app basename: '$_app_basename'"
  _debug "target path: '$_target_path'"
  
  # Create install location if needed
  if [[ ! -d "$_install_location" ]]; then
    if [[ "$_install_location" == /Applications* || "$_install_location" == /usr/* ]]; then
      loam.make-dir -s -p "$_install_location" || { _error "failed to create install directory: $_install_location"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
    else
      loam.make-dir -p "$_install_location" || { _error "failed to create install directory: $_install_location"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
    fi
  fi
  
  # Remove existing app if present
  if [[ -e "$_target_path" ]]; then
    _warn "removing existing application: $_target_path"
    if [[ "$_install_location" == /Applications* || "$_install_location" == /usr/* ]]; then
      sudo rm -rf "$_target_path" || { _error "failed to remove existing application: $_target_path"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
    else
      rm -rf "$_target_path" || { _error "failed to remove existing application: $_target_path"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
    fi
  fi
  
  # Copy the application
  if [[ "$_install_location" == /Applications* || "$_install_location" == /usr/* ]]; then
    sudo cp -R "$_app_bundle" "$_install_location/" || { _error "failed to copy application to $_install_location"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
    loam.set-real-owner -s "$_target_path" || _warn "could not set ownership for $_target_path"
  else
    cp -R "$_app_bundle" "$_install_location/" || { _error "failed to copy application to $_install_location"; diskutil unmount "$_mount_point" >/dev/null 2>&1 || true; return 1; }
  fi
  
  loam.remove-quarantine "$_target_path" || _warn "could not remove quarantine from $_target_path"
  
  _log "unmounting DMG"
  diskutil unmount "$_mount_point" >/dev/null 2>&1 || _warn "failed to cleanly unmount DMG"
  
  _log "successfully installed: $_app_basename in $_install_location"
  echo "$_target_path"
  return 0
}

# info: move file or directory to trash (macOS Trash or Linux XDG Trash)
# usage: trash <path> [path...]
loam.trash() {
  local OPTIND; getopts "h" _ && { echo "usage: trash <path> [path...]" >&2; return $_E_USG; }; shift $((OPTIND-1))
  [[ $# -eq 0 ]] && { echo "usage: trash <path> [path...]" >&2; return $_E_USG; }
  
  local _os_type; _os_type="$(os)"
  local _trash_dir=""
  
  # Determine trash directory based on OS
  case "$_os_type" in
    mac)
      _trash_dir="$HOME/.Trash"
      ;;
    linux)
      _trash_dir="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
      ;;
    *)
      _trash_dir="$HOME/.trash"
      ;;
  esac
  
  # Create trash directory if it doesn't exist
  [[ ! -d "$_trash_dir" ]] && mkdir -p "$_trash_dir"
  
  local _path _trashed_count=0 _total_count=0
  for _path in "$@"; do
    ((_total_count++))
    
    [[ ! -e "$_path" ]] && { _warn "path not found: $_path"; continue; }
    
    local _basename="$(basename "$_path")"
    local _trash_target="$_trash_dir/$_basename"
    
    # Handle name conflicts by appending counter
    local _counter=1
    while [[ -e "$_trash_target" ]]; do
      local _name="${_basename%.*}"
      local _ext="${_basename##*.}"
      if [[ "$_name" == "$_ext" ]]; then
        # No extension
        _trash_target="$_trash_dir/${_basename}_${_counter}"
      else
        # Has extension
        _trash_target="$_trash_dir/${_name}_${_counter}.${_ext}"
      fi
      ((_counter++))
    done
    
    # Move to trash
    if mv "$_path" "$_trash_target" 2>/dev/null; then
      _log "moved to trash: $_path"
      ((_trashed_count++))
    else
      _warn "failed to move to trash: $_path"
    fi
  done
  
  [[ $_trashed_count -gt 0 ]] && _log "successfully trashed $_trashed_count of $_total_count item(s)"
  return 0
}
