# info: get content from clipboard
# usage: clip-get
loam.clip-get() {
  if command -v pbpaste &>/dev/null; then
    pbpaste									# macOS
  elif command -v xclip &>/dev/null; then
    xclip -selection clipboard -o			# Linux with xclip
  elif command -v xsel &>/dev/null; then
    xsel --clipboard --output				# Linux with xsel
  elif command -v powershell.exe &>/dev/null; then
    powershell.exe -noprofile -command Get-Clipboard # Windows with WSL
  else
    _error "no clipboard get command available (pbpaste/xclip/xsel/powershell)"; return $_E_DEP
  fi
  return $?
}

# info: set content to clipboard
# usage: clip-set [text] or pipe input
loam.clip-set() {
  local _input_text # Used for argument input

  if [[ -p /dev/stdin ]]; then
    # Handle piped input
    if command -v pbcopy &>/dev/null; then pbcopy;									# macOS
    elif command -v xclip &>/dev/null; then xclip -selection clipboard -i;			# Linux with xclip
    elif command -v xsel &>/dev/null; then xsel --clipboard --input;				# Linux with xsel
    elif command -v clip.exe &>/dev/null; then clip.exe;								# Windows with WSL (native)
    elif command -v powershell.exe &>/dev/null; then powershell.exe -noprofile -command "\$input|Set-Clipboard"; # Windows with WSL (powershell)
    else
        _error "no clipboard set command available (pbcopy/xclip/xsel/clip.exe/powershell)"; return $_E_DEP
    fi
    return $?
  elif [[ $# -gt 0 ]]; then
    # Handle direct arguments
    _input_text="$*"
    if command -v pbcopy &>/dev/null; then echo -n "$_input_text" | pbcopy;						# macOS
    elif command -v xclip &>/dev/null; then echo -n "$_input_text" | xclip -selection clipboard -i;	# Linux with xclip
    elif command -v xsel &>/dev/null; then echo -n "$_input_text" | xsel --clipboard --input;		# Linux with xsel
    elif command -v clip.exe &>/dev/null; then echo -n "$_input_text" | clip.exe;					# Windows with WSL (native)
    elif command -v powershell.exe &>/dev/null; then echo -n "$_input_text" | powershell.exe -noprofile -command "\$input|Set-Clipboard"; # Windows with WSL (powershell)
    else
      _error "no clipboard set command available (pbcopy/xclip/xsel/clip.exe/powershell)"; return $_E_DEP
    fi
    return $?
  else
      echo "usage: clip-set [text] or <input> | loam.clip-set" >&2; return $_E_USG
  fi
}
