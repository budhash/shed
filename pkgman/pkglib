#!/usr/bin/env bash
##( header
# --------------------------------------------------------------------
# pkglib - Universal package/software management library
#
# Stateless library providing standardized interfaces for package
# installation, updates, removal, and status checking across different
# package managers and software sources. Uses loam library internally
# for cross-platform compatibility and robust file operations.
#
# PARAMETER SEMANTICS:
# All pkglib functions use a unified interface: <name> <force> [kwargs...]
# where 'name' represents the package identifier that each manager understands:
#   • brew/apt/dnf: package name (e.g., "docker", "nginx")
#   • mas: App Store ID (e.g., "497799835")
#   • cargo: crate name (e.g., "ripgrep")
#   • go: module path (e.g., "golang.org/x/tools/cmd/goimports@latest")
#   • pipx: Python package name (e.g., "black")
#   • npm: npm package name (e.g., "prettier", "@anthropic-ai/claude-code")
#   • github: repository path (e.g., "obsidianmd/obsidian-releases")
#   • download: full URL (e.g., "https://example.com/file.zip")
#   • script: executable script path (e.g., "/path/to/install.sh")
#
# ARCHITECTURE OVERVIEW:
# • Common Templates: Traditional managers (brew/apt/dnf) use shared install/update/uninstall logic
# • Execute Functions: All managers implement unified action mapping via pkglib.{manager}.execute
# • Delegation Pattern: Complex managers (github) delegate to simpler ones (download) after URL resolution
# • Status Constants: All functions return _PKGLIB_STATUS_INSTALLED or _PKGLIB_STATUS_MISSING
# • Cross-Platform: OS-specific validation prevents incompatible installations
#
# Supports: brew, apt, dnf, mas (Mac App Store), cargo, go, pipx, npm, github, download, script
# All functions require explicit parameters - no state or auto-detection.
# For stateful operations with auto-detection, use pkgman CLI.
# --------------------------------------------------------------------
# AUTHOR: Budha <budhash@gmail.com>
# VERSION: 1.0.0
# LICENSE: MIT License
# --------------------------------------------------------------------
##) header

# shellcheck disable=SC1090,SC2154 # loam is sourced from a runtime-resolved path ($LOAM or in-repo relative); location can't be known statically. _E/_E_USG/_E_DEP/_E_NF/_E_NP/_E_OS are defined by loam at source time; verified live by tests.sh
##( configuration
# Include guard to prevent multiple sourcing
[[ -n "${PKGLIB_LOADED:-}" ]] && return 0
readonly PKGLIB_LOADED=1

# Source loam library dependency ($LOAM > in-repo relative > error)
if [[ -n "${LOAM:-}" && -f "$LOAM" ]]; then
  source "$LOAM" || { echo "Error: failed to load loam ($LOAM)" >&2; exit 1; }
elif [[ -f "${BASH_SOURCE[0]%/*}/../lib/common/loam/loam" ]]; then
  source "${BASH_SOURCE[0]%/*}/../lib/common/loam/loam" || { echo "Error: failed to load loam" >&2; exit 1; }
else
  echo "Error: loam library not found (set \$LOAM or run from the shed tree)" >&2; exit 1
fi
if ! command -v loam.smart-download &>/dev/null; then
  echo "Error: loam.smart-download not found - ensure loam is properly loaded" >&2; exit 1
fi
##) configuration

##( constants
##@ Common status constants
readonly _PKGLIB_STATUS_INSTALLED="installed"
readonly _PKGLIB_STATUS_MISSING="missing"
##@ Action constants
readonly _PKGLIB_ACTION_INSTALL="install"
readonly _PKGLIB_ACTION_REINSTALL="reinstall"
readonly _PKGLIB_ACTION_UPDATE="update"
readonly _PKGLIB_ACTION_REUPDATE="reupdate" # force update
readonly _PKGLIB_ACTION_UNINSTALL="uninstall"

##@ GitHub API constants
readonly _PKGLIB_GITHUB_API_BASE="https://api.github.com"
##) constants

##( helpers
##@ Maps a manager name to the CLI tool that implements it (managers without their own binary).
##: _pkglib.manager_tool <manager> -> tool=$(_pkglib.manager_tool cask)
_pkglib.manager_tool() {
  case "$1" in
    cask) echo "brew" ;;
    *) echo "$1" ;;
  esac
}

##@ Check if required tool is available
##: _pkglib.require_tool <tool> -> _pkglib.require_tool brew
_pkglib.require_tool() {
  local _tool="$1"
  [[ -z "$_tool" ]] && { _error "tool name required"; return $_E_USG; }
  
  command -v "$_tool" &>/dev/null && return 0
  _error "dependency not found: $_tool"
  return $_E_DEP
}

##@ Validate required parameters
##: _pkglib.require_params <name> <value> [name2] [value2] -> _pkglib.require_params "package name" "$_name"
_pkglib.require_params() {
  while [[ $# -gt 0 ]]; do
    local _param_name="$1"
    local _param_value="$2"
    [[ -z "$_param_value" ]] && { _error "$_param_name required"; return $_E_USG; }
    shift 2
  done
}

##@ Validate URL format
##: _pkglib.validate_url <url> -> _pkglib.validate_url "https://example.com/file"
_pkglib.validate_url() {
  local _url="$1"
  [[ -z "$_url" ]] && { _error "URL required"; return $_E_USG; }
  
  # Check for basic URL format (http/https/ftp)
  if [[ ! "$_url" =~ ^(https?|ftp)://[a-zA-Z0-9.-]+[a-zA-Z0-9._/-]*$ ]]; then
    _error "invalid URL format: '$_url'"
    return $_E_USG
  fi
}

##@ Generic parameter extraction helpers for cleaner kwargs handling
##@ Extract single parameter value from kwargs
##: _pkglib.get_arg <param_name> <required> "$@" -> value=$(_pkglib.get_arg source true "$@")
_pkglib.get_arg() {
  local _param_name="$1" _required="$2"
  shift 2
  
  local _value=""
  if [[ $# -gt 0 ]]; then
    local _arg
    for _arg in "$@"; do
      case "$_arg" in
        --${_param_name}=*)
          _value="${_arg#*=}"
          break
          ;;
      esac
    done
  fi
  
  # Check if required parameter is missing
  if [[ "$_required" == "true" && -z "$_value" ]]; then
    _error "missing required parameter: --$_param_name"
    return $_E_USG
  fi
  
  echo "$_value"
}

##@ Extract required parameter value from kwargs (errors if missing)
##: _pkglib.get_arg_rqd <param_name> "$@" -> value=$(_pkglib.get_arg_rqd source "$@")
_pkglib.get_arg_rqd() {
  local _param_name="$1"
  shift
  _pkglib.get_arg "$_param_name" true "$@"
}

##@ Extract optional parameter value from kwargs with default
##: _pkglib.get_arg_opt <param_name> <default> "$@" -> value=$(_pkglib.get_arg_opt dest "." "$@")
_pkglib.get_arg_opt() {
  local _param_name="$1" _default="$2"
  shift 2
  local _value
  _value=$(_pkglib.get_arg "$_param_name" false "$@")
  echo "${_value:-$_default}"
}

##@ Extract optional parameter value from kwargs (no default, can be empty)
##: _pkglib.get_arg_maybe <param_name> "$@" -> value=$(_pkglib.get_arg_maybe checksum "$@")
_pkglib.get_arg_maybe() {
  local _param_name="$1"
  shift
  _pkglib.get_arg "$_param_name" false "$@"
}

##@ Generate display string for kwargs arguments
##: _pkglib.get_args_display "$@" -> display=$(_pkglib.get_args_display "$@")
_pkglib.get_args_display() {
  if [[ $# -gt 0 ]]; then
    echo "$*"
  else
    echo "no additional args"
  fi
}

##@ Convert shell glob pattern to regex pattern for grep
##: _pkglib.convert_glob_to_regex <pattern> -> regex=$(_pkglib.convert_glob_to_regex "*.dmg")
_pkglib.convert_glob_to_regex() {
  local _pattern="$1"
  [[ -z "$_pattern" ]] && { _error "pattern required"; return $_E_USG; }
  
  # Escape regex special characters except * and ?
  _pattern="${_pattern//\\/\\\\}"
  _pattern="${_pattern//\./\\.}"
  _pattern="${_pattern//\[/\\[}"
  _pattern="${_pattern//\]/\\]}"
  _pattern="${_pattern//\^/\\^}"
  _pattern="${_pattern//\$/\\$}"
  _pattern="${_pattern//\+/\\+}"
  _pattern="${_pattern//\(/\\(}"
  _pattern="${_pattern//\)/\\)}"
  _pattern="${_pattern//\{/\\{}"
  _pattern="${_pattern//\}/\\}"
  _pattern="${_pattern//\|/\\|}"
  
  # Convert glob wildcards to regex
  _pattern="${_pattern//\*/.*}"
  _pattern="${_pattern//\?/.}"
  
  echo "$_pattern"
}

##@ Check if package installation should be skipped (already installed, non-force mode)
##: _pkglib.already_installed <name> <check_command> -> _pkglib.already_installed "docker" "brew list docker"
_pkglib.already_installed() {
  local _name="$1" _check_cmd="$2"
  [[ -z "$_name" ]] && { _error "package name required"; return $_E_USG; }
  [[ -z "$_check_cmd" ]] && { _error "check command required"; return $_E_USG; }
  
  if eval "$_check_cmd" &>/dev/null; then
    _log "already installed: $_name"
    return 0
  fi
  return 1
}

##@ Validate script exists and is executable
##: _pkglib.ensure_executable <script_path> -> _pkglib.ensure_executable "/path/to/script.sh"
_pkglib.ensure_executable() {
  local _file="$1"
  [[ -z "$_file" ]] && { _error "script path required"; return $_E_USG; }
  [[ ! -f "$_file" ]] && { _error "script not found: $_file"; return $_E_NF; }
  [[ ! -x "$_file" ]] && { _error "script not executable: $_file"; return $_E_NP; }
  return 0
}

##@ Check if kwargs array has content
##: _pkglib.has_kwargs kwargs_array -> _pkglib.has_kwargs "${_kwargs[@]}"
_pkglib.has_kwargs() {
  [[ $# -gt 0 && -n "${1:-}" ]]
}

##@ Filter out pkgman-specific parameters from kwargs array (bash 3.2 compatible)
##@ Usage: _filtered=($(_pkglib.filter_kwargs "$@")) 
##@ Usage: _filtered=($(_pkglib.filter_kwargs --npx --version "$@"))  # with custom filters
##@ Standard filtered parameters: --os, --dest, --artifact, --scope, --sudo, --detail
_pkglib.filter_kwargs() {
  local _custom_filters=()
  
  # Collect custom filter parameters (those starting with --)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --*)
        # Check if this is a filter specification (no = sign, just --param)
        if [[ "$1" != *"="* ]]; then
          _custom_filters+=("$1")
          shift
        else
          # This is actual kwarg data, stop collecting filters
          break
        fi
        ;;
      *)
        # Non-option argument, stop collecting filters
        break
        ;;
    esac
  done
  
  # Standard pkgman parameters to always filter out
  local _standard_filters=(--os --dest --artifact --scope --sudo --detail)
  
  # Process remaining arguments (the actual kwargs to filter)
  local _arg
  for _arg in "$@"; do
    local _should_filter=false
    
    # Check against standard filters
    local _filter
    for _filter in "${_standard_filters[@]}"; do
      if [[ "$_arg" == "$_filter" || "$_arg" == "$_filter="* ]]; then
        _should_filter=true
        break
      fi
    done
    
    # Check against custom filters if not already filtered
    if [[ "$_should_filter" == "false" && ${#_custom_filters[@]} -gt 0 ]]; then
      for _filter in "${_custom_filters[@]}"; do
        if [[ "$_arg" == "$_filter" || "$_arg" == "$_filter="* ]]; then
          _should_filter=true
          break
        fi
      done
    fi
    
    # Output argument if not filtered
    [[ "$_should_filter" == "false" ]] && echo "$_arg"
  done
}

##@ Resolve script source path with fallback search
##: _pkglib.resolve_source_path <source> -> resolved_path=$(_pkglib.resolve_source_path "pkgboot")
_pkglib.resolve_source_path() {
  local _source="$1"
  [[ -z "$_source" ]] && { _error "source path required"; return $_E_USG; }
  
  # If already absolute path, use directly
  if [[ "$_source" == /* ]]; then
    echo "$_source"
    return 0
  fi
  
  # Search priority order for relative paths:
  local _search_paths=(
    # 0. pkgman's own dir (dogfooding: a self-hosted provision runs script rows like `pkgboot`
    #    that live beside pkgman itself — e.g. radix seeds shed then provisions from it)
    "$(dirname "${BASH_SOURCE[0]}")/$_source"
    # 1. Relative to current script's bin directory (for pkglib in lib/, check ../bin/)
    "$(dirname "${BASH_SOURCE[0]}")/../bin/$_source"
    # 2. Relative to current script's ins directory (for pkglib in lib/, check ../ins/)
    "$(dirname "${BASH_SOURCE[0]}")/../ins/$_source"
    # 3. Standard locations
    "$HOME/.local/bin/$_source"
    "/usr/local/bin/$_source"
  )
  
  local _path
  for _path in "${_search_paths[@]}"; do
    # Resolve any .. paths
    _path="$(realpath "$_path" 2>/dev/null || echo "$_path")"
    if [[ -f "$_path" && -x "$_path" ]]; then
      echo "$_path"
      return 0
    fi
  done
  
  # 4. Finally try PATH lookup
  if command -v "$_source" &>/dev/null; then
    command -v "$_source"
    return 0
  fi
  
  _error "script not found: $_source (searched: ${_search_paths[*]} and PATH)"
  return $_E_NF
}

##) helpers

##( managers
##[ common
##@ common install flow
##: pkglib.common.install <manager> <name> <force> [--key=value...] -> pkglib.common.install brew docker true --cask
pkglib.common.install() {
  local _manager="$1" _name="$2" _force="$3"
  _pkglib.require_params "manager" "$_manager" "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 3
  
  local _kwargs=("$@")
  _pkglib.require_tool "$(_pkglib.manager_tool "$_manager")" || return $_E_DEP
  
  # Action
  _log "installing package - $_manager: $_name (force: $_force) with args: [$(_pkglib.get_args_display "$@")]"
  
  # Check if already installed first
  local _status
  _status=$(pkglib.${_manager}.status "$_name" "false" "${_kwargs[@]+"${_kwargs[@]}"}")

  if [[ "$_status" == "$_PKGLIB_STATUS_INSTALLED" ]]; then
    if [[ "$_force" == "true" ]]; then
      # Already installed + force = reinstall
      pkglib.${_manager}.execute "$_PKGLIB_ACTION_REINSTALL" "$_name" "${_kwargs[@]+"${_kwargs[@]}"}" || { _error "$_manager execute failed"; return $_E; }
    else
      # Already installed + no force = skip
      _log "already installed: $_name"
      return 0
    fi
  else
    # Not installed = install (ignore force flag)
    pkglib.${_manager}.execute "$_PKGLIB_ACTION_INSTALL" "$_name" "${_kwargs[@]+"${_kwargs[@]}"}" || { _error "$_manager execute failed"; return $_E; }
  fi
  
  _log "✓ $_manager package installed: $_name"
  return 0
}

##@ common update flow
##: pkglib.common.update <manager> <name> <force> [--key=value...] -> pkglib.common.update brew docker true --cask
pkglib.common.update() {
  local _manager="$1" _name="$2" _force="$3"
  _pkglib.require_params "manager" "$_manager" "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 3
  
  local _kwargs=("$@")
  _pkglib.require_tool "$(_pkglib.manager_tool "$_manager")" || return $_E_DEP
  
  # Action
  _log "updating package - $_manager: $_name (force: $_force) with args: [$(_pkglib.get_args_display "$@")]"
  
  if [[ "$_force" == "true" ]]; then
    # Force update = reinstall/force update
    pkglib.${_manager}.execute "$_PKGLIB_ACTION_REUPDATE" "$_name" "${_kwargs[@]+"${_kwargs[@]}"}" || { _error "$_manager execute failed"; return $_E; }
  else
    # Regular update
    pkglib.${_manager}.execute "$_PKGLIB_ACTION_UPDATE" "$_name" "${_kwargs[@]+"${_kwargs[@]}"}" || { _error "$_manager execute failed"; return $_E; }
  fi
  
  _log "✓ $_manager package updated: $_name"
  return 0
}

##@ Can this manager ENUMERATE what it has installed, so `adopt` can reverse-sync it into a manifest?
##@ Optional capability, like has_dep_tier - not every handler can answer "what did you install?"
##@ (github/download/dmg/script place arbitrary artifacts; pkgman's own tracking is their only record).
##: pkglib.common.can_list_installed <manager> -> if pkglib.common.can_list_installed brew; then ...
pkglib.common.can_list_installed() {
  case "${1:-}" in
    brew|cask|mas|pipx|npm|apt|dnf) return 0 ;;
    *) return 1 ;;
  esac
}

##@ List TOP-LEVEL installed packages, one per line, as: name<TAB>source<TAB>desc (source/desc may be
##@ empty). TOP-LEVEL is the point: a manifest declares INTENT, so `adopt` must offer only what was
##@ deliberately installed, never the transitive dependency closure (on a real box that is 275 formulae
##@ vs 71 leaves). Dependencies belong to the upgrade-deps tier, not to the manifest.
##: pkglib.brew.list_installed -> jq
pkglib.brew.list_installed() {
  _pkglib.require_tool "brew" || return $_E_DEP
  # `leaves` = installed formulae nothing else depends on = what the user actually asked for
  brew leaves 2>/dev/null | while IFS= read -r _n; do [[ -n "$_n" ]] && printf '%s\t\t\n' "$_n"; done
  return 0
}

##: pkglib.cask.list_installed -> raycast<TAB>raycast
pkglib.cask.list_installed() {
  _pkglib.require_tool "brew" || return $_E_DEP
  # casks are always top-level (nothing depends on a cask); source= is the cask token itself
  brew list --cask 2>/dev/null | while IFS= read -r _n; do [[ -n "$_n" ]] && printf '%s\t%s\t\n' "$_n" "$_n"; done
  return 0
}

##: pkglib.mas.list_installed -> keynote<TAB>409183694<TAB>Keynote
pkglib.mas.list_installed() {
  _pkglib.require_tool "mas" || return $_E_DEP
  # `mas list` prints "<id>  <App Name>  (<version>)"; the name may contain spaces, so strip the
  # trailing "(version)" and take everything after the id. Row name = a slug of the app name.
  mas list 2>/dev/null | while IFS= read -r _line; do
    [[ -z "$_line" ]] && continue
    local _id _rest _nm _slug
    _id="$(printf '%s' "$_line" | awk '{print $1}')"
    [[ -z "$_id" ]] && continue
    _rest="${_line#*"$_id"}"
    _nm="$(printf '%s' "$_rest" | sed -e 's/[[:space:]]*([^()]*)[[:space:]]*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    _slug="$(printf '%s' "$_nm" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
    [[ -n "$_slug" ]] && printf '%s\t%s\t%s\n' "$_slug" "$_id" "$_nm"
  done
  return 0
}

##: pkglib.pipx.list_installed -> fastapi-clean-cli
pkglib.pipx.list_installed() {
  _pkglib.require_tool "pipx" || return $_E_DEP
  # `pipx list --short` prints "<pkg> <version>"; every pipx app is top-level by construction
  pipx list --short 2>/dev/null | while IFS= read -r _line; do
    local _n; _n="$(printf '%s' "$_line" | awk '{print $1}')"
    [[ -n "$_n" ]] && printf '%s\t\t\n' "$_n"
  done
  return 0
}

##: pkglib.npm.list_installed -> typescript
pkglib.npm.list_installed() {
  _pkglib.require_tool "npm" || return $_E_DEP
  # `npm ls -g --depth=0` prints a tree; take each "pkg@version" leaf and strip the LAST @ (scoped
  # names like @openai/codex legitimately start with one). npm itself is excluded - it is the manager.
  npm ls -g --depth=0 2>/dev/null | sed -n 's/^[^a-zA-Z@]*\([@a-zA-Z].*\)$/\1/p' | while IFS= read -r _spec; do
    [[ -z "$_spec" ]] && continue
    # Every real entry is "pkg@version"; the tree's first line is the lib ROOT PATH (no '@') - drop it.
    case "$_spec" in *@*) ;; *) continue ;; esac
    local _n="${_spec%@*}"
    [[ -z "$_n" || "$_n" == "npm" ]] && continue
    printf '%s\t\t\n' "$_n"
  done
  return 0
}

##: pkglib.apt.list_installed -> nginx
pkglib.apt.list_installed() {
  _pkglib.require_tool "apt-mark" || return $_E_DEP
  # showmanual = explicitly installed, excluding anything pulled in as a dependency
  apt-mark showmanual 2>/dev/null | while IFS= read -r _n; do [[ -n "$_n" ]] && printf '%s\t\t\n' "$_n"; done
  return 0
}

##: pkglib.dnf.list_installed -> nginx
pkglib.dnf.list_installed() {
  _pkglib.require_tool "dnf" || return $_E_DEP
  dnf repoquery --userinstalled --qf '%{name}\n' 2>/dev/null | while IFS= read -r _n; do [[ -n "$_n" ]] && printf '%s\t\t\n' "$_n"; done
  return 0
}

##@ Does this manager have a separate DEPENDENCY TIER - transitive packages it installs alongside what
##@ you asked for, which can go outdated and be upgraded INDEPENDENTLY? True only for the system package
##@ managers. The language managers (npm/pipx/cargo/go) vendor deps INSIDE the package, so upgrading the
##@ package already covers them; mas/cask/github/download/dmg/script install self-contained artifacts
##@ with no dependency tier at all. This is why upgrade-deps is an OPTIONAL capability rather than a 6th
##@ required operation: forcing all 13 handlers to implement it would be false symmetry.
##: pkglib.common.has_dep_tier <manager> -> if pkglib.common.has_dep_tier brew; then ...
pkglib.common.has_dep_tier() {
  case "${1:-}" in
    brew|apt|dnf) return 0 ;;
    *) return 1 ;;
  esac
}

##@ common uninstall flow
##: pkglib.common.uninstall <manager> <name> <force> [--key=value...] -> pkglib.common.uninstall brew docker false --cask
pkglib.common.uninstall() {
  local _manager="$1" _name="$2" _force="$3"
  _pkglib.require_params "manager" "$_manager" "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 3
  
  local _kwargs=("$@")
  _pkglib.require_tool "$(_pkglib.manager_tool "$_manager")" || return $_E_DEP
  
  # Action
  _log "uninstalling package - $_manager: $_name (force: $_force) with args: [$(_pkglib.get_args_display "$@")]"
  
  # Most package managers don't use kwargs for uninstall to avoid failures
  # Pass all kwargs to execute function for source parameter extraction
  pkglib.${_manager}.execute "$_PKGLIB_ACTION_UNINSTALL" "$_name" "${_kwargs[@]+"${_kwargs[@]}"}" || { _error "$_manager execute failed"; return $_E; }
  
  _log "✓ $_manager package uninstalled: $_name"
  return 0
}

##] common

##[ brew
##@ Validate brew package parameters before installation
##: pkglib.brew.validate <name> <force> [kwargs...] -> pkglib.brew.validate docker true --cask
pkglib.brew.validate() {
  local _name="$1" _force="$2"  # _name is package name
  _pkglib.require_params "package-name" "$_name" || return $?
  shift 2
  
  # Extract OS parameter if provided
  local _os
  _os=$(_pkglib.get_arg_maybe os "$@")
  
  # Brew is macOS only - check OS compatibility
  [[ -n "$_os" && "$_os" == "linux" ]] && { _error "brew packages cannot be installed on Linux"; return $_E_OS; }
  
  return 0
}

##@ brew command execution with kwargs handling
##: pkglib.brew.execute <action> <name> [kwargs...] -> pkglib.brew.execute install docker --cask
pkglib.brew.execute() {
  local _action="$1" _name="$2"
  _pkglib.require_params "action" "$_action" "package-name" "$_name" || return $?
  shift 2
  
  local _command _append_kwargs=true
  
  # Map pkglib actions to brew commands
  case "$_action" in
    "$_PKGLIB_ACTION_INSTALL")    _command="install" ;;
    "$_PKGLIB_ACTION_REINSTALL")  _command="reinstall" ;;
    "$_PKGLIB_ACTION_UPDATE")     _command="upgrade" ;;
    "$_PKGLIB_ACTION_REUPDATE")   _command="reinstall"; _append_kwargs=false ;;  # Force update = reinstall for brew
    "$_PKGLIB_ACTION_UNINSTALL")  _command="uninstall"; _append_kwargs=false ;;
    *) _error "unsupported action: $_action"; return $_E_USG ;;
  esac
  
  # Execute brew command with or without kwargs
  # Filter out pkgman-specific parameters
  local _filtered_kwargs
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  _filtered_kwargs=($(_pkglib.filter_kwargs "$@"))

  if [[ "$_append_kwargs" == "true" ]] && [[ ${#_filtered_kwargs[@]} -gt 0 ]]; then
    # shellcheck disable=SC2145  # legacy archive pattern, pre-loam
    _debug "brew $_command $_name ${_filtered_kwargs[@]}"
