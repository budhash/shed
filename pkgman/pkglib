  _os=$(_pkglib.get_arg_maybe os "$@")

  # DMG is macOS only - check OS compatibility
  [[ -n "$_os" && "$_os" == "linux" ]] && { _error "dmg packages cannot be installed on Linux"; return $_E_OS; }

  # Delegate to download validation
  pkglib.download.validate "$_name" "$_force" "$@"
}

