##[ go
##@ Go Manager - Module Path vs Binary Name Handling
##@
##@ IMPORTANT: The go manager has a unique architectural challenge:
##@ • INSTALL requires the full module path: go install golang.org/x/tools/cmd/goimports@latest
##@ • UNINSTALL requires the binary name: rm $GOBIN/goimports (manual binary removal)
##@ • STATUS checks require the binary name: test -f $GOBIN/goimports
##@
##@ This is different from other language managers:
##@ • cargo: cargo install/uninstall both use crate name (ripgrep)
##@ • pipx: pipx install/uninstall both use package name (black)  
##@ • npm: npm install/uninstall both use package name (prettier)
##@
##@ SOLUTION: Use --artifact parameter to specify binary name explicitly:
##@ pkgman add go goimports --source="golang.org/x/tools/cmd/goimports@latest" --artifact="goimports"
##@
##@ FALLBACK: If --artifact not provided, extract binary name from module path:
##@ golang.org/x/tools/cmd/goimports@latest → goimports (may not always be correct)
##@

##@ Extract binary name from go module path with artifact override
##: _pkglib.go.get_binary_name <module_path> [--artifact=name] -> binary_name
_pkglib.go.get_binary_name() {
  local _module_path="$1"
  shift
  
  # Extract artifact parameter
  local _artifact
  _artifact=$(_pkglib.get_arg_maybe artifact "$@")
  
  # Use artifact if provided, otherwise extract from module path
  if [[ -n "$_artifact" ]]; then
    echo "$_artifact"
  else
    # Fallback: extract from module path
    local _binary_name="${_module_path##*/}"
    _binary_name="${_binary_name%@*}"
    echo "$_binary_name"
  fi
}

##@ Validate go package parameters before installation
##: pkglib.go.validate <name> <force> [kwargs...] -> pkglib.go.validate "golang.org/x/tools/cmd/goimports@latest" "false" "--artifact=goimports"
pkglib.go.validate() {
  local _name="$1" _force="$2"  # _name is module path
  _pkglib.require_params "package-name" "$_name" || return $?
  shift 2
  
  # Extract artifact parameter
  local _artifact
  _artifact=$(_pkglib.get_arg_maybe artifact "$@")
  
  # If _name contains slashes (full module path), artifact is required
  if [[ "$_name" == *"/"* ]]; then
    [[ -z "$_artifact" ]] && { _error "--artifact required for full module paths: $_name"; return $_E_USG; }
  fi
  
  # Extract dest if provided to show warning
  local _dest
  _dest=$(_pkglib.get_arg_maybe dest "$@")
  
  # Warn if dest is set - go installs to $GOBIN or $GOPATH/bin by default
  [[ -n "$_dest" && "$_dest" != "default" ]] && _warn "go ignores --dest parameter, installs to \$GOBIN or \$GOPATH/bin (default: ~/go/bin)"
  
  return 0
}

##@ go command execution with kwargs handling
##: pkglib.go.execute <action> <name> [kwargs...] -> pkglib.go.execute install "golang.org/x/tools/cmd/goimports@latest" --artifact=goimports
pkglib.go.execute() {
  local _action="$1" _name="$2"
  _pkglib.require_params "action" "$_action" "package-name" "$_name" || return $?
  shift 2
  
  local _command _append_kwargs=true  # go supports build flags like -v, -a, -x
  
  # Use source directly from first parameter (module path)
  local _source="$_name"
  
  # Extract artifact (binary name) using helper
  local _binary_name
  _binary_name=$(_pkglib.go.get_binary_name "$_source" "$@") || return $?
  
  # Map pkglib actions to go commands
  case "$_action" in
    "$_PKGLIB_ACTION_INSTALL")    _command="install" ;;
    "$_PKGLIB_ACTION_REINSTALL")  _command="install" ;;
    "$_PKGLIB_ACTION_UPDATE")     _command="install" ;;
    "$_PKGLIB_ACTION_REUPDATE")   _command="install" ;;
    "$_PKGLIB_ACTION_UNINSTALL")  _command="uninstall" ;;
    *) _error "unsupported action: $_action"; return $_E_USG ;;
  esac
  
  # Execute go command with or without kwargs
  # Filter out pkgman-specific parameters
  local _filtered_kwargs
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  _filtered_kwargs=($(_pkglib.filter_kwargs "$@"))

  if [[ "$_command" == "uninstall" ]]; then
    # Go uninstall is manual - remove the binary (needs artifact/binary name)
    local _gobin="${GOBIN:-$(go env GOPATH)/bin}"
    local _binary_path="$_gobin/$_binary_name"

    [[ ! -f "$_binary_path" ]] && { _error "go binary not found: $_binary_path"; return $_E_NF; }

    _debug "rm -f $_binary_path"
    rm -f "$_binary_path" || { _error "go uninstall failed: $_name"; return $_E; }
  else
    # Handle force mode for install operations (needs artifact/binary name for cleanup)
    if [[ "$_action" == "$_PKGLIB_ACTION_REINSTALL" || "$_action" == "$_PKGLIB_ACTION_UPDATE" || "$_action" == "$_PKGLIB_ACTION_REUPDATE" ]]; then
      # Force reinstall by removing first, then installing
      local _gobin="${GOBIN:-$(go env GOPATH)/bin}"
      [[ -f "$_gobin/$_binary_name" ]] && rm -f "$_gobin/$_binary_name"
    fi

    # Install using source (module path) with optional kwargs
    if [[ "$_append_kwargs" == "true" ]] && [[ ${#_filtered_kwargs[@]} -gt 0 ]]; then
      # shellcheck disable=SC2145  # legacy archive pattern, pre-loam
      _debug "go $_command ${_filtered_kwargs[@]} $_source"
      go "$_command" "${_filtered_kwargs[@]}" "$_source" || { _error "go $_command failed: $_name"; return $_E; }
    else
      _debug "go $_command $_source"
      go "$_command" "$_source" || { _error "go $_command failed: $_name"; return $_E; }
    fi
  fi
  
  return 0
}

