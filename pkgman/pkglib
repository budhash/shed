##@ npm command execution with kwargs handling
##: pkglib.npm.execute <action> <name> [kwargs...] -> pkglib.npm.execute install prettier --version=3.0.0
pkglib.npm.execute() {
  local _action="$1" _name="$2"
  _pkglib.require_params "action" "$_action" "package-name" "$_name" || return $?
  shift 2
  
  local _kwargs=("$@")
  local _command _append_kwargs=false  # npm doesn't use our standard kwargs pattern
  
  # Use source directly from first parameter (npm package name)
  local _source="$_name"
  
  # Extract parameters
  local _version _npx
  _version=$(_pkglib.get_arg_maybe version "$@")
  _npx=$(_pkglib.get_arg_opt npx "false" "$@")
  
  # Map pkglib actions to npm commands
  case "$_action" in
    "$_PKGLIB_ACTION_INSTALL")    _command="install" ;;
    "$_PKGLIB_ACTION_REINSTALL")  _command="install" ;;
    "$_PKGLIB_ACTION_UPDATE")     _command="update" ;;
    "$_PKGLIB_ACTION_REUPDATE")   _command="install" ;;
    "$_PKGLIB_ACTION_UNINSTALL")  _command="uninstall" ;;
    *) _error "unsupported action: $_action"; return $_E_USG ;;
  esac
  
  if [[ "$_npx" == "true" ]]; then
    # npx execution mode - validate tool works
    case "$_action" in
      "$_PKGLIB_ACTION_INSTALL"|"$_PKGLIB_ACTION_REINSTALL")
        _debug "npx --yes $_source --version"
        npx --yes "$_source" --version &>/dev/null || { _error "npx validation failed: $_name"; return $_E; }
        ;;
      "$_PKGLIB_ACTION_UPDATE"|"$_PKGLIB_ACTION_REUPDATE")
        _debug "npx --yes $_source --version (update)"
        npx --yes "$_source" --version &>/dev/null || { _error "npx validation failed: $_name"; return $_E; }
        ;;
      "$_PKGLIB_ACTION_UNINSTALL")
        # For npx mode, uninstall clears npm cache
        _debug "npm cache clean --force"
        npm cache clean --force || { _error "npm cache clean failed: $_name"; return $_E; }
        ;;
    esac
  else
    # Default: Global installation mode
    local _package="$_source"
    [[ -n "$_version" ]] && _package="$_source@$_version"
    
    # Filter out npm-specific parameters and get clean kwargs for npm
    local _filtered_kwargs
    # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
    _filtered_kwargs=($(_pkglib.filter_kwargs --npx --version "$@"))

    # Execute npm command with filtered arguments
    if [[ ${#_filtered_kwargs[@]} -gt 0 ]]; then
      # shellcheck disable=SC2145  # legacy archive pattern, pre-loam
      _debug "npm $_command -g $_package ${_filtered_kwargs[@]}"
      npm "$_command" "-g" "$_package" "${_filtered_kwargs[@]}" || { _error "npm $_command failed: $_name"; return $_E; }
    else
      _debug "npm $_command -g $_package"
      npm "$_command" "-g" "$_package" || { _error "npm $_command failed: $_name"; return $_E; }
    fi
  fi
  
  return 0
}

