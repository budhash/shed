##@ Validate GitHub repository format (owner/repo)
##: _pkglib.validate_github_repo <repo> -> _pkglib.validate_github_repo "owner/repo"
_pkglib.validate_github_repo() {
  local _repo="$1"
  [[ -z "$_repo" ]] && { _error "repository required"; return $_E_USG; }
  
  # Check format: owner/repo (no spaces, slashes only as separator)
  if [[ ! "$_repo" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$ ]]; then
    _error "invalid repository format: '$_repo' (expected: owner/repo)"
    return $_E_USG
  fi
  
  # Ensure no multiple slashes
  if [[ "$_repo" == *"//"* || "$_repo" == *"/"*"/"* ]]; then
    _error "invalid repository format: '$_repo' (contains multiple slashes)"
    return $_E_USG
  fi
}

##@ Internal helper: Fetch GitHub release download URL
##: _pkglib.github.get_download_url <repo> <selector> -> outputs download URL
_pkglib.github.get_download_url() {
  local _repo="$1" _selector="$2"
  _pkglib.require_params "repo" "$_repo" "selector" "$_selector" || return $?
  
  _log "fetching github release: $_repo"
  
  # Get latest release info
  local _api_url="$_PKGLIB_GITHUB_API_BASE/repos/$_repo/releases/latest"
  local _release_data
  _release_data=$(curl -s "$_api_url") || { _error "github API request failed: $_repo"; return $_E; }
  
  # Extract download URL matching selector pattern
  local _download_url
  local _regex_pattern
  _regex_pattern=$(_pkglib.convert_glob_to_regex "$_selector")
  
  _download_url=$(echo "$_release_data" | grep "\"browser_download_url\"" | grep "$_regex_pattern" | sed 's/.*"browser_download_url": *"\([^"]*\)".*/\1/' | head -1)
  
  [[ -z "$_download_url" ]] && { _error "github asset not found: selector '$_selector' in $_repo"; return $_E; }
  
  _log "found github asset: $_download_url"
  echo "$_download_url"
}

##@ Internal helper: Core download handling for both GitHub and Download managers
##: _pkglib.download.core <url> <dest> <selector> <checksum> <artifact> <extract> <exec> <force> -> unified download handling
_pkglib.download.core() {
  local _url="$1" _dest="$2" _selector="$3" _checksum="$4" _artifact="$5" _extract="$6" _exec="$7" _force="$8"
  
  _log "downloading $_url to $_dest (extract: $_extract, force: $_force)"
  
  # Build loam.smart-download arguments
  local _args=()
  
  # Handle extraction
  [[ "$_extract" == "true" ]] && _args+=(-e)
  # Add optional parameters
  [[ -n "$_selector" ]] && _args+=(-s "$_selector")
  [[ -n "$_checksum" ]] && _args+=(-c "$_checksum")
  [[ "$_exec" == "true" ]] && _args+=(-x "$_artifact")
  [[ "$_force" == "true" ]] && _args+=(-f)
  
  # Execute download
  if [[ ${#_args[@]} -gt 0 ]]; then
    _debug "loam.smart-download args: [${_args[*]}] url: $_url dest: $_dest"
    loam.smart-download "${_args[@]}" "$_url" "$_dest" || { _error "download failed: $_url"; return $_E; }
  else
    _debug "loam.smart-download (no flags) url: $_url dest: $_dest"
    loam.smart-download "$_url" "$_dest" || { _error "download failed: $_url"; return $_E; }
  fi
  
  return 0
}

##@ github installation - resolves GitHub URL then delegates to download
##: pkglib.github.install <name> <force> [--key=value...] -> pkglib.github.install obsidian true --source="obsidianmd/obsidian-releases" --selector="*.dmg" --dest=/Applications --artifact=Obsidian.app
pkglib.github.install() {
  local _name="$1" _force="$2"
  _pkglib.require_params "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 2
  
  # Use source directly from first parameter (GitHub repo)
  local _source="$_name" _selector
  _selector=$(_pkglib.get_arg_opt selector "*" "$@")
  
  # Validate GitHub repository format
  _pkglib.validate_github_repo "$_source" || return $?
  
  # Resolve GitHub release URL
  local _download_url
  _download_url=$(_pkglib.github.get_download_url "$_source" "$_selector") || return $?
  
  # Build new kwargs array with resolved URL and github defaults
  local _download_kwargs=()
  local _arg
  for _arg in "$@"; do
    case "$_arg" in
      --source=*|--selector=*) 
        # Skip original github-specific parameters
        ;;
      *)
        # Keep all other arguments
        _download_kwargs+=("$_arg")
        ;;
    esac
  done
  
  # Add resolved URL as source and default extract=true
  _download_kwargs+=("--source=$_download_url" "--extract=true")
  
  # Delegate to download manager with resolved URL as first parameter
  pkglib.download.install "$_download_url" "$_force" "${_download_kwargs[@]}"
}

