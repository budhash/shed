##[ download
##@ Validate download package parameters before installation
##: pkglib.download.validate <name> <force> [kwargs...] -> pkglib.download.validate "https://raw.../zap-sh" "false" "--dest=/usr/local/bin" "--artifact=zap-sh"
pkglib.download.validate() {
  local _name="$1" _force="$2"  # _name is download URL
  _pkglib.require_params "package-name" "$_name" || return $?
  shift 2
  
  # Extract required parameters from kwargs
  local _dest _artifact
  _dest=$(_pkglib.get_arg_rqd dest "$@") || return $?
  _artifact=$(_pkglib.get_arg_rqd artifact "$@") || return $?
  
  # Validate source URL format
  _pkglib.validate_url "$_name" || return $?
  
  # Validate destination directory
  [[ ! -d "$_dest" ]] && { _warn "destination directory does not exist: $_dest (will be created during installation)"; }
  
  return 0
}

##@ download installation
##: pkglib.download.install <name> <force> [--key=value...] -> pkglib.download.install zap-sh true --source="https://raw.../zap-sh" --dest=/shed/core/bin --extract=false --exec=true --artifact=zap-sh
pkglib.download.install() {
  local _name="$1" _force="$2"
  _pkglib.require_params "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 2
  
  # Use source directly from first parameter (URL)
  local _source="$_name" _dest _selector _checksum _artifact _extract
  _dest=$(_pkglib.get_arg_opt dest "." "$@")
  _selector=$(_pkglib.get_arg_maybe selector "$@")
  _checksum=$(_pkglib.get_arg_maybe checksum "$@")
  _artifact=$(_pkglib.get_arg_maybe artifact "$@")
  _extract=$(_pkglib.get_arg_opt extract "false" "$@")
  _exec=$(_pkglib.get_arg_opt exec "false" "$@")
  
  # Validate
  _pkglib.validate_url "$_source" || return $?
  
  # Action
  _log "installing package - download: $_name (force: $_force) with args: [$(_pkglib.get_args_display "$@")]"
  
  # Use unified core download handler
  _pkglib.download.core "$_source" "$_dest" "$_selector" "$_checksum" "$_artifact" "$_extract" "$_exec" "$_force" || return $?
  
  _log "✓ download package installed: $_name"
  return 0
}

##@ download update - uninstall + install
##: pkglib.download.update <name> <force> [--key=value...] -> pkglib.download.update zap-sh true --source="https://raw.../zap-sh" --dest=/shed/core/bin --extract=false --exec=true --artifact=zap-sh
pkglib.download.update() {
  pkglib.download.uninstall "$@" && pkglib.download.install "$@"
}

##@ download uninstallation
##: pkglib.download.uninstall <name> <force> [--key=value...] -> pkglib.download.uninstall zap-sh false --dest=/shed/core/bin --artifact=zap-sh
pkglib.download.uninstall() {
  local _name="$1" _force="$2"
  _pkglib.require_params "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 2
  
  # Extract
  local _dest _artifact
  _dest=$(_pkglib.get_arg_opt dest "." "$@")
  _artifact=$(_pkglib.get_arg_rqd artifact "$@") || return $?
  
  # Action
  _log "uninstalling package - download: $_name (force: $_force) with args: [$(_pkglib.get_args_display "$@")]"
  
  # Use explicit artifact (exact match only)
  local _target="$_dest/$_artifact"
  
  [[ -f "$_target" ]] || [[ -d "$_target" ]] || { _warn "file not found: $_target"; return $_E_NF; }
  
  # Use loam.trash for safe removal
  loam.trash "$_target" || { _error "failed to move to trash: $_target"; return $_E; }
  _log "✓ download package uninstalled: $_name"
  return 0
}

##@ download status
##: pkglib.download.status <name> <force> [--key=value...] -> status=$(pkglib.download.status zap-sh false --dest=/shed/core/bin --artifact=zap-sh)
pkglib.download.status() {
  local _name="$1" _force="$2"
  _pkglib.require_params "package-name" "$_name" "force-flag" "$_force" || return $?
  shift 2
  
  # Extract
  local _dest _artifact
  _dest=$(_pkglib.get_arg_opt dest "." "$@")
  _artifact=$(_pkglib.get_arg_maybe artifact "$@")
  
  # Action
  # Determine target path - use artifact if provided, otherwise use name
  local _target=""
  if [[ -n "$_artifact" ]]; then
    _target="$_dest/$_artifact"
  else
    _target="$_dest/$_name"
  fi

  if [[ -f "$_target" || -d "$_target" ]]; then
    echo "$_PKGLIB_STATUS_INSTALLED"
  else
    echo "$_PKGLIB_STATUS_MISSING"
  fi
  return 0
}
##] download

##[ script
##@ Validate script package parameters before installation
##: pkglib.script.validate <name> <force> [kwargs...] -> pkglib.script.validate "pkgboot" "false" --artifact=cargo
pkglib.script.validate() {
  local _name="$1" _force="$2"  # _name is source path (could be relative like "pkgboot")
  _pkglib.require_params "source-path" "$_name" || return $?
  
  # Resolve the source path (handles both absolute paths and relative resolution)
  local _resolved_path
  _resolved_path=$(_pkglib.resolve_source_path "$_name") || return $?
  
  # Validate resolved script is executable
  _pkglib.ensure_executable "$_resolved_path" || return $?
  return 0
}

##@ script command execution with kwargs handling
##: pkglib.script.execute <action> <name> <force> [kwargs...] -> pkglib.script.execute install "pkgboot" "true" --artifact=cargo-manager
pkglib.script.execute() {
  local _action="$1" _name="$2" _force="$3"
  _pkglib.require_params "action" "$_action" "source-path" "$_name" "force-flag" "$_force" || return $?
  shift 3
  
  # Resolve the source path (handles both absolute paths and relative resolution)
  local _resolved_source
  _resolved_source=$(_pkglib.resolve_source_path "$_name") || return $?
  
  # Validate resolved script is executable
  _pkglib.ensure_executable "$_resolved_source" || return $?
  
  # Action logging
  _log "${_action}ing package - script: $_name with args: [$(_pkglib.get_args_display "$@")]"
  
  # Build script arguments: action, force flag, plus all kwargs
  local _exec_args=("$_action" "$_force")
  _exec_args+=("$@")  # Pass all remaining kwargs to the script
  
  # Execute the resolved script with CLI arguments
  # shellcheck disable=SC2145  # legacy archive pattern, pre-loam
  _debug "$_resolved_source ${_exec_args[@]}"
  "$_resolved_source" "${_exec_args[@]}"
  local _exit_code=$?
  _debug "script exit code: $_exit_code"
  return $_exit_code
}

##@ script installation
##: pkglib.script.install <name> <force> [--key=value...] -> pkglib.script.install myapp true --source=/path/to/script.sh --dest=/usr/local/bin --artifact=myapp-cli
pkglib.script.install() {
  local _name="$1" _force="$2" _exit_code
  shift 2  # Remove name and force, keep only kwargs
  if pkglib.script.execute "$_PKGLIB_ACTION_INSTALL" "$_name" "$_force" "$@"; then
    _log "✓ script installed: $_name"
    return 0
  else
    _exit_code=$?
    _error "script installation failed: $_name"
    return $_exit_code
  fi
}

