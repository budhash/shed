#!/usr/bin/env bash
##( header
# --------------------------------------------------------------------
# pkgman - Universal package manager CLI
#
# Stateful wrapper for pkglib providing auto-detection, state management,
# and simplified package operations across different package managers.
# Tracks installations in configuration files and provides convenience
# commands for day-to-day package management.
# --------------------------------------------------------------------
# AUTHOR: Budha <budhash@gmail.com>
# VERSION: 1.0.0
# LICENSE: MIT License
# --------------------------------------------------------------------
# __TEMPLATE__: https://github.com/budhash/zap-sh/blob/main/templates/basic.sh
# __ID__: basic-1.0.0
# --------------------------------------------------------------------
##) header
# shellcheck disable=SC1090 # pkglib is sourced from a runtime-resolved path (same-dir first, then legacy/env fallbacks); location can't be known statically. verified live by tests.sh
##( configuration
set -eEuo pipefail; IFS=$'\n\t'  # fail fast, secure IFS
##) configuration
##( metadata
readonly __SOURCE="${BASH_SOURCE[0]:-}"
readonly __PIPED=$([[ -t 0 || -n "$__SOURCE" ]] && echo false || echo true)
readonly __APP="$(basename "${__SOURCE:-$0}")"
readonly __APPFILE="$__SOURCE"
if [[ -n "$__SOURCE" ]]; then
  readonly __APPDIR="$(s="$__SOURCE"; while [[ -h "$s" ]]; do
    d="$(cd -P "$(dirname "$s")" && pwd)"; s="$(readlink "$s")"; [[ "$s" != /* ]] && s="$d/$s"; done; cd -P "$(dirname "$s")" && pwd)"
else
  readonly __APPDIR="$(pwd)"
fi
__DBG=${DEBUG:-false}
##) metadata
##( globals

##[ colors
_RST=$'\033[0m' _GRN=$'\033[0;32m' _YLW=$'\033[0;33m' _RED=$'\033[0;31m' _BLU=$'\033[0;34m'
[[ -n "${NO_COLOR:-}" || ! -t 1 ]] && _RST='' _GRN='' _YLW='' _RED='' _BLU=''
##] colors

##[ error
# general failure / bad usage / dependency not found / unsupported OS / not found / permission error / not connected / piped mode
_E=1 _E_USG=2 _E_DEP=3 _E_OS=4 _E_NF=5 _E_NP=6 _E_NC=7 _E_PIPE=8
##] error

##) globals
##( helpers

##[ system
u.os() { case "${OSTYPE:-}" in darwin*) echo mac;; linux*) echo linux;; *) echo unknown;; esac; }
u.die() { u.error "$@"; exit $_E; }
u.require() {
  local tool="${1:-}"
  [[ -z "$tool" ]] && { u.error "missing dependency name"; exit $_E_DEP; }
  if [[ "$tool" == /* ]] || [[ "$tool" == ./* ]] || [[ "$tool" == ../* ]]; then
    [[ -x "$tool" ]] || { u.error "missing dependency: $tool"; exit $_E_DEP; } # Absolute or relative path - test directly
  else
    command -v "$tool" >/dev/null || { u.error "missing dependency: $tool"; exit $_E_DEP; }
  fi
}
##] system

##[ logging
u.log() {
  local _l="info " _co="$_GRN"
  [[ "${1:-}" == "-l" ]] && { _l="${2:-info}"; shift 2; }
  case "$_l" in warn) _co="$_YLW";; error) _co="$_RED";; debug) _co="$_BLU"; [[ "$__DBG" != true ]] && return;; esac
  printf "${_co}[%s]${_RST} %s\n" "$_l" "$*" >&2
  return 0
}
u.info() { u.log -l "info " "$@"; }
u.warn() { u.log -l "warn " "$@"; }
u.error() { u.log -l "error" "$@"; }
u.debug() { u.log -l "debug" "$@"; }
##] logging

##) helpers
##( app

##[ config
readonly __NAME=pkgman
readonly __OS=(mac linux)
readonly __APP_DEPS=(find)
readonly __ALLOW_PIPED=false  # Package manager should not run in piped mode
##] config

##[ constants
# Configuration file paths
readonly PKGMAN_CONFIG_DIR="${PKGMAN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pkgman}"
readonly PKGMAN_INDEX_DIR="$PKGMAN_CONFIG_DIR/index"
readonly PKGMAN_RESOLVED_FILE="$PKGMAN_CONFIG_DIR/.resolved.cfg"
readonly PKGMAN_STATUS_FILE="$PKGMAN_CONFIG_DIR/status.cfg"

# Supported package managers with required operations
readonly PKGMAN_MANAGERS=(brew apt dnf github download mas script cargo go pipx npm)
readonly PKGMAN_OPERATIONS=(validate install update uninstall status)

# Core metadata fields (excluded from kwargs extraction)
readonly PKGMAN_CORE_METADATA=(manager source dest artifact channel scope os sudo detail)

# Scope constants
readonly PKGMAN_SCOPE_CORE="core"
readonly PKGMAN_SCOPE_SYSTEM="system" 
readonly PKGMAN_SCOPE_MANAGER="manager"
readonly PKGMAN_DEFAULT_SCOPE="$PKGMAN_SCOPE_CORE"

# Global flags
_DRY_RUN=false
_NO_TRACK=false

# Status constants
readonly _PKGMAN_STATUS_INSTALLED="installed"
readonly _PKGMAN_STATUS_MISSING="missing"
readonly _PKGMAN_STATUS_UNKNOWN="unknown"

# Install method constants
readonly _PKGMAN_INSTALL_METHOD_MANUAL="manual"
readonly _PKGMAN_INSTALL_METHOD_PKGMAN="pkgman"

# Status field keys
readonly _PKGMAN_FIELD_STATUS="status"
readonly _PKGMAN_FIELD_INSTALL_METHOD="install_method" 
readonly _PKGMAN_FIELD_INSTALLED_AT="installed_at"
readonly _PKGMAN_FIELD_LAST_CHECKED="last_checked"

# Magic strings
readonly _PKGMAN_ERROR_MSG_ADD_TO_TRACK="use 'pkgman add' to track existing packages"
##] constants

##[ functions
_main() {
  # Parse global flags first
  local _args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--dry-run)
        _DRY_RUN=true
        _NO_TRACK=true
        shift
        ;;
      --dry-run=*)
        local _dry_val="${1#*=}"
        _DRY_RUN=true
        case "$_dry_val" in
          cmd) _NO_TRACK=false ;;
          *) _NO_TRACK=true ;;
        esac
        shift
        ;;
      --no-track)
        _NO_TRACK=true
        shift
        ;;
      -h|--help) _help; exit 0 ;;
      -v|--version) _version; exit 0 ;;
      *) _args+=("$1"); shift ;;
    esac
  done
  set -- "${_args[@]:-}"
  
  # Show dry-run notice
  if [[ "$_DRY_RUN" == "true" ]]; then
    if [[ "$_NO_TRACK" == "false" ]]; then
      u.info "DRY RUN MODE (cmd-only) - package operations skipped, state changes applied"
    else
      u.info "DRY RUN MODE - no changes will be made"
    fi
  fi
  
  # Show no-track notice
  if [[ "$_NO_TRACK" == "true" ]]; then
    u.info "NO TRACK MODE - state tracking disabled"
  fi
  
  # Load pkglib library
  _load_pkglib
  
  # Parse command and arguments
  local _command="${1:-}"
  [[ -z "$_command" ]] && { _help; exit $_E_USG; }
  shift
  
  # Route to appropriate handler
  case "$_command" in
    # Package operations
    add) _cmd_add "$@" ;;
    install) _cmd_install "$@" ;;
    update) _cmd_update "$@" ;;
    uninstall) _cmd_uninstall "$@" ;;
    remove) _cmd_remove "$@" ;;
    status) _cmd_status "$@" ;;
    info) _cmd_status "$@" ;;
    sync) _cmd_sync "$@" ;;
    # Batch operations
    install-all) _cmd_install_all "$@" ;;
    sync-all) _cmd_sync_all "$@" ;;
    update-all) _cmd_update_all "$@" ;;
    list-all) _cmd_list_all "$@" ;;
    list) _cmd_list_all "$@" ;;  # Backward compatibility alias
    list-packages) _cmd_list_packages "$@" ;;
    list-scopes) _cmd_list_scopes "$@" ;;
    # System operations
    provision) _cmd_provision "$@" ;;
    provision-all) _cmd_provision "all" "$@" ;;  # Helper alias for provision all
    # System
    help) _help; exit 0 ;;
    version) _version; exit 0 ;;
    *) u.error "unknown command: $_command"; _help; exit $_E_USG ;;
  esac
}

##@ Validate that all required pkglib functions exist for supported managers
##@ Checks that pkglib.{manager}.{operation} functions are available
##@ Exits with dependency error if any required functions are missing
_validate_pkglib_consistency() {
  local _manager _operation _function_name
  local _missing_functions=()
  
  # Check each manager/operation combination
  for _manager in "${PKGMAN_MANAGERS[@]:-}"; do
    for _operation in "${PKGMAN_OPERATIONS[@]:-}"; do
      _function_name="pkglib.${_manager}.${_operation}"
      if ! declare -f "$_function_name" >/dev/null 2>&1; then
        _missing_functions+=("$_function_name")
      fi
    done
  done
  
  # Report any missing functions
  if [[ ${#_missing_functions[@]} -gt 0 ]]; then
    u.error "pkglib consistency check failed - missing functions:"
    local _func
    for _func in "${_missing_functions[@]:-}"; do
      u.error "  $_func"
    done
    u.error "ensure pkglib library is properly loaded and up to date"
    exit $_E_DEP
  fi
  
  u.debug "pkglib consistency check passed - all ${#PKGMAN_MANAGERS[@]} managers with ${#PKGMAN_OPERATIONS[@]} operations validated"
}

##@ Load pkglib library with path discovery and validation
##@ Searches multiple locations for the pkglib library and loads it
##@ Exits with dependency error if library cannot be found or loaded
_load_pkglib() {
  # Find and load pkglib library
  local _pkglib_path=""
  
  # Check same-dir first (shed layout: pkgman/pkglib live side by side)
  if [[ -f "$__APPDIR/pkglib" ]]; then
    _pkglib_path="$__APPDIR/pkglib"
  # Check relative to this script's directory (legacy layout)
  elif [[ -f "$__APPDIR/../lib/pkglib" ]]; then
    _pkglib_path="$__APPDIR/../lib/pkglib"
  # Check in SHED_CORE if available
  elif [[ -n "${SHED_CORE:-}" && -f "$SHED_CORE/lib/pkglib" ]]; then
    _pkglib_path="$SHED_CORE/lib/pkglib"
  # Check standard locations
  elif [[ -f "$HOME/.local/lib/pkglib" ]]; then
    _pkglib_path="$HOME/.local/lib/pkglib"
  else
    u.error "pkglib library not found"
    u.error "Expected locations: $__APPDIR/pkglib, $__APPDIR/../lib/pkglib, \$SHED_CORE/lib/pkglib, ~/.local/lib/pkglib"
    exit $_E_DEP
  fi
  
  u.debug "loading pkglib from: $_pkglib_path"
  source "$_pkglib_path" || { u.error "failed to load pkglib library"; exit $_E_DEP; }
  
  # Validate pkglib consistency
  _validate_pkglib_consistency
}

##@ State management functions for package configuration files
##@ Returns path to resolved packages configuration file (merged from scope files)
_get_packages_file() { 
  # Ensure index directory exists
  [[ ! -d "$PKGMAN_INDEX_DIR" ]] && mkdir -p "$PKGMAN_INDEX_DIR"
  
  # Create resolved file by merging all scope files
  # shellcheck disable=SC2188  # intentional: truncate resolved-cfg file, no command needed
  > "$PKGMAN_RESOLVED_FILE"  # Clear resolved file
  
  # Merge all scope files from index directory (if any exist)
  local _scope_file
  for _scope_file in "$PKGMAN_INDEX_DIR"/package.*.cfg; do
    [[ -f "$_scope_file" ]] && cat "$_scope_file" >> "$PKGMAN_RESOLVED_FILE"
  done
  
  echo "$PKGMAN_RESOLVED_FILE"
}
##@ Returns path to status configuration file
_get_status_file() { echo "$PKGMAN_STATUS_FILE"; }
##@ Returns path to configuration directory
_get_config_dir() { echo "$PKGMAN_CONFIG_DIR"; }

##@ Dry-run helper functions for safe testing and validation
##@ Shows dry-run message and returns success to skip actual command execution
_dry() { [[ "$_DRY_RUN" == "true" ]] && { u.info "[DRY RUN] $*"; return 0; }; return 1; }
##@ Determines if state updates should be performed based on tracking settings
_should_update_state() { [[ "$_NO_TRACK" == "false" ]]; return $?; }

##@ Normalize manager aliases and validate manager is supported
##@ Returns normalized manager name or exits with error
##@ Usage: _manager=$(_normalize_and_validate_manager "$_manager") || return $?
_normalize_and_validate_manager() {
  local _manager="$1"
  # Normalize aliases
  case "$_manager" in
    ghub) _manager="github" ;;
    dnld) _manager="download" ;;
  esac
  # Validate against supported managers array
  local _m
  for _m in "${PKGMAN_MANAGERS[@]:-}"; do
    [[ "$_manager" == "$_m" ]] && { echo "$_manager"; return 0; }
  done
  u.error "unsupported manager: $_manager"
  return $_E_USG
}

##@ Validate scope name format and characters
##@ Returns success if scope is valid, error otherwise
##@ Usage: _validate_scope "$_scope" || return $?
_validate_scope() {
  local _scope="$1"
  [[ -z "$_scope" ]] && { u.error "scope name required"; return $_E_USG; }
  
  # Check for alphanumeric only (no spaces, special chars)
  if [[ ! "$_scope" =~ ^[a-zA-Z0-9]+$ ]]; then
    u.error "invalid scope name: '$_scope' (alphanumeric only, no spaces)"
    return $_E_USG
  fi
  
  return 0
}

##@ Validate OS parameter
##@ Returns success if OS is valid, error otherwise
##@ Usage: _validate_os "$_os" || return $?
_validate_os() {
  local _os="$1"
  [[ -z "$_os" ]] && { u.error "OS parameter required"; return $_E_USG; }
  
  # Check for valid OS values
  case "$_os" in
    default|mac|linux) return 0 ;;
    *) u.error "invalid OS: '$_os' (valid options: default, mac, linux)"; return $_E_USG ;;
  esac
}

##@ Validate sudo parameter
##@ Returns success if sudo is valid, error otherwise
##@ Usage: _validate_sudo "$_sudo" || return $?
_validate_sudo() {
  local _sudo="$1"
  [[ -z "$_sudo" ]] && { u.error "sudo parameter required"; return $_E_USG; }
  
  # Check for valid sudo values
  case "$_sudo" in
    true|false) return 0 ;;
    *) u.error "invalid sudo value: '$_sudo' (valid options: true, false)"; return $_E_USG ;;
  esac
}

##@ Check OS compatibility for package
##@ Returns success if package can be installed on current OS, warns and returns error if not
##@ Usage: _validate_os_compatibility "$_package" "$_os" || return $?
_validate_os_compatibility() {
  local _package="$1" _os="$2"
  [[ -z "$_package" ]] && { u.error "package name required"; return $_E_USG; }
  [[ -z "$_os" ]] && { u.error "OS parameter required"; return $_E_USG; }
  
  # If OS is default, compatible with any OS
  [[ "$_os" == "default" ]] && return 0
  
  # Get current OS
  local _current_os
  case "$(uname)" in
    Darwin) _current_os="mac" ;;
    Linux) _current_os="linux" ;;
    *) _current_os="unknown" ;;
  esac
  
  # Check compatibility
  if [[ "$_os" != "$_current_os" ]]; then
    u.warn "package '$_package' is marked for OS '$_os' but current OS is '$_current_os'"
    u.error "cannot install incompatible package - use --force to override"
    return $_E_OS
  fi
  
  return 0
}

##@ Parse force flag from arguments with unknown option handling
##@ Usage: _parse_force_flag "$@" -> sets _force variable and skips unknown options
_parse_force_flag() {
  _force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) _force=true; shift ;;
      *) shift ;;  # Skip unknown options instead of erroring
    esac
  done
  return 0
}

##@ Build force flags array based on _force variable
##@ Usage: _flags=($(_build_force_flags)) -> returns --force if _force is true, empty otherwise
_build_force_flags() {
  [[ "$_force" == "true" ]] && echo "--force"
}

##@ Validate that package is tracked, show consistent error if not
##@ Usage: _validate_package_tracked "$_package" || return $?
_validate_package_tracked() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || u.die "package name required for validation"
  
  if ! _is_tracked "$_package"; then
    u.error "package not tracked: $_package - $_PKGMAN_ERROR_MSG_ADD_TO_TRACK"
    return $_E_NF
  fi
  return 0
}

##@ Check if packages file exists, return silently if not (for internal functions)
##@ Usage: _ensure_packages_file_exists || return $?
_ensure_packages_file_exists() {
  local _packages_file="$(_get_packages_file)"
  [[ -f "$_packages_file" ]] && return 0
  return 1
}

##@ Check if packages file exists, show user message if not (for user commands)
##@ Usage: _ensure_packages_file_exists_user_msg "$message" || return $?
_ensure_packages_file_exists_user_msg() {
  local _message="${1:-no packages tracked}"
  local _packages_file="$(_get_packages_file)"
  if [[ ! -f "$_packages_file" ]]; then
    u.info "$_message"
    return 1
  fi
  return 0
}

##@ Get package status with fallback to unknown
##@ Usage: _status=$(_get_package_status "$_package") -> returns current status or "unknown" if not found
_get_package_status() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  local _status
  _status=$(_get_status "$_package" "$_PKGMAN_FIELD_STATUS" 2>/dev/null) || _status="$_PKGMAN_STATUS_UNKNOWN"
  echo "$_status"
}

##@ Escape package name for safe use in regex patterns
##@ Escapes special regex characters to prevent grep pattern injection
_escape_package_name() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  printf '%s\n' "$_package" | sed 's/[[]\*^$()+?{|]/\\&/g'
}

##@ Check if a metadata key is a core metadata field
##@ Usage: _is_core_metadata_field "manager" -> returns 0 if core metadata, 1 if not
_is_core_metadata_field() {
  local _field="${1#*.}"  # Remove package prefix
  local _core_field
  for _core_field in "${PKGMAN_CORE_METADATA[@]:-}"; do
    [[ "$_field" == "$_core_field" ]] && return 0
  done
  return 1
}

##@ Extract package-specific configuration parameters (kwargs) from packages file
##@ Returns --key=value arguments for pkglib functions via stdout
##@ Usage: _kwargs=($(_get_package_config "$_package"))
_get_package_config() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  local _packages_file="$(_get_packages_file)"
  _ensure_packages_file_exists || return 0
  
  local _escaped_package
  _escaped_package=$(_escape_package_name "$_package") || return $?
  
  # Extract all package.key=value entries except core metadata
  while IFS='=' read -r _key _value; do
    if _is_core_metadata_field "$_key"; then
      # Skip core metadata fields
      continue
    else
      # shellcheck disable=SC2295  # legacy archive pattern, pre-loam; \$_package has no glob metacharacters in practice
      local _kwarg_key="${_key#$_package.}"
      if [[ "$_kwarg_key" != "$_key" ]]; then
        printf '%s\n' "--$_kwarg_key=$_value"
      fi
    fi
  done < <(grep "^${_escaped_package}\\." "$_packages_file" 2>/dev/null | cut -d'=' -f1,2-)
}

##@ Unified package manager dispatcher
##@ Calls appropriate pkglib function with consistent error handling
##@ Maps unified metadata to pkglib function parameters
_call_pkglib() {
  local _manager="$1" _operation="$2" _package="$3"
  shift 3
  local _flags=("$@")
  
  # Normalize and validate manager
  _manager=$(_normalize_and_validate_manager "$_manager") || return $?
  
  # All managers use <source> <force> [kwargs...] signature
  local _force="false"
  local _i=0
  local _kwargs=()
  
  # Extract force flag from flags array
  while [[ $_i -lt ${#_flags[@]} ]]; do
    if [[ "${_flags[$_i]:-}" == "--force" ]]; then
      _force="true"
    fi
    _i=$((_i + 1))
  done
  
  # Build complete kwargs array: core parameters + manager-specific kwargs
  local _kwargs=()
  
  # Add core parameters if not default (required by pkglib interface)
  local _source _dest _artifact _sudo
  _source=$(_get_metadata "$_package" "source")
  _dest=$(_get_metadata "$_package" "dest") 
  _artifact=$(_get_metadata "$_package" "artifact")
  _sudo=$(_get_metadata "$_package" "sudo")
  
  # Note: _source is passed as first parameter, no need for --source kwarg
  [[ "$_dest" != "default" && -n "$_dest" ]] && _kwargs+=("--dest=$_dest")
  [[ "$_artifact" != "default" && -n "$_artifact" ]] && _kwargs+=("--artifact=$_artifact")
  [[ "$_sudo" == "true" ]] && _kwargs+=("--sudo=true")
  
  # Add manager-specific kwargs from metadata
  while IFS= read -r _kwarg; do
    [[ -n "$_kwarg" ]] && _kwargs+=("$_kwarg")
  done < <(_get_package_config "$_package")
  
  # Auto-inject pkgman path for script managers to enable dogfooding
  if [[ "$_manager" == "script" ]]; then
    _kwargs+=(--pkgman="$(realpath "$__APPFILE")")
  fi
  
  u.debug "_call_pkglib - manager=$_manager, operation=$_operation, package=$_package, source=$_source,  force=$_force, kwargs=${_kwargs[*]:-none}"
  
  "pkglib.${_manager}.${_operation}" "$_source" "$_force" "${_kwargs[@]:-}" || return $?
}

##@ Atomic config file update helper
##@ Performs safe key-value updates with proper escaping and temp file handling
_update_config_file() {
  local _file="$1" _key="$2" _value="$3"
  _pkglib.require_params "config file path" "$_file" "config key" "$_key" "config value" "$_value" || return $?
  
  # Skip state updates if not appropriate
  _should_update_state || return 0
  local _config_dir="$(dirname "$_file")"
  [[ ! -d "$_config_dir" ]] && mkdir -p "$_config_dir"
  [[ ! -f "$_file" ]] && touch "$_file"
  
  local _temp_file="$(mktemp)"
  
  # Ensure cleanup on exit/interrupt
  _cleanup_temp() { [[ -f "$_temp_file" ]] && rm -f "$_temp_file"; }
  trap _cleanup_temp EXIT INT TERM
  
  local _escaped_key
  _escaped_key=$(_escape_package_name "$_key") || { _cleanup_temp; return $?; }
  
  # Remove existing entry and add new one
  grep -v "^${_escaped_key}=" "$_file" 2>/dev/null > "$_temp_file" || true
  echo "${_key}=${_value}" >> "$_temp_file"
  
  # Atomic update
  if mv "$_temp_file" "$_file"; then
    trap - EXIT INT TERM  # Success - disable cleanup trap
    return 0
  else
    u.error "failed to update config file: $_file"
    _cleanup_temp
    return $_E
  fi
}

##@ Check if package is tracked and get its current status
##@ Returns: 0=not_tracked, 1=tracked_installed, 2=tracked_not_installed
_get_package_tracking_state() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  if ! _is_tracked "$_package"; then
    echo "not_tracked"
    return 0
  fi
  
  local _current_status
  _current_status=$(_get_package_status "$_package")
  
  if [[ "$_current_status" == "$_PKGMAN_STATUS_INSTALLED" ]]; then
    echo "tracked_installed"
    return 1
  else
    echo "tracked_not_installed:$_current_status"
    return 2
  fi
}

##@ Handle metadata overwrite for installed packages
##@ Returns: 0=proceed, 1=cancelled
_handle_installed_package_overwrite() {
  local _package="$1"
  u.warn "package already tracked and installed: $_package"
  u.warn "changing metadata may cause conflicts with existing installation"
  if ! loam.confirm "overwrite metadata anyway?"; then
    u.info "cancelled - to change metadata safely:"
    u.info "  1) pkgman uninstall $_package && pkgman remove $_package"
    u.info "  2) pkgman add -m <manager> $_package [new-options]"
    u.info "  3) pkgman install $_package"
    return 1
  fi
  u.warn "overwriting metadata for installed package: $_package"
  return 0
}

##@ Handle metadata overwrite for not-installed packages
##@ Returns: 0=proceed, 1=cancelled
_handle_not_installed_package_overwrite() {
  local _package="$1" _status="$2"
  u.warn "package already tracked: $_package (status: $_status)"
  if ! loam.confirm "overwrite existing metadata?"; then
    u.info "cancelled"
    return 1
  fi
  u.info "overwriting metadata for $_package"
  return 0
}

##@ Validate state transition for add command - handles tracking state conflicts
##@ Returns: 0 = proceed, 1 = cancelled by user
_validate_add_state_transition() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  local _state
  _state=$(_get_package_tracking_state "$_package")
  local _result=$?
  
  case "$_result" in
    0) # not_tracked - safe to proceed
      return 0
      ;;
    1) # tracked_installed - requires confirmation
      _handle_installed_package_overwrite "$_package"
      ;;
    2) # tracked_not_installed - requires confirmation
      local _status="${_state#tracked_not_installed:}"
      _handle_not_installed_package_overwrite "$_package" "$_status"
      ;;
    *) # unexpected state
      u.error "unexpected package state: $_state"
      return $_E
      ;;
  esac
}

##@ Verify package installation and complete tracking setup
##@ Performs status check, cleanup on failure, and sets tracking metadata
_verify_and_complete_tracking() {
  # shellcheck disable=SC2318  # legacy archive pattern, pre-loam
  local _manager="$1" _package="$2" _manager_display="${3:-$_manager}"
  _pkglib.require_params "manager" "$_manager" "package name" "$_package" || return $?
  
  # Verify package is actually installed
  local _pkg_status
  _pkg_status=$(_call_pkglib "$_manager" "status" "$_package") || {
    u.error "failed to verify $_manager_display package: $_package"
    # In dry-run mode, preserve state for testing even if verification fails
    [[ "$_DRY_RUN" != "true" ]] && _remove_package_state "$_package"
    return $_E
  }
  
  if [[ "$_pkg_status" != "$_PKGMAN_STATUS_INSTALLED" ]]; then
    u.error "cannot verify $_package: package not installed (status: $_pkg_status)"
    # In dry-run mode, preserve state for testing even if package not installed  
    [[ "$_DRY_RUN" != "true" ]] && _remove_package_state "$_package"
    return $_E_NF
  fi
  
  # Complete tracking setup
  _set_status "$_package" "$_PKGMAN_FIELD_INSTALL_METHOD" "$_PKGMAN_INSTALL_METHOD_MANUAL"
  _set_status "$_package" "$_PKGMAN_FIELD_STATUS" "$_PKGMAN_STATUS_INSTALLED"
  _set_status "$_package" "$_PKGMAN_FIELD_INSTALLED_AT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  
  u.info "✓ $_package added to $_manager_display tracking"
}

