##@ Check if a package is currently being tracked in the packages file
##@ Returns success (0) if package exists, failure (1) if not found
##@ Uses escaped package names for safe grep pattern matching
_is_tracked() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  local _file="$(_get_packages_file)"
  [[ ! -f "$_file" ]] && return 1
  
  # Escape package name for safe regex usage
  local _escaped_package
  _escaped_package=$(_escape_package_name "$_package") || return $?
  
  grep -q "^${_escaped_package}\." "$_file" 2>/dev/null
}


##@ Extract unique package names from packages configuration file
##@ Returns array of sorted, unique package names via stdout (one per line)
##@ Usage: _packages=($(_get_tracked_packages))
_get_tracked_packages() {
  local _packages_file="$(_get_packages_file)"
  _ensure_packages_file_exists || return 0
  
  # Get unique package names by parsing package.key=value format
  local _package _packages=()
  while IFS='=' read -r _key _value; do
    [[ -z "$_key" || "$_key" != *.* ]] && continue
    _package="${_key%%.*}"  # Extract package name before first dot
    [[ -n "$_package" ]] && _packages+=("$_package")
  done < "$_packages_file"
  
  # Sort and deduplicate packages, output one per line
  printf '%s\n' "${_packages[@]:-}" | sort -u
}

##@ Get scope for a specific package
##@ Returns the scope of the package or "unknown" if not found
##@ Usage: _scope=$(_get_package_scope "$_package")
_get_package_scope() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  local _scope
  _scope=$(_get_metadata "$_package" "scope" 2>/dev/null) || _scope="unknown"
  echo "$_scope"
  return 0
}

##@ Get packages filtered by scope(s)
##@ Returns array of package names matching the given scopes
##@ Usage: _packages=($(_get_packages_by_scope "core" "system"))
_get_packages_by_scope() {
  local _target_scopes=("$@")
  [[ ${#_target_scopes[@]} -eq 0 ]] && { u.error "at least one scope required"; return $_E_USG; }
  
  local _all_packages _package _package_scope
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  _all_packages=($(_get_tracked_packages))
  
  for _package in "${_all_packages[@]:-}"; do
    [[ -z "$_package" ]] && continue
    _package_scope=$(_get_package_scope "$_package")
    
    # Check if package scope matches any target scope
    local _scope
    for _scope in "${_target_scopes[@]:-}"; do
      if [[ "$_package_scope" == "$_scope" ]]; then
        echo "$_package"
        break
      fi
    done
  done
  return 0
}

##@ Get effective scopes for batch operations (core + custom default + optionally system/manager)
##@ Returns array of scopes to be used in batch operations
##@ Usage: _scopes=($(_get_effective_batch_scopes [include_system_manager]))
_get_effective_batch_scopes() {
  local _include_system_manager="${1:-false}"
  
  # Always include core scope
  local _scopes=("$PKGMAN_SCOPE_CORE")
  
  # Add custom default scope if different from core
  if [[ "$PKGMAN_DEFAULT_SCOPE" != "$PKGMAN_SCOPE_CORE" ]]; then
    _scopes+=("$PKGMAN_DEFAULT_SCOPE")
  fi
  
  # Add system and manager scopes if requested (for sync operations)
  if [[ "$_include_system_manager" == "true" ]]; then
    _scopes+=("$PKGMAN_SCOPE_SYSTEM")
    _scopes+=("$PKGMAN_SCOPE_MANAGER")
  fi
  
  printf '%s\n' "${_scopes[@]}"
  return 0
}

