        [[ -n "$_key" && -n "$_value" ]] || { u.error "invalid parameter format: $_full"; return $_E_USG; }
        _kwargs_keys+=("$_key")
        _kwargs_values+=("$_value")
        shift ;;
      --*)
        # Handle any other --key value pair as kwargs
        local _key="${1#--}"
        [[ -n "${2:-}" && "$2" != "--"* ]] || { u.error "$1 requires a value"; return $_E_USG; }
        _kwargs_keys+=("$_key")
        _kwargs_values+=("$2")
        shift 2 ;;
      *)
        u.error "unexpected argument: $1"; return $_E_USG ;;
    esac
  done
  
  # Normalize and validate manager
  _manager=$(_normalize_and_validate_manager "$_manager") || return $?
  
  # Validate scope
  _validate_scope "$_scope" || return $?
  
  # Validate OS parameter
  _validate_os "$_os" || return $?
  
  # Validate sudo parameter  
  _validate_sudo "$_sudo" || return $?
  
  # Set default detail to package name if not provided
  [[ -z "$_detail" ]] && _detail="$_package"
  
  # Check OS compatibility (can be overridden with --force later)
  _validate_os_compatibility "$_package" "$_os" || return $?
  
  # Universal validation for all managers (includes package existence check)
  _validate_add_state_transition "$_package" || {
    local _result=$?
    [[ $_result -eq 1 ]] && return 0  # User cancelled
    return $_E  # Other error
  }
  
  # Route to managers with unified signature (8 core params + 4 param.* params = 12 total)
  u.debug "add_unified - manager=$_manager, package=$_package, source=$_source, dest=$_dest, artifact=$_artifact, channel=$_channel, os=$_os, sudo=$_sudo, param.install=$_param_install, param.update=$_param_update, param.uninstall=$_param_uninstall, param.sync=$_param_sync"
  _cmd_add_unified "$_manager" "$_package" "$_source" "$_dest" "$_artifact" "$_channel" "$_os" "$_sudo" "$_param_install" "$_param_update" "$_param_uninstall" "$_param_sync"
}

##@ Unified add handler for all managers with consistent parameter interface
##@ Parameters: manager package source dest artifact scope os sudo detail [kwargs_keys...] [kwargs_values...]
_cmd_add_unified() {
  # Validate exact parameter count (12 expected)
  [[ $# -eq 12 ]] || { u.error "_cmd_add_unified expects exactly 12 parameters, got $#"; return $_E; }
  
  local _manager="$1" _package="$2" _source="$3" _dest="$4" _artifact="$5" _channel="$6" _os="$7" _sudo="$8" _param_install="$9" _param_update="${10}" _param_uninstall="${11}" _param_sync="${12}"
  
  # Split remaining args into keys and values arrays (bash 3.2 compatible)
  local _argc=$#
  local _half=$((_argc / 2))
  local _kwargs_keys=() _kwargs_values=() _i=0
  
  # Extract keys (first half)
  while [[ $_i -lt $_half ]]; do
    _kwargs_keys+=("$1")
    shift
    _i=$((_i + 1))
  done
  
  # Extract values (second half)
  _i=0
  while [[ $_i -lt $_half ]]; do
    _kwargs_values+=("$1")
    shift
    _i=$((_i + 1))
  done
  
  # For traditional managers, default source to package name
  if [[ "$_source" == "default" ]]; then
    case "$_manager" in
      brew|apt|dnf|mas|cargo|go|pipx|npm)
        _source="$_package"
        ;;
      # github/download/script require explicit --source
    esac
  fi
  
  # Manager-specific validation - build kwargs array for managers that need them
  local _validation_kwargs=()
  # Note: _source is passed as first parameter, no need for --source kwarg
  [[ "$_dest" != "default" ]] && _validation_kwargs+=("--dest=$_dest") 
  [[ "$_artifact" != "default" ]] && _validation_kwargs+=("--artifact=$_artifact")
  [[ "$_channel" != "default" ]] && _validation_kwargs+=("--channel=$_channel")
  
  # Add any additional kwargs
  local _i=0
  while [[ $_i -lt ${#_kwargs_keys[@]} ]]; do
    local _key="${_kwargs_keys[$_i]:-}"
    local _value="${_kwargs_values[$_i]:-}"
    if [[ -n "$_key" && -n "$_value" ]]; then
      _validation_kwargs+=("--$_key=$_value")
    fi
    _i=$((_i + 1))
  done

  # Always pass source as first parameter - pkglib needs the actual package identifier
  # shellcheck disable=SC2145  # legacy archive pattern, pre-loam
  u.debug "pkglib.${_manager}.validate - source=$_source, force=false, validation_kwargs=${_validation_kwargs[@]:-}"
  pkglib.${_manager}.validate "$_source" "false" "${_validation_kwargs[@]:-}" || u.die "validation failed for $_manager package '$_package' with source '$_source'"

  # Store unified metadata (core parameters only) - SET SCOPE FIRST
  _set_metadata "$_package" "scope" "$_scope"
  _set_metadata "$_package" "manager" "$_manager"
  _set_metadata "$_package" "source" "$_source"
  _set_metadata "$_package" "dest" "$_dest"
  _set_metadata "$_package" "artifact" "$_artifact"
  _set_metadata "$_package" "channel" "$_channel"
  _set_metadata "$_package" "os" "$_os"
  _set_metadata "$_package" "sudo" "$_sudo"
  _set_metadata "$_package" "detail" "$_detail"
  
  # Store manager-specific kwargs
  local _i=0
  while [[ $_i -lt ${#_kwargs_keys[@]} ]]; do
    local _key="${_kwargs_keys[$_i]:-}"
    local _value="${_kwargs_values[$_i]:-}"
    if [[ -n "$_key" && -n "$_value" ]]; then
      _set_metadata "$_package" "$_key" "$_value"
    fi
    _i=$((_i + 1))
  done
  
  u.info "✓ $_package added to tracking"
  return 0
}

##@ Synchronize tracked package status with actual installation state
##@ Checks actual installation status and updates tracking state accordingly
_cmd_sync() {
  local _package="${1:-}"
  _pkglib.require_params "package name" "$_package" || u.die "package name required for sync command"
  shift
  
  # Parse options
  local _force
  _parse_force_flag "$@" || return $?
  
  _validate_package_tracked "$_package" || exit $_E
  
  local _manager="$(_get_metadata "$_package" "manager")"
  [[ -z "$_manager" ]] && { u.error "no manager recorded for $_package"; return $_E_NF; }
  
  # Get current tracked status
  local _tracked_status
  _tracked_status=$(_get_package_status "$_package")
  
  u.info "synchronizing $_package status using $_manager"
  
  # Check actual installation status
  local _actual_status
  if ! _dry "pkglib.$_manager.status $_package"; then
    _actual_status=$(_call_pkglib "$_manager" "status" "$_package" 2>/dev/null) || _actual_status="$_PKGMAN_STATUS_MISSING"
  else
    # In dry-run mode, just report what would be checked
    u.info "[DRY RUN] would check $_manager installation status for $_package"
    return 0
  fi
  
  if [[ "$_tracked_status" != "$_actual_status" || "$_force" == "true" ]]; then
    if [[ "$_tracked_status" != "$_actual_status" ]]; then
      u.info "status mismatch: $_package (tracked: $_tracked_status, actual: $_actual_status)"
    else
      u.info "force sync requested for $_package"
    fi
    
    # Update status to match reality
    _set_status "$_package" "$_PKGMAN_FIELD_STATUS" "$_actual_status"
    _set_status "$_package" "$_PKGMAN_FIELD_LAST_CHECKED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    
    # Update install method if package is actually installed but wasn't tracked as such
    if [[ "$_actual_status" == "$_PKGMAN_STATUS_INSTALLED" && "$_tracked_status" != "$_PKGMAN_STATUS_INSTALLED" ]]; then
      _set_status "$_package" "$_PKGMAN_FIELD_INSTALL_METHOD" "$_PKGMAN_INSTALL_METHOD_MANUAL"
      u.info "✓ updated $_package: $_tracked_status → $_actual_status (marked as manual install)"
    else
      u.info "✓ updated $_package: $_tracked_status → $_actual_status"
    fi
  else
    # Status matches - just update last_checked timestamp
    _set_status "$_package" "$_PKGMAN_FIELD_LAST_CHECKED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    u.info "✓ status confirmed: $_package ($_actual_status)"
  fi
}
