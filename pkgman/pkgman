}

##@ Install tracked package using stored metadata
_cmd_install_tracked() {
  local _package="$1" _force="$2"
  
  # Get stored manager
  local _stored_manager
  _stored_manager=$(_get_metadata "$_package" "manager") || { u.error "no manager recorded for $_package"; return $_E_NF; }
  
  # Check current status
  local _current_status
  _current_status=$(_get_package_status "$_package")
  
  if [[ "$_current_status" == "$_PKGMAN_STATUS_INSTALLED" && "$_force" != "true" ]]; then
    u.info "already installed: $_package"
    return 0
  fi
  
  u.info "installing $_package using $_stored_manager"
  
  # Build force flags
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  local _flags=($(_build_force_flags))
  
  # Call appropriate pkglib function using stored metadata
  local _result=0
  if ! _dry "pkglib.$_stored_manager.install $_package"; then
    _call_pkglib "$_stored_manager" "install" "$_package" "${_flags[@]:-}" || _result=$?
  fi
  
  # Update status if installation succeeded
  if [[ $_result -eq 0 ]]; then
    _set_status "$_package" "$_PKGMAN_FIELD_INSTALL_METHOD" "$_PKGMAN_INSTALL_METHOD_PKGMAN"
    _set_status "$_package" "$_PKGMAN_FIELD_STATUS" "$_PKGMAN_STATUS_INSTALLED"
    _set_status "$_package" "$_PKGMAN_FIELD_INSTALLED_AT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    u.info "✓ $_package installed and tracked"
  else
    u.error "✗ failed to install $_package"
    return $_result
  fi
}

##@ Update a tracked package using its recorded package manager
##@ Updates last_checked timestamp on successful completion
_cmd_update() {
  local _package="${1:-}"
  _pkglib.require_params "package name" "$_package" || u.die "package name required for update command"
  shift
  
  # Parse options
  local _force
  _parse_force_flag "$@" || return $?
  
  _validate_package_tracked "$_package" || exit $_E
  
  local _manager="$(_get_metadata "$_package" "manager")"
  [[ -z "$_manager" ]] && { u.error "no manager recorded for $_package"; return $_E_NF; }
  
  # Check installation status first for unknown/missing packages
  local _current_status
  _current_status=$(_get_package_status "$_package")
  if [[ "$_current_status" == "$_PKGMAN_STATUS_UNKNOWN" || "$_current_status" == "$_PKGMAN_STATUS_MISSING" ]]; then
    u.info "verifying $_package installation status before update"
    
    local _verified_status
    if ! _dry "pkglib.$_manager.status $_package"; then
      _verified_status=$(_call_pkglib "$_manager" "status" "$_package") || _verified_status="$_PKGMAN_STATUS_MISSING"
    else
      # In dry-run mode, assume it's installed to allow testing update flow
      _verified_status="$_PKGMAN_STATUS_INSTALLED"
    fi
    
    if [[ "$_verified_status" != "$_PKGMAN_STATUS_INSTALLED" ]]; then
      u.error "cannot update $_package: not installed (status: $_verified_status)"
      u.info "use 'pkgman install $_package' to install first"
      return $_E_NF
    fi
    
    # Update the status since we verified it's installed
    _set_status "$_package" "$_PKGMAN_FIELD_STATUS" "$_PKGMAN_STATUS_INSTALLED"
  fi
  
  u.info "updating $_package using $_manager"
  
  # Build force flags
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  local _flags=($(_build_force_flags))
  
  # Call appropriate pkglib function
  local _result=0
  if ! _dry "pkglib.$_manager.update $_package"; then
    _call_pkglib "$_manager" "update" "$_package" "${_flags[@]:-}" || _result=$?
  fi
  
  # Update status if successful
  if [[ $_result -eq 0 ]]; then
    _set_status "$_package" "$_PKGMAN_FIELD_LAST_CHECKED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    u.info "✓ $_package updated"
  else
    u.error "✗ failed to update $_package"
    return $_result
  fi
}

