##@ Performs atomic cleanup of package metadata and status information
##@ Uses properly escaped package names for safe grep pattern matching
_remove_package_state() {
  local _package="$1"
  _pkglib.require_params "package name" "$_package" || return $?
  
  # Skip state updates if not appropriate
  _should_update_state || return 0
  
  # Escape package name for safe regex usage
  local _escaped_package
  _escaped_package=$(_escape_package_name "$_package") || return $?
  
  # Get the package's scope to determine which file to update
  local _scope
  _scope=$(_get_package_scope "$_package" 2>/dev/null) || _scope="core"
  
  # Remove from scope-specific file (source of truth)
  local _scope_file="$PKGMAN_INDEX_DIR/package.${_scope}.cfg"
  local _status_file="$(_get_status_file)"
  
  # Helper function for safe file updates
  _update_file() {
    local _file="$1" _pattern="$2"
    [[ ! -f "$_file" ]] && return 0
    
    local _temp_file="$(mktemp)"
    _cleanup() { [[ -f "$_temp_file" ]] && rm -f "$_temp_file"; }
    trap _cleanup EXIT INT TERM
    
    grep -v "$_pattern" "$_file" > "$_temp_file" || true
    if mv "$_temp_file" "$_file"; then
      trap - EXIT INT TERM
      return 0
    else
      u.error "failed to update file: $_file"
      _cleanup
      return $_E
    fi
  }
  
  # Remove from scope-specific file and status file
  _update_file "$_scope_file" "^${_escaped_package}\\." || return $?
  _update_file "$_status_file" "^${_escaped_package}\\." || return $?
}

##@ Retrieve metadata value for a package from packages configuration file
##@ Returns the value for the specified package.key combination
##@ Uses escaped package names for safe grep pattern matching  
_get_metadata() {
  local _package="$1" _key="$2"
  _pkglib.require_params "package name" "$_package" "metadata key" "$_key" || return $?
  
  local _file="$(_get_packages_file)"
  [[ ! -f "$_file" ]] && { u.error "packages configuration not found: $_file - no packages have been added yet"; return $_E_NF; }
  
  # Escape package name for safe regex usage
  local _escaped_package
  _escaped_package=$(_escape_package_name "$_package") || return $?
  
  grep "^${_escaped_package}\.${_key}=" "$_file" 2>/dev/null | head -1 | cut -d'=' -f2-
}

##@ Set metadata value for a package in packages configuration file
##@ Performs atomic update by replacing existing entries with new values
##@ Uses escaped package names for safe grep pattern matching
_set_metadata() {
  local _package="$1" _key="$2" _value="$3"
  _pkglib.require_params "package name" "$_package" "metadata key" "$_key" "metadata value" "$_value" || return $?
  
  # Determine target scope file based on package's scope
  local _scope="core"  # default scope
  if [[ "$_key" == "scope" ]]; then
    _scope="$_value"
  else
    # Get existing scope for this package, default to core
    _scope=$(_get_package_scope "$_package" 2>/dev/null) || _scope="core"
  fi
  
  # Ensure index directory exists
  [[ ! -d "$PKGMAN_INDEX_DIR" ]] && mkdir -p "$PKGMAN_INDEX_DIR"
  
  # Target scope-specific file in index directory
  local _file="$PKGMAN_INDEX_DIR/package.${_scope}.cfg"
  local _config_dir="$(dirname "$_file")"
  
  # Validate config directory is accessible if it exists
  [[ -d "$_config_dir" && ! -w "$_config_dir" ]] && { u.error "config directory not writable: $_config_dir"; return $_E_NP; }
  
  local _full_key="${_package}.${_key}"
  _update_config_file "$_file" "$_full_key" "$_value"
}

