##@ Install all tracked packages that are missing
##@ Only installs packages with status != installed, skips already installed packages
_cmd_install_all() {
  # Parse options
  local _force
  _parse_force_flag "$@" || return $?
  
  # Get effective scopes for batch operations (excludes system scope)
  local _effective_scopes
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  _effective_scopes=($(_get_effective_batch_scopes))
  
  # Get packages filtered by effective scopes
  local _packages
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  _packages=($(_get_packages_by_scope "${_effective_scopes[@]}"))
  [[ ${#_packages[@]} -eq 0 ]] && { u.info "no packages in scope: ${_effective_scopes[*]}"; return 0; }
  
  u.info "installing all missing packages (${#_packages[@]} in scopes: ${_effective_scopes[*]})"
  
  local _installed=0 _skipped=0 _failed=0 _package
  for _package in "${_packages[@]:-}"; do
    [[ -z "$_package" ]] && continue
    
    # Check current status
    local _current_status
    _current_status=$(_get_package_status "$_package")
    
    if [[ "$_current_status" == "$_PKGMAN_STATUS_INSTALLED" && "$_force" != "true" ]]; then
      u.info "skipping $_package (already installed)"
      _skipped=$((_skipped + 1))
      continue
    fi
    
    u.info "installing $_package"
    # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
    local _flags=($(_build_force_flags))
    
    if _cmd_install "$_package" "${_flags[@]:-}"; then
      _installed=$((_installed + 1))
    else
      u.error "✗ failed to install $_package"
      _failed=$((_failed + 1))
    fi
  done
  
  u.info "✓ install-all complete: $_installed installed, $_skipped skipped, $_failed failed"
  [[ $_failed -gt 0 ]] && return $_E
  return 0
}

