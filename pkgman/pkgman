    $__APP add npm prettier --source prettier                    # Global install (default)
    $__APP add npm typescript --source typescript --version "~4.9.0"  # With version constraint
    $__APP add npm create-react-app --source create-react-app --npx true  # NPX execution mode
    $__APP add npm @org/package --source @org/package --registry https://npm.pkg.github.com  # Custom registry
    
    # Individual Package Management
    $__APP status obsidian         # Show complete package information
    $__APP sync docker             # Sync tracked vs actual status
    $__APP update obsidian --force # Force update
    $__APP uninstall docker        # Uninstall but keep tracking
    $__APP remove docker --force   # Remove from tracking completely
    
    # Batch Operations
    $__APP install-all             # Install all missing packages
    $__APP install-all --force     # Force reinstall all packages
    $__APP sync-all                # Sync status for all packages  
    $__APP update-all --force      # Force update all packages
    $__APP list-all                # Show formatted package table
    $__APP list-packages           # List names only (for scripting)
    
    # System Operations
    $__APP provision cargo             # Bootstrap Rust package manager
    $__APP provision all               # Bootstrap all package managers
    $__APP provision all --force       # Force reinstall all package managers
    $__APP --dry-run add github obsidian --source obsidianmd/obsidian-releases --dest /Applications --artifact Obsidian.app
    $__APP --dry-run install-all   # Preview batch installation
    $__APP --no-track install docker  # Install without state tracking

WORKFLOW:
    1. Add package with metadata:    add <manager> <package> [parameters]
    2. Install tracked package:      install <package>
    3. Manage lifecycle:             update/sync/status <package>
    4. Batch operations:             install-all/update-all/sync-all
    5. Remove when done:             uninstall/remove <package>

CONFIGURATION:
    Packages file:  \$PKGMAN_CONFIG_DIR/packages.cfg (metadata)
    Status file:    \$PKGMAN_CONFIG_DIR/status.cfg (installation state)
    Default config: \$XDG_CONFIG_HOME/pkgman or ~/.config/pkgman

NOTE: pkgman manages global tools only. For project dependencies, use:
    Python: requirements.txt, Pipfile, pyproject.toml
    Rust: Cargo.toml  
    Go: go.mod

EOF
}

_version() { [[ "$__PIPED" == true ]] && echo "0.0.0" || sed -n 's/^# VERSION:[[:space:]]*\(.*\)/\1/p' "$__APPFILE" 2>/dev/null || echo "unknown"; }

_cleanup() {
  u.debug "cleanup"
  return 0
}
