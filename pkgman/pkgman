##@ Provision a single package manager
_cmd_provision_manager() {
  local _manager="${1:-}"
  shift
  
  # Parse options for this function
  local _force
  _parse_force_flag "$@" || return $?
  
  # Validate manager
  case "$_manager" in
    brew|mas|cargo|go|pipx|npm|download|github|script|apt|dnf)
      # Valid manager
      ;;
    *)
      u.error "unsupported manager for provisioning: $_manager"
      u.info "Supported managers: brew, mas, cargo, go, pipx, npm, download, github, script, apt, dnf, all"
      return $_E_USG
      ;;
  esac
  
  u.info "provisioning $_manager package manager"
  
  # Use script manager to call pkgboot
  local _manager_name="${_manager}-manager"
  # shellcheck disable=SC2207  # legacy archive pattern, pre-loam
  local _flags=($(_build_force_flags))
  
  # Check if manager is already tracked
  if _is_tracked "$_manager_name"; then
    u.info "$_manager_name already tracked"
    # If force flag is set, proceed with install; otherwise just check status
    if [[ "$_force" == "true" ]]; then
      u.info "force flag set, proceeding with install"
    else
      local _current_status
      _current_status=$(_get_package_status "$_manager_name")
      if [[ "$_current_status" == "$_PKGMAN_STATUS_INSTALLED" ]]; then
        u.info "✓ $_manager package manager already provisioned"
        return 0
      fi
    fi
  else
    # Add the manager to tracking
    if ! _cmd_add "script" "$_manager_name" --source "pkgboot" --dest "default" --target "$_manager" --scope "$PKGMAN_SCOPE_MANAGER" --detail "[internal] $_manager package manager"; then
      u.error "failed to add $_manager_name to tracking"
      return $_E
    fi
  fi
  
  if _cmd_install "$_manager_name" "${_flags[@]:-}"; then
    u.info "✓ $_manager package manager provisioned successfully"
    return 0
  else
    u.error "✗ failed to provision $_manager package manager"
    return $_E
  fi
