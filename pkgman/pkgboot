#!/usr/bin/env bash
##( header
# --------------------------------------------------------------------
# pkgboot - Universal package manager bootstrap installer
#
# Provisions package managers and their dependencies using a combination
# of manual installation (brew) and pkgman dogfooding for other managers.
# Complies with pkgman script manager interface while supporting
# independent execution with help and status capabilities.
#
# CALLING INTERFACES:
# 1. Script Manager Interface (called by pkgman):
#    pkgboot <action> <force> [--target=<manager-name>] [--dest=<path>] [--artifact=<name>]
#    Example: pkgboot install true --target=cargo-manager --artifact=cargo
#
# 2. Independent Execution Interface:
#    pkgboot [OPTIONS] <action> <manager>
#    Example: pkgboot install cargo, pkgboot status mas, pkgboot help go
#
# MANAGER NAME MAPPING:
# - Supports both direct names (cargo) and manager names (cargo-manager)
# - Manager names with -manager suffix are mapped to internal logic
# - Example: cargo-manager → cargo, mas-manager → mas, etc.
# --------------------------------------------------------------------
# AUTHOR: Budha <budhash@gmail.com>
# VERSION: 1.0.0
# LICENSE: MIT License
# --------------------------------------------------------------------
# __TEMPLATE__: https://github.com/budhash/zap-sh/blob/main/templates/basic.sh
# __ID__: basic-1.0.0
# --------------------------------------------------------------------
##) header

##( configuration
set -eEuo pipefail; IFS=$'\n\t'  # fail fast, secure IFS
##) configuration

##( metadata
readonly __SOURCE="${BASH_SOURCE[0]:-}"
readonly __PIPED=$([[ -t 0 || -n "$__SOURCE" ]] && echo false || echo true)
readonly __APP="$(basename "${__SOURCE:-$0}")"
readonly __APPFILE="$__SOURCE"
if [[ -n "$__SOURCE" ]]; then
  readonly __APPDIR="$(s="$__SOURCE"; while [[ -h "$s" ]]; do
    d="$(cd -P "$(dirname "$s")" && pwd)"; s="$(readlink "$s")"; [[ "$s" != /* ]] && s="$d/$s"; done; cd -P "$(dirname "$s")" && pwd)"
else
  readonly __APPDIR="$(pwd)"
fi
__DBG=${DEBUG:-false}
##) metadata

##( globals

##[ colors
_RST=$'\033[0m' _GRN=$'\033[0;32m' _YLW=$'\033[0;33m' _RED=$'\033[0;31m' _BLU=$'\033[0;34m'
[[ -n "${NO_COLOR:-}" || ! -t 1 ]] && _RST='' _GRN='' _YLW='' _RED='' _BLU=''
##] colors

##[ error
# general failure / bad usage / dependency not found / unsupported OS / not found / permission error / not connected / piped mode
_E=1 _E_USG=2 _E_DEP=3 _E_OS=4 _E_NF=5 _E_NP=6 _E_NC=7 _E_PIPE=8
##] error

##) globals

##( helpers

##[ system
u.os() { case "${OSTYPE:-}" in darwin*) echo mac;; linux*) echo linux;; *) echo unknown;; esac; }
u.die() { u.error "$@"; exit $_E; }
u.require() {
  local tool="${1:-}"
  [[ -z "$tool" ]] && { u.error "missing dependency name"; exit $_E_DEP; }
  if [[ "$tool" == /* ]] || [[ "$tool" == ./* ]] || [[ "$tool" == ../* ]]; then
    [[ -x "$tool" ]] || { u.error "missing dependency: $tool"; exit $_E_DEP; } # Absolute or relative path - test directly
  else
    command -v "$tool" >/dev/null || { u.error "missing dependency: $tool"; exit $_E_DEP; }
  fi
}
##] system

##[ logging
u.log() {
  local _l="info " _co="$_GRN"
  [[ "${1:-}" == "-l" ]] && { _l="${2:-info}"; shift 2; }
  case "$_l" in warn) _co="$_YLW";; error) _co="$_RED";; debug) _co="$_BLU"; [[ "$__DBG" != true ]] && return;; esac
  printf "${_co}[%s]${_RST} %s\n" "$_l" "$*" >&2
  return 0
}
u.info() { u.log -l "info " "$@"; }
u.warn() { u.log -l "warn " "$@"; }
u.error() { u.log -l "error" "$@"; }
u.debug() { u.log -l "debug" "$@"; }
##] logging

##) helpers

##( app

##[ config
readonly __NAME=pkgboot
readonly __OS=(mac linux)
readonly __APP_DEPS=(find)
readonly __ALLOW_PIPED=false  # Bootstrap script should not run in piped mode
##] config

##[ constants
# Supported managers and their bootstrap dependencies
readonly PKGBOOT_MANAGERS=(brew apt dnf mas cargo go pipx npm download github script)

# Status constants matching pkglib
readonly PKGBOOT_STATUS_INSTALLED="installed"
readonly PKGBOOT_STATUS_MISSING="missing"

# Manager categories for bootstrap strategy
readonly MANUAL_MANAGERS=(brew)  # Must be installed manually first
readonly DOGFOOD_MANAGERS=(mas cargo go pipx npm)  # Use pkgman to install dependencies
readonly UTILITY_MANAGERS=(download github script)  # Utility managers (no actual installation)
##] constants

##[ globals
_PKGMAN_PATH=""
##] globals

##[ functions

##@ Validate brew is available and return its prefix
_require_brew() {
  if ! command -v brew &>/dev/null; then
    u.error "brew not found - install homebrew first"
    return $_E_DEP
  fi
  brew --prefix
}

##@ Map manager names to internal logic (handles *-manager suffix)
##: _map_manager_name <manager> -> internal_name=$(_map_manager_name "cargo-manager")
_map_manager_name() {
  local _manager="$1"
  [[ -z "$_manager" ]] && { u.error "manager name required"; return $_E_USG; }
  
  # Strip -manager suffix if present
  if [[ "$_manager" == *-manager ]]; then
    echo "${_manager%-manager}"
  else
    echo "$_manager"
  fi
}

##@ Execute pkgman command with global pkgman path, with error handling
_pkgman_run() {
  [[ -z "$_PKGMAN_PATH" ]] && { u.error "--pkgman parameter required for dogfooding"; return $_E_USG; }
  [[ ! -x "$_PKGMAN_PATH" ]] && { u.error "pkgman not executable: $_PKGMAN_PATH"; return $_E_DEP; }
  
  u.debug "using pkgman: $_PKGMAN_PATH"
  u.debug "running: $_PKGMAN_PATH $*"
  
  # Check if this is a dry-run (echo commands instead of executing)
  if [[ "${PKGBOOT_DRY_RUN:-false}" == "true" ]]; then
    echo "DRY-RUN: $_PKGMAN_PATH $*"
  else
    "$_PKGMAN_PATH" "$@"
  fi
}

##@ Track package with pkgman (add if not tracked, then sync)
##: _pkgman_track <manager> <package> <description> -> _pkgman_track brew mas "Mac App Store CLI"
_pkgman_track() {
  local _manager="$1" _package="$2" _description="$3"
  [[ -z "$_manager" ]] && { u.error "manager required for _pkgman_track"; return $_E_USG; }
  [[ -z "$_package" ]] && { u.error "package required for _pkgman_track"; return $_E_USG; }
  [[ -z "$_description" ]] && { u.error "description required for _pkgman_track"; return $_E_USG; }
  
  # Check if already tracked
  if _pkgman_run status "$_package" &>/dev/null; then
    u.debug "$_package already tracked, syncing status"
    _pkgman_run sync "$_package"
  else
    u.debug "tracking $_package via $_manager"
    _pkgman_run add "$_manager" "$_package" --scope system --detail "$_description"
    _pkgman_run sync "$_package"
  fi
}

##@ Track and install package with pkgman (complete dogfooding flow)
##: _pkgman_install <manager> <package> <description> -> _pkgman_install brew mas "Mac App Store CLI"
_pkgman_install() {
  local _manager="$1" _package="$2" _description="$3"
  [[ -z "$_manager" ]] && { u.error "manager required for _pkgman_install"; return $_E_USG; }
  [[ -z "$_package" ]] && { u.error "package required for _pkgman_install"; return $_E_USG; }
  [[ -z "$_description" ]] && { u.error "description required for _pkgman_install"; return $_E_USG; }
  
  # Add to tracking if not already tracked
  if ! _pkgman_run status "$_package" &>/dev/null; then
    u.debug "tracking $_package via $_manager"
    _pkgman_run add "$_manager" "$_package" --scope system --detail "$_description"
  else
    # If already tracked, sync status to detect external changes
    u.debug "syncing $_package status to detect external changes"
    _pkgman_run sync "$_package"
  fi
  
  # Install the package (this will handle current status properly)
  _pkgman_run install "$_package"
}

_main() {
  # Handle both script manager interface and independent execution
  if [[ $# -ge 2 && "$1" =~ ^(install|update|uninstall|status)$ && "$2" =~ ^(true|false)$ ]]; then
    # Script manager interface: action force [--target=name] [--dest=...] [--artifact=...]
    local _action="$1" _force="$2"
    shift 2
    
    # Parse optional parameters for script manager mode
    local _dest="." _artifact="" _target="" _pkgman_path=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dest=*) _dest="${1#*=}"; shift ;;
        --dest) _dest="$2"; shift 2 ;;
        --artifact=*) _artifact="${1#*=}"; shift ;;
        --artifact) _artifact="$2"; shift 2 ;;
        --target=*) _target="${1#*=}"; shift ;;
        --target) _target="$2"; shift 2 ;;
        --pkgman=*) _pkgman_path="${1#*=}"; shift ;;
        --pkgman) _pkgman_path="$2"; shift 2 ;;
        *) u.warn "ignoring unknown parameter: $1"; shift ;;
      esac
    done
    
    # For script manager mode, target parameter is required
    [[ -z "$_target" ]] && { u.error "script manager interface requires --target parameter"; exit $_E_USG; }
    
    # Set global pkgman path if provided
    [[ -n "$_pkgman_path" ]] && _PKGMAN_PATH="$_pkgman_path"
    
    _pkgboot_dispatch "$_action" "$_target" "$_dest" "$_artifact" "$_force"
  elif [[ $# -ge 1 && "$1" =~ ^(install|update|uninstall|status)$ ]]; then
    # Legacy detection: action without force flag - treat as independent execution
    _parse_independent_args "$@"
  else
    # Independent execution: pkgboot [options] [action] [manager]
    _parse_independent_args "$@"
  fi
}

##@ Parse arguments for independent execution
_parse_independent_args() {
  local _help=false _version=false _action="" _manager=""
  local OPTIND=1
  
  while getopts "hv" _opt; do
    case $_opt in
      h) _help=true;;
      v) _version=true;;
      \?) u.error "unknown option: -${OPTARG:-}"; exit $_E_USG;;
    esac
  done
  shift $((OPTIND-1))
  
  [[ "$_help" == true ]] && { _help; exit 0; }
  [[ "$_version" == true ]] && { _version; exit 0; }
  
  _action="${1:-}"
  _manager="${2:-}"
  
  if [[ -z "$_action" ]]; then
    u.error "action required: install, update, uninstall, status, or help"
    _help
    exit $_E_USG
  fi
  
  case "$_action" in
    help)
      if [[ -n "$_manager" ]]; then
        _show_manager_help "$_manager"
      else
        _help
      fi
      ;;
    install|update|uninstall|status)
      [[ -z "$_manager" ]] && { u.error "manager required for $_action"; exit $_E_USG; }
      _pkgboot_dispatch "$_action" "$_manager" "." "" "false"
      ;;
    *)
      u.error "unknown action: $_action"
      _help
      exit $_E_USG
      ;;
  esac
}

##@ Dispatch to appropriate manager method
_pkgboot_dispatch() {
  local _action="$1" _manager="$2" _dest="${3:-.}" _artifact="${4:-}" _force="${5:-false}"
  shift 5
  
  # Note: _PKGMAN_PATH is now set globally in _main function
  
  # Map manager name (handles *-manager suffix)
  local _internal_manager
  _internal_manager=$(_map_manager_name "$_manager") || u.die "failed to map manager name: $_manager"
  
  # Validate internal manager name
  local _valid_manager=false _m
  for _m in "${PKGBOOT_MANAGERS[@]:-}"; do
    [[ "$_internal_manager" == "$_m" ]] && { _valid_manager=true; break; }
  done
  
  [[ "$_valid_manager" != true ]] && { u.error "unsupported manager: $_manager (mapped to: $_internal_manager)"; return $_E_USG; }
  
  # Dispatch to manager-specific method using internal name
  local _method="_pkgboot.${_internal_manager}.${_action}"
  if declare -f "$_method" >/dev/null 2>&1; then
    "$_method" "$_dest" "$_artifact" "$_force"
  else
    u.error "method not implemented: $_method"
    return $_E_USG
  fi
}

##] functions

##[ brew
##@ Install Xcode Command Line Tools dependency for brew
_pkgboot.brew.install_system_tools() {
  u.info "checking system development tools"
  
  # Check and install Xcode Command Line Tools
  if ! xcode-select -p &>/dev/null; then
    u.info "installing Xcode Command Line Tools"
    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    
    # Find the Command Line Tools package 
    local _prod=$(softwareupdate -l 2>/dev/null | grep '\*.*Command Line' | tail -n 1 | sed 's/^[^C]* //')
    
    if [[ -n "$_prod" ]]; then
      u.info "installing: $_prod"
      softwareupdate -i "$_prod" --verbose
    else
      u.warn "no Command Line Tools package found via softwareupdate"
      u.info "attempting interactive installation"
      xcode-select --install
      u.info "please complete the Command Line Tools installation dialog and re-run provision"
      return 1
    fi
    
    rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  else
    u.debug "Xcode Command Line Tools already installed"
  fi
}

##@ Install brew with full dependency chain
_pkgboot.brew.install_brew() {
  # No-op if already installed
  if command -v brew &>/dev/null; then
    u.debug "Homebrew already installed"
    return 0
  fi
  
  u.info "installing Homebrew package manager"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  
  # Add to PATH for current session
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [[ -x "/usr/local/bin/brew" ]]; then
    export PATH="/usr/local/bin:$PATH"
  fi
}

##@ Manual brew installation - foundation for dogfooding
_pkgboot.brew.install() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.info "installing brew (manual bootstrap) - force: $_force"
  
  case "$(u.os)" in
    mac)
      if command -v brew &>/dev/null; then
        if [[ "$_force" == "true" ]]; then
          u.warn "brew already installed - force flag ignored (brew reinstall not supported)"
        else
          u.info "brew already installed"
        fi
        return 0
      fi
      
      # Install system dependencies first
      _pkgboot.brew.install_system_tools || return $?
      
      # Install brew
      _pkgboot.brew.install_brew || return $?
      ;;
    linux)
      u.info "brew not needed on Linux - skipping"
      u.info "Linux systems should use native package managers: apt (Ubuntu/Debian), dnf (Fedora), yum (RHEL/CentOS)"
      u.info "if you really need brew on Linux, install manually: https://brew.sh/"
      return 0
      ;;
    *)
      u.error "unsupported OS for brew: $(u.os)"
      return $_E_OS
      ;;
  esac
  
  u.info "✓ brew installation completed"
}

_pkgboot.brew.update() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.info "updating brew"
  
  if ! command -v brew &>/dev/null; then
    u.error "brew not installed - cannot update"
    return $_E_NF
  fi
  
  brew update
  u.info "✓ brew updated"
}

_pkgboot.brew.uninstall() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.error "uninstall not supported for brew - system dependency"
  return $_E_USG
}

_pkgboot.brew.status() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  
  # Brew is macOS-only, show as not applicable on Linux
  case "$(u.os)" in
    linux)
      u.info "brew: not applicable (Linux)"
      exit 0  # Consider it "installed" for provisioning purposes
      ;;
  esac
  
  if command -v brew &>/dev/null; then
    u.info "brew: installed"
    exit 0
  else
    u.info "brew: missing"
    exit 1
  fi
}
