##@ Rust package manager - use pkgman dogfooding
_pkgboot.cargo.install() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.info "installing cargo via pkgman dogfooding"
  
  # Check if cargo is already installed
  if command -v cargo &>/dev/null && [[ "$_force" != "true" ]]; then
    u.info "cargo already installed - adding to pkgman tracking"
    _pkgman_track brew rustup "[internal] rust toolchain installer with cargo"
    return 0
  fi
  
  # Validate brew is available for rustup installation
  _require_brew >/dev/null || return $?
  
  # Install Rust which includes cargo
  _pkgman_install brew rustup "[internal] rust toolchain installer with cargo"
  
  # Initialize rustup with stable toolchain (no PATH modification)
  u.info "initializing rustup with stable toolchain"
  if ! command -v cargo &>/dev/null; then
    u.info "running rustup-init to initialize Rust toolchain"
    rustup-init -y --no-modify-path || { u.error "rustup-init failed"; return $_E; }
  else
    u.info "cargo already available"
  fi
  
  u.info "add to PATH: export PATH=\"\${CARGO_HOME:-\$HOME/.cargo}/bin:\$PATH\""
  u.info "Rust environment variables (can be customized):"
  u.info "  ZSH_SDK_HOME (default: \$HOME) - base directory for SDKs"
  u.info "  RUSTUP_HOME (default: \$ZSH_SDK_HOME/.rustup) - rustup installation"
  u.info "  CARGO_HOME (default: \$ZSH_SDK_HOME/.cargo) - cargo installation"
  u.info "✓ cargo installation completed"
}

