##@ Node.js package manager - use pkgman dogfooding
_pkgboot.npm.install() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.info "installing npm via nvm (Node Version Manager)"
  
  case "$(u.os)" in
    mac)
      # Get brew prefix and validate brew is available
      local _brew_prefix
      _brew_prefix=$(_require_brew) || return $?
      
      # Check if nvm/npm is already installed
      if (command -v nvm &>/dev/null || [[ -s "${NVM_DIR:-$ZSH_SDK_HOME/.nvm}/nvm.sh" ]] || [[ -s "$_brew_prefix/opt/nvm/nvm.sh" ]]) && [[ "$_force" != "true" ]]; then
        u.info "nvm already installed - adding to pkgman tracking"
        _pkgman_track brew nvm "[internal] node version manager"
        u.info "using existing nvm to install Node.js LTS"
      else
        u.info "installing nvm via brew"
        _pkgman_install brew nvm "[internal] node version manager"
      fi
      ;;
    linux)
      # For Linux, we could use the install script approach
      u.info "nvm installation on Linux requires manual setup"
      u.info "see: https://github.com/nvm-sh/nvm#install--update-script"
      return 0
      ;;
    *)
      u.error "unsupported OS for npm: $(u.os)"
      return $_E_OS
      ;;
  esac
  
  # Setup nvm and install LTS Node
  echo "mkdir -p \"\${NVM_DIR:-\$ZSH_SDK_HOME/.nvm}\""
  echo "export NVM_DIR=\"\${NVM_DIR:-\$ZSH_SDK_HOME/.nvm}\""
  # shellcheck disable=SC2028 # intentional: printing a literal shell snippet for the user to paste/run, not evaluating it here
  echo "[ -s \"$_brew_prefix/opt/nvm/nvm.sh\" ] && \\\\. \"$_brew_prefix/opt/nvm/nvm.sh\""
  echo "nvm install --lts"
  
  u.info "✓ npm installation completed via nvm"
  u.info "nvm environment variables (can be customized):"
  u.info "  ZSH_SDK_HOME (default: \$HOME) - base directory for SDKs"
  u.info "  NVM_DIR (default: \$ZSH_SDK_HOME/.nvm) - nvm installation directory"
  u.info "nvm manages Node.js versions and npm automatically"
  u.info "Add to shell profile: [ -s \"$_brew_prefix/opt/nvm/nvm.sh\" ] && \\\\. \"$_brew_prefix/opt/nvm/nvm.sh\""
}

