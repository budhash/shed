_pkgboot.go.mac.install() {
  # Check if go is already installed
  if command -v go &>/dev/null && [[ "$_force" != "true" ]]; then
    u.info "go already installed - adding to pkgman tracking"
    _pkgman_track brew go "[internal] go programming language"
    return 0
  fi
  
  # Validate brew is available for go installation
  _require_brew >/dev/null || return $?
  
  u.info "installing go on macOS via brew"
  _pkgman_install brew go "[internal] go programming language"
}

_pkgboot.go.linux.install() {
  u.info "installing go on Linux via system package manager"
  if command -v apt &>/dev/null; then
    _pkgman_install apt golang-go "[internal] go programming language"
  elif command -v dnf &>/dev/null; then
    _pkgman_install dnf golang "[internal] go programming language"
  else
    u.error "no supported package manager found for go installation"
    return $_E_DEP
  fi
}

_pkgboot.go.install() {
  local _dest="$1" _artifact="$2" _force="${3:-false}"
  u.info "installing go via pkgman dogfooding"
  
  case "$(u.os)" in
    mac) _pkgboot.go.mac.install ;;
    linux) _pkgboot.go.linux.install ;;
    *) u.error "unsupported OS for go: $(u.os)"; return $_E_OS ;;
  esac
  
  # Configure Go to use shared binary directory
  echo "mkdir -p \"\${ZSH_SDK_BIN:-\$HOME/.local/bin}\""
  
  u.info "✓ go installation completed"
